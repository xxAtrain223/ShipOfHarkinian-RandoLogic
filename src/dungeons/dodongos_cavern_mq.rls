region RR_DODONGOS_CAVERN_MQ_BEGINNING {
    name: "Dodongos Cavern MQ Beginning"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_ENTRYWAY: always
        RR_DODONGOS_CAVERN_MQ_LOBBY: any_age(can_break_mud_walls() or has(RG_GORONS_BRACELET))
    }
}

region RR_DODONGOS_CAVERN_MQ_LOBBY {
    name: "Dodongos Cavern MQ Lobby"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_DC_EYES_LIT: trick(RT_DC_EYES_CHU) and can_use(RG_BOMBCHU_5)
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_BEGINNING:         always
        RR_DODONGOS_CAVERN_MQ_GOSSIP_STONE:      any_age(can_break_mud_walls() or has(RG_GORONS_BRACELET))
        RR_DODONGOS_CAVERN_MQ_OUTSIDE_POES_ROOM: is_adult() or can_use(RG_HOOKSHOT) or can_ground_jump(trick(RT_GROUND_JUMP_HARD))
        RR_DODONGOS_CAVERN_MQ_MOUTH_SIDE_BRIDGE: any_age(blast_or_smash() or has(RG_GORONS_BRACELET))
        RR_DODONGOS_CAVERN_MQ_STAIRS_LOWER:      any_age(blast_or_smash() or has(RG_GORONS_BRACELET))
        RR_DODONGOS_CAVERN_MQ_LOWER_RIGHT_SIDE:  any_age(can_break_mud_walls()) or any_age(has(RG_GORONS_BRACELET) and take_damage())
        RR_DODONGOS_CAVERN_MQ_BEHIND_MOUTH:      flag(LOGIC_DC_EYES_LIT)
    }
}

region RR_DODONGOS_CAVERN_MQ_GOSSIP_STONE {
    name: "Dodongos Cavern MQ Gossip Stone"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_FAIRY_ACCESS: call_gossip_fairy()
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_LOBBY: always
    }
}

region RR_DODONGOS_CAVERN_MQ_OUTSIDE_POES_ROOM {
    name: "Dodongos Cavern MQ Outside Poes Room"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_LOBBY:     always
        RR_DODONGOS_CAVERN_MQ_POES_ROOM: always
    }
}

region RR_DODONGOS_CAVERN_MQ_MOUTH_SIDE_BRIDGE {
    name: "Dodongos Cavern MQ Mouth Side Bridge"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_DC_MQ_CLEAR_UPPER_LOBBY_ROCKS: blast_or_smash() or can_use(RG_DINS_FIRE)
        LOGIC_DC_EYES_LIT:                   has_explosives() or (flag(LOGIC_DC_MQ_CLEAR_UPPER_LOBBY_ROCKS) and has(RG_GORONS_BRACELET) and ((is_adult() and trick(RT_DC_MQ_ADULT_EYES)) or (is_child() and trick(RT_DC_MQ_CHILD_EYES))))
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_LOBBY:              always
        RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_UPPER: flag(LOGIC_DC_MQ_CLEAR_UPPER_LOBBY_ROCKS)
        # Bunny hood jump + jumpslash can also make it directly from the raising platform
        RR_DODONGOS_CAVERN_MQ_OUTSIDE_POES_ROOM:  can_use(RG_HOVER_BOOTS) or (trick(RT_DC_MQ_CHILD_BOMBS) and can_jumpslash_except_hammer() and take_damage()) # RANDOTODO is this possible with equip swapped hammer?
        # it is possible to use bunny hood speed, hovers and a jumpslash to go between here and the other bridge (included with TORCH_ROOM_LOWER), but this would be a trick
    }
}

region RR_DODONGOS_CAVERN_MQ_STAIRS_LOWER {
    name: "Dodongos Cavern MQ Stairs Lower"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_LOBBY:                always
        # This is possible with sticks and shield, igniting a first flower by "touch" then very quickly crouch stabbing in a way that cuts the corner to light the 3rd bomb on the other side, but that's a trick
        RR_DODONGOS_CAVERN_MQ_STAIRS_UPPER:         any_age(has_explosives() or can_use(RG_DINS_FIRE) or (trick(RT_DC_STAIRS_WITH_BOW) and can_use(RG_FAIRY_BOW)))
        RR_DODONGOS_CAVERN_MQ_STAIRS_PAST_MUD_WALL: any_age(has(RG_GORONS_BRACELET) or can_break_mud_walls())
    }
}

region RR_DODONGOS_CAVERN_MQ_STAIRS_PAST_MUD_WALL {
    name: "Dodongos Cavern MQ Stairs Past Mud Wall"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_STICK_ACCESS: can_get_deku_baba_sticks()
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_STAIRS_UPPER: has_explosives() or (has(RG_GORONS_BRACELET) and (can_use(RG_STICKS) or trick(RT_DC_MQ_STAIRS_WITH_ONLY_STRENGTH))) or can_use(RG_DINS_FIRE) or (trick(RT_DC_STAIRS_WITH_BOW) and can_use(RG_FAIRY_BOW))
        RR_DODONGOS_CAVERN_MQ_STAIRS_LOWER: always
    }
}

region RR_DODONGOS_CAVERN_MQ_STAIRS_UPPER {
    name: "Dodongos Cavern MQ Stairs Upper"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_DC_MQ_STAIRS_SILVER_RUPEES: has(RG_CLIMB)
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_STAIRS_LOWER:               always
        RR_DODONGOS_CAVERN_MQ_STAIRS_PAST_BIG_SKULLTULAS: can_pass(RE_BIG_SKULLTULA) or can_use(RG_HOVER_BOOTS)
    }
}

region RR_DODONGOS_CAVERN_MQ_STAIRS_PAST_BIG_SKULLTULAS {
    name: "Dodongos Cavern MQ Past Big Skulltulas"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_STAIRS_UPPER: can_pass(RE_BIG_SKULLTULA) or can_use(RG_HOVER_BOOTS)
        RR_DODONGOS_CAVERN_MQ_STAIRS_LOWER: take_damage()
        RR_DODONGOS_CAVERN_MQ_DODONGO_ROOM: flag(LOGIC_DC_MQ_STAIRS_SILVER_RUPEES)
    }
}

region RR_DODONGOS_CAVERN_MQ_DODONGO_ROOM {
    name: "Dodongos Cavern MQ Dodongo Room"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_STAIRS_PAST_BIG_SKULLTULAS: always
        RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_LOWER:         any_age(can_kill(RE_DODONGO) or has(RG_GORONS_BRACELET))
    }
}

region RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_LOWER {
    name: "Dodongos Cavern MQ Torch Puzzle Lower"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_DC_MQ_CLEAR_UPPER_LOBBY_ROCKS: ((is_adult() and (has(RG_POWER_BRACELET) or trick(RT_UNINTUITIVE_JUMPS))) or can_use(RG_HOVER_BOOTS)) and can_use(RG_STICKS)
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_LOBBY:              take_damage()
        RR_DODONGOS_CAVERN_MQ_DODONGO_ROOM:       has(RG_POWER_BRACELET) or can_climb_ladder()
        RR_DODONGOS_CAVERN_MQ_LARVAE_ROOM:        has_fire_source() or (can_use(RG_STICKS) and has(RG_POWER_BRACELET))
        RR_DODONGOS_CAVERN_MQ_BIG_BLOCK_ROOM:     any_age(has_fire_source_with_torch()) # Includes an implied can_pass(RE_BIG_SKULLTULA)
        # Bunny hood jump can make it as child
        RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_UPPER: (is_adult() and (has(RG_POWER_BRACELET) or trick(RT_UNINTUITIVE_JUMPS) or can_ground_jump())) or can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT)
        RR_DODONGOS_CAVERN_MQ_UPPER_LIZALFOS:     can_use(RG_STICKS) and has(RG_GORONS_BRACELET) # Implies access to RR_DODONGOS_CAVERN_MQ_BIG_BLOCK_ROOM from here
    }
}

region RR_DODONGOS_CAVERN_MQ_BIG_BLOCK_ROOM {
    name: "Dodongos Cavern MQ Big Block Room"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_LOWER: can_pass(RE_BIG_SKULLTULA)
        RR_DODONGOS_CAVERN_MQ_UPPER_LIZALFOS:     (is_adult() or has(RG_POWER_BRACELET) or can_use(RG_HOVER_BOOTS)) and ((has_fire_source() and has(RG_GORONS_BRACELET)) or can_break_mud_walls()) # If you can somehow warp into this room, add can_pass(RE_BIG_SKULLTULA)
    }
}

region RR_DODONGOS_CAVERN_MQ_LARVAE_ROOM {
    name: "Dodongos Cavern MQ Larvae Room"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_LOWER: always # implied can_kill(RE_GOHMA_LARVA) based on entry reqs with a trick to kill with nuts
    }
}

region RR_DODONGOS_CAVERN_MQ_UPPER_LIZALFOS {
    name: "Dodongos Cavern MQ Before Upper Lizalfos"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        # Falling down gets you stuck with nothing there, not a useful exit for logic
        RR_DODONGOS_CAVERN_MQ_BIG_BLOCK_ROOM: any_age(can_kill(RE_LIZALFOS))
        RR_DODONGOS_CAVERN_MQ_TWO_FIRES_ROOM: any_age(can_kill(RE_LIZALFOS))
    }
}

region RR_DODONGOS_CAVERN_MQ_TWO_FIRES_ROOM {
    name: "Dodongos Cavern MQ Before Upper Lizalfos"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_UPPER_LIZALFOS: always
        # crate platforming skips the puzzle
        RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_UPPER: is_adult() or (any_age(blast_or_smash() or (can_attack() and has(RG_GORONS_BRACELET))))
    }
}

region RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_UPPER {
    name: "Dodongos Cavern MQ Torch Puzzle Upper"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_DC_MQ_CLEAR_UPPER_LOBBY_ROCKS: can_detonate_upright_bomb_flower() or can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_MOUTH_SIDE_BRIDGE:  flag(LOGIC_DC_MQ_CLEAR_UPPER_LOBBY_ROCKS)
        RR_DODONGOS_CAVERN_MQ_TORCH_PUZZLE_LOWER: always
        RR_DODONGOS_CAVERN_MQ_TWO_FIRES_ROOM:     always
        # Implied drop to LOWER_RIGHT_SIDE
        RR_DODONGOS_CAVERN_MQ_LOWER_RIGHT_SIDE:   has(RG_GORONS_BRACELET) and take_damage() # strength 1 and bunny speed works too
    }
}

region RR_DODONGOS_CAVERN_MQ_LOWER_RIGHT_SIDE {
    name: "Dodongos Cavern MQ Lower Right Side"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_LOBBY:                  always
        RR_DODONGOS_CAVERN_MQ_LOWER_RIGHT_SIDE_SCRUB: can_break_mud_walls() or has(RG_GORONS_BRACELET)
        RR_DODONGOS_CAVERN_MQ_LOWER_LIZALFOS:         any_age(can_detonate_bomb_flowers() or has(RG_GORONS_BRACELET)) and can_hit_eye_targets()
    }
}

region RR_DODONGOS_CAVERN_MQ_LOWER_RIGHT_SIDE_SCRUB {
    name: "Dodongos Cavern MQ Lower Right Side Scrub"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_LOWER_RIGHT_SIDE: always
    }
}

region RR_DODONGOS_CAVERN_MQ_LOWER_LIZALFOS {
    name: "Dodongos Cavern MQ Lower Lizalfos"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_LOWER_RIGHT_SIDE: any_age(can_kill(RE_LIZALFOS))
        RR_DODONGOS_CAVERN_MQ_POES_ROOM:        any_age(can_kill(RE_LIZALFOS))
    }
}

region RR_DODONGOS_CAVERN_MQ_POES_ROOM {
    name: "Dodongos Cavern MQ Poes Room"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_OUTSIDE_POES_ROOM: any_age(can_detonate_bomb_flowers() or has(RG_GORONS_BRACELET))
        RR_DODONGOS_CAVERN_MQ_LOWER_LIZALFOS:    always
        RR_DODONGOS_CAVERN_MQ_MAD_SCRUB_ROOM:    any_age(can_detonate_bomb_flowers() or has(RG_GORONS_BRACELET))
    }
}

region RR_DODONGOS_CAVERN_MQ_MAD_SCRUB_ROOM {
    name: "Dodongos Cavern Mad Scrub Room"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_POES_ROOM: any_age(can_kill(RE_FIRE_KEESE) and can_kill(RE_MAD_SCRUB))
    }
}

region RR_DODONGOS_CAVERN_MQ_BEHIND_MOUTH {
    name: "Dodongos Cavern MQ Behind Mouth"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_LOBBY:             always
        RR_DODONGOS_CAVERN_MQ_BACK_BEHIND_FIRE:  has(RG_POWER_BRACELET) or has_explosives() or
                                                 (is_adult() and (can_use(RG_HOVER_BOOTS) or trick(RT_UNINTUITIVE_JUMPS)))
        RR_DODONGOS_CAVERN_MQ_BACK_SWITCH_GRAVE: is_adult()
    }
}

region RR_DODONGOS_CAVERN_MQ_BACK_BEHIND_FIRE {
    name: "Dodongos Cavern MQ Back Behind Fire"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_DC_MQ_BEHIND_FIRE_SWITCH: can_detonate_bomb_flowers()
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_BEHIND_MOUTH:      can_hit_switch()
        RR_DODONGOS_CAVERN_MQ_BACK_POE_ROOM:     always
        # There's a trick N64 rolls into the child eyes trick for using armos blow up the bomb flowers when dieing, which would be killing an armos
        RR_DODONGOS_CAVERN_MQ_BACK_SWITCH_GRAVE: (can_pass(RE_ARMOS) and (is_adult() or flag(LOGIC_DC_MQ_BEHIND_FIRE_SWITCH))) or can_use(RG_HOVER_BOOTS)
    }
}

region RR_DODONGOS_CAVERN_MQ_BACK_POE_ROOM {
    name: "Dodongos Cavern MQ Back Poe Room"
    scene: SCENE_DODONGOS_CAVERN

    exits {
        RR_DODONGOS_CAVERN_MQ_BACK_BEHIND_FIRE: any_age(can_kill(RE_POE))
    }
}

region RR_DODONGOS_CAVERN_MQ_BACK_SWITCH_GRAVE {
    name: "Dodongos Cavern MQ Back Switch Grave"
    scene: SCENE_DODONGOS_CAVERN

    events {
        LOGIC_DC_MQ_BEHIND_FIRE_SWITCH: has(RG_POWER_BRACELET) or can_hit_switch() or can_detonate_bomb_flowers()
        LOGIC_FAIRY_ACCESS:             can_break_pots()
    }

    exits {
        RR_DODONGOS_CAVERN_MQ_BEHIND_MOUTH:     always
        RR_DODONGOS_CAVERN_MQ_BACK_BEHIND_FIRE: always
        RR_DODONGOS_CAVERN_BOSS_ENTRYWAY:       has(RG_POWER_BRACELET)
    }
}
