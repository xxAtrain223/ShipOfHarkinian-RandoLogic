region RR_FIRE_TEMPLE_FOYER {
    name: "Fire Temple Foyer"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_ENTRYWAY:             always
        RR_FIRE_TEMPLE_NEAR_BOSS_ROOM:       always
        RR_FIRE_TEMPLE_LOOP_HEXAGON_ROOM:    any_age(can_use(RG_MEGATON_HAMMER)) and (small_keys(SCENE_FIRE_TEMPLE, 8) 
                                             or not is_fire_loop_locked())
        RR_FIRE_TEMPLE_LOOP_CAGE_FOYER_SIDE: always
        RR_FIRE_TEMPLE_BIG_LAVA_ROOM:        small_keys(SCENE_FIRE_TEMPLE, 2) and fire_timer() >= 24
    }
}

region RR_FIRE_TEMPLE_NEAR_BOSS_ROOM {
    name: "Fire Temple Near Boss Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FOYER:           (is_adult() or can_use(RG_HOVER_BOOTS)) and (fire_timer() >= 16 or 
                                        (flag(LOGIC_FIRE_HIT_PLATFORM) and fire_timer() >= 8))
        RR_FIRE_TEMPLE_NEAR_BOSS_UPPER: is_adult() and (can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)) and 
                                        fire_timer() >= 16
        RR_FIRE_TEMPLE_BOSS_ENTRYWAY:   fire_timer() >= 16 and (can_use(RG_HOVER_BOOTS) or (is_adult() and 
                                        (trick(RT_UNINTUITIVE_JUMPS) or flag(LOGIC_FIRE_HIT_PLATFORM))))
    }
}

#This region assumes tunic logic is handled on entry.
region RR_FIRE_TEMPLE_NEAR_BOSS_UPPER {
    name: "Fire Temple Near Boss Upper"
    scene: SCENE_FIRE_TEMPLE

    events {
        LOGIC_FAIRY_ACCESS: can_break_pots()
    }

    exits {
        #Exits should be handled if there's any way here directly
    }
}

region RR_FIRE_TEMPLE_LOOP_HEXAGON_ROOM {
    name: "Fire Temple Loop Hexagon Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FOYER:            small_keys(SCENE_FIRE_TEMPLE, 8) or not is_fire_loop_locked()
        RR_FIRE_TEMPLE_LOOP_5_TILE_ROOM: any_age(can_kill(RE_TORCH_SLUG) and can_kill(RE_FIRE_KEESE))
    }
}

region RR_FIRE_TEMPLE_LOOP_5_TILE_ROOM {
    name: "Fire Temple Loop 5 Tile Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_LOOP_HEXAGON_ROOM: always
        RR_FIRE_TEMPLE_LOOP_FLARE_DANCER: always
    }
}

region RR_FIRE_TEMPLE_LOOP_FLARE_DANCER {
    name: "Fire Temple Loop Flare Dancer"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_LOOP_5_TILE_ROOM: any_age(can_kill(RE_FLARE_DANCER))
        RR_FIRE_TEMPLE_LOOP_CAGE_SWITCH: any_age(can_kill(RE_FLARE_DANCER))
    }
}

region RR_FIRE_TEMPLE_LOOP_CAGE_SWITCH {
    name: "Fire Temple Loop Cage Switch"
    scene: SCENE_FIRE_TEMPLE

    events {
        LOGIC_FIRE_LOOP_SWITCH: can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_FIRE_TEMPLE_LOOP_FLARE_DANCER: always
        RR_FIRE_TEMPLE_LOOP_GORON_CAGE:   flag(LOGIC_FIRE_LOOP_SWITCH)
    }
}

region RR_FIRE_TEMPLE_LOOP_GORON_CAGE {
    name: "Fire Temple Loop Goron Cage"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_LOOP_CAGE_SWITCH:     flag(LOGIC_FIRE_LOOP_SWITCH)
        RR_FIRE_TEMPLE_LOOP_CAGE_FOYER_SIDE: flag(LOGIC_FIRE_LOOP_SWITCH)
    }
}

region RR_FIRE_TEMPLE_LOOP_CAGE_FOYER_SIDE {
    name: "Fire Temple Cage Foyer Side"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FOYER:           always
        RR_FIRE_TEMPLE_LOOP_GORON_CAGE: flag(LOGIC_FIRE_LOOP_SWITCH)
    }
}

region RR_FIRE_TEMPLE_BIG_LAVA_ROOM {
    name: "Fire Temple Big Lava Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FOYER:                small_keys(SCENE_FIRE_TEMPLE, 2) and fire_timer() >= 24
        RR_FIRE_TEMPLE_1F_CURVED_CAGE:       fire_timer() >= 24
        RR_FIRE_TEMPLE_8_TILE_ROOM:          is_adult() and fire_timer() >= 32 and (can_use(RG_SONG_OF_TIME) or 
                                             trick(RT_FIRE_SOT))
        RR_FIRE_TEMPLE_STRAIGHTFORWARD_CAGE: (is_adult() and has_explosives() and fire_timer() >= 32) or 
                                             (can_ground_jump() and fire_timer() >= 40)
        # Fewer tunic requirements ends here
        RR_FIRE_TEMPLE_LAVA_GEYSER_1F:       can_use(RG_GORON_TUNIC) and small_keys(SCENE_FIRE_TEMPLE, 3)
    }
}

region RR_FIRE_TEMPLE_1F_CURVED_CAGE {
    name: "Fire Temple 1F Curved Cage"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BIG_LAVA_ROOM: always
    }
}

region RR_FIRE_TEMPLE_8_TILE_ROOM {
    name: "Fire Temple 8 Tile Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BIG_LAVA_ROOM: always
    }
}

region RR_FIRE_TEMPLE_STRAIGHTFORWARD_CAGE {
    name: "Fire Temple Straightforward Cage"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BIG_LAVA_ROOM: always
    }
}

region RR_FIRE_TEMPLE_LAVA_GEYSER_1F {
    name: "Fire Temple Lava Geyser 1F"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BIG_LAVA_ROOM:     small_keys(SCENE_FIRE_TEMPLE, 3)
        RR_FIRE_TEMPLE_LAVA_GEYSER_GRATE: fire_timer() >= 40 and (has(RG_CLIMB) or can_use(RG_HOOKSHOT))
        RR_FIRE_TEMPLE_LAVA_GEYSER_TORCH: can_use(RG_LONGSHOT) and fire_timer() >= 40
    }
}

region RR_FIRE_TEMPLE_LAVA_GEYSER_GRATE {
    name: "Fire Temple Lava Geyser Grate"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_LAVA_GEYSER_1F: take_damage()
        RR_FIRE_TEMPLE_LAVA_GEYSER_2F: fire_timer() >= 48 and has(RG_POWER_BRACELET)
    }
}

#you can get the hearts with an indirect boomerang from here, but it's a trick
region RR_FIRE_TEMPLE_LAVA_GEYSER_TORCH {
    name: "Fire Temple Lava Geyser Torch"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_LAVA_GEYSER_1F:    always
        RR_FIRE_TEMPLE_LAVA_GEYSER_GRATE: can_use(RG_HOOKSHOT)
    }
}

region RR_FIRE_TEMPLE_LAVA_GEYSER_2F {
    name: "Fire Temple Lava Geyser 2F"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_LAVA_GEYSER_TORCH: take_damage() and fire_timer() >= 24
        RR_FIRE_TEMPLE_SHORTCUT_ROOM:     small_keys(SCENE_FIRE_TEMPLE, 4)
    }
}

region RR_FIRE_TEMPLE_SHORTCUT_ROOM {
    name: "Fire Temple Shortcut Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_LAVA_GEYSER_1F:     small_keys(SCENE_FIRE_TEMPLE, 4)
        RR_FIRE_TEMPLE_SHORTCUT_CLIMB:     flag(LOGIC_FIRE_OPENED_UPPER_SHORTCUT)
        RR_FIRE_TEMPLE_BOULDER_MAZE_LOWER: is_adult() and has(RG_CLIMB) and ((has(RG_GORONS_BRACELET) or 
                                           trick(RT_FIRE_STRENGTH)) or can_ground_jump()) and 
                                           can_hit_switch(ED_BOMB_THROW)
    }
}

region RR_FIRE_TEMPLE_SHORTCUT_CLIMB {
    name: "Fire Temple Shortcut Climb"
    scene: SCENE_FIRE_TEMPLE

    events {
        LOGIC_FIRE_OPENED_UPPER_SHORTCUT: always
    }

    exits {
        RR_FIRE_TEMPLE_SHORTCUT_ROOM:      always
        RR_FIRE_TEMPLE_BOULDER_MAZE_UPPER: has(RG_CLIMB)
    }
}

region RR_FIRE_TEMPLE_BOULDER_MAZE_LOWER {
    name: "Fire Temple Boulder Maze Lower"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_SHORTCUT_ROOM:      always
        RR_FIRE_TEMPLE_3F_CURVED_CAGE:     always
        RR_FIRE_TEMPLE_NARROW_PATH_ROOM:   small_keys(SCENE_FIRE_TEMPLE, 5)
        RR_FIRE_TEMPLE_BOULDER_MAZE_UPPER: false
    }
}

region RR_FIRE_TEMPLE_3F_CURVED_CAGE {
    name: "Fire Temple 3F Curved Cage"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BOULDER_MAZE_LOWER: always
    }
}

region RR_FIRE_TEMPLE_NARROW_PATH_ROOM {
    name: "Fire Temple Narrow Path Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BIG_LAVA_ROOM:      take_damage()
        RR_FIRE_TEMPLE_BOULDER_MAZE_LOWER: small_keys(SCENE_FIRE_TEMPLE, 5)
        RR_FIRE_TEMPLE_FIRE_WALL_CHASE:    small_keys(SCENE_FIRE_TEMPLE, 6)
        RR_FIRE_TEMPLE_FIRE_WALL_CAGE:     can_hit_eye_targets()
    }
}

region RR_FIRE_TEMPLE_FIRE_WALL_CHASE {
    name: "Fire Temple Fire Wall Chase"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_NARROW_PATH_ROOM:   fire_timer() >= 24 and small_keys(SCENE_FIRE_TEMPLE, 6)
        RR_FIRE_TEMPLE_FIRE_WALL_CAGE:     fire_timer() >= 16 and is_adult()
        RR_FIRE_TEMPLE_BOULDER_MAZE_UPPER: fire_timer() >= 24 and is_adult()
        RR_FIRE_TEMPLE_CORRIDOR:           fire_timer() >= 16 and is_adult() and small_keys(SCENE_FIRE_TEMPLE, 7)
    }
}

#firetimer for entering this area from RR_FIRE_TEMPLE_FIRE_WALL_CHASE is handled there
region RR_FIRE_TEMPLE_FIRE_WALL_CAGE {
    name: "Fire Temple Fire Wall Cage"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_NARROW_PATH_ROOM: always
        RR_FIRE_TEMPLE_FIRE_WALL_CHASE:  false
    }
}

region RR_FIRE_TEMPLE_BOULDER_MAZE_UPPER {
    name: "Fire Temple Boulder Maze Upper"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_SHORTCUT_CLIMB:     has_explosives()
        RR_FIRE_TEMPLE_BOULDER_MAZE_LOWER: always
        RR_FIRE_TEMPLE_FIRE_WALL_CHASE:    always
        RR_FIRE_TEMPLE_GS_CLIMB_4F:        reach_scarecrow() or (trick(RT_FIRE_SCARECROW) and is_adult() and 
                                           can_use(RG_LONGSHOT))
    }
}

region RR_FIRE_TEMPLE_GS_CLIMB_4F {
    name: "Fire Temple GS Climb 4F"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BOULDER_MAZE_UPPER: always
        RR_FIRE_TEMPLE_GS_CLIMB_5F:        has(RG_CLIMB)
    }
}

region RR_FIRE_TEMPLE_GS_CLIMB_5F {
    name: "Fire Temple GS Climb 5F"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_GS_CLIMB_4F:    always
        RR_FIRE_TEMPLE_5F_RUINS:       always
    }
}

#RANDOTODO find a better name
region RR_FIRE_TEMPLE_5F_RUINS {
    name: "Fire Temple 5F Ruins"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_GS_CLIMB_4F:      always
        RR_FIRE_TEMPLE_NARROW_PATH_ROOM: take_damage()
    }
}

region RR_FIRE_TEMPLE_CORRIDOR {
    name: "Fire Temple Corridor"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FIRE_WALL_CHASE: small_keys(SCENE_FIRE_TEMPLE, 7)
        RR_FIRE_TEMPLE_FIRE_MAZE_MAIN:  always
    }
}

region RR_FIRE_TEMPLE_FIRE_MAZE_MAIN {
    name: "Fire Temple Fire Maze Main"
    scene: SCENE_FIRE_TEMPLE

    exits {
        #Accounting for either air-drifting to the platform you want and taking fall damage or landing on the platform and jumping off
        RR_FIRE_TEMPLE_NEAR_BOSS_ROOM:      flag(LOGIC_FIRE_HIT_PLATFORM) and (is_adult() or can_use(RG_HOVER_BOOTS) or
                                            take_damage())
        RR_FIRE_TEMPLE_CORRIDOR:            always
        RR_FIRE_TEMPLE_FIRE_MAZE_PLATFORMS: can_use(RG_HOVER_BOOTS) or (is_adult() and 
                                            (flag(LOGIC_FIRE_HIT_ABOVE_MAZE_PLATFORM) or can_ground_jump()))
        RR_FIRE_TEMPLE_CAGELESS_CHEST_ROOM: always
        RR_FIRE_TEMPLE_SOT_CAGE_LOWER:      small_keys(SCENE_FIRE_TEMPLE, 8)
        RR_FIRE_TEMPLE_FIRE_MAZE_SWITCH:    trick(RT_FIRE_SKIP_FLAME_WALLS)
    }
}

region RR_FIRE_TEMPLE_FIRE_MAZE_PLATFORMS {
    name: "Fire Temple Fire Maze Platforms"
    scene: SCENE_FIRE_TEMPLE

    events {
        LOGIC_FIRE_HIT_PLATFORM: can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_FIRE_TEMPLE_FIRE_MAZE_MAIN:      always
        RR_FIRE_TEMPLE_SOT_CAGE_UPPER_DOOR: can_use(RG_MEGATON_HAMMER)
    }
}

region RR_FIRE_TEMPLE_CAGELESS_CHEST_ROOM {
    name: "Fire Temple Cageless Chest Room"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FIRE_MAZE_MAIN: always
    }
}

region RR_FIRE_TEMPLE_SOT_CAGE_LOWER {
    name: "Fire Temple Sot Cage Lower"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FIRE_MAZE_MAIN:      small_keys(SCENE_FIRE_TEMPLE, 8)
        RR_FIRE_TEMPLE_SOT_CAGE_UPPER_DOOR: is_adult() and can_use(RG_SONG_OF_TIME)
        RR_FIRE_TEMPLE_SOT_CAGE_SWITCH:     is_adult() and can_use(RG_SONG_OF_TIME)
        RR_FIRE_TEMPLE_FIRE_MAZE_SWITCH:    always
    }
}

region RR_FIRE_TEMPLE_SOT_CAGE_UPPER_DOOR {
    name: "Fire Temple Sot Cage Upper Door"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BOSS_ENTRYWAY:       false
        RR_FIRE_TEMPLE_SOT_CAGE_SWITCH:     is_adult() or can_use(RG_HOVER_BOOTS) or can_use(RG_SONG_OF_TIME)
        RR_FIRE_TEMPLE_FIRE_MAZE_PLATFORMS: always
        RR_FIRE_TEMPLE_SOT_CAGE_LOWER:      always
    }
}

region RR_FIRE_TEMPLE_SOT_CAGE_SWITCH {
    name: "Fire Temple Sot Cage Switch"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_BOSS_ENTRYWAY:       false
        RR_FIRE_TEMPLE_SOT_CAGE_UPPER_DOOR: is_adult() or can_use(RG_HOVER_BOOTS) or can_use(RG_SONG_OF_TIME)
        RR_FIRE_TEMPLE_SOT_CAGE_LOWER:      always
    }
}

region RR_FIRE_TEMPLE_FIRE_MAZE_SWITCH {
    name: "Fire Temple Fire Maze Switch"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FIRE_MAZE_MAIN:      (trick(RT_FIRE_SKIP_FLAME_WALLS) and take_damage()) or
                                            (is_adult() and can_standing_shield() and can_use(RG_BOMB_BAG) and 
                                            trick(RT_GROUND_JUMP_HARD) and (can_jumpslash() or can_use(RG_HOVER_BOOTS)))
        RR_FIRE_TEMPLE_SOT_CAGE_LOWER:      always
        RR_FIRE_TEMPLE_FIRE_MAZE_PAST_WALL: always
    }
}

region RR_FIRE_TEMPLE_FIRE_MAZE_PAST_WALL {
    name: "Fire Temple Fire Maze Past Wall"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_3F_FLARE_DANCER: has_explosives()
    }
}

region RR_FIRE_TEMPLE_3F_FLARE_DANCER {
    name: "Fire Temple 3F Flare Dancer"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_FIRE_MAZE_PAST_WALL:   any_age(can_kill(RE_FLARE_DANCER))
        RR_FIRE_TEMPLE_ABOVE_3F_FLARE_DANCER: any_age(can_kill(RE_FLARE_DANCER))
    }
}

region RR_FIRE_TEMPLE_ABOVE_3F_FLARE_DANCER {
    name: "Fire Temple Above 3F Flare Dancer"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_3F_FLARE_DANCER: always
        RR_FIRE_TEMPLE_SWITCH_CLIMB:    always
    }
}

region RR_FIRE_TEMPLE_SWITCH_CLIMB {
    name: "Fire Temple Switch Climb"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_ABOVE_3F_FLARE_DANCER: always
        RR_FIRE_TEMPLE_NARROW_STAIRS:         can_hit_switch(ED_BOMB_THROW) and has(RG_CLIMB)
    }
}

region RR_FIRE_TEMPLE_NARROW_STAIRS {
    name: "Fire Temple Narrow Stairs"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_SOT_CAGE_UPPER_DOOR: take_damage()
        RR_FIRE_TEMPLE_SOT_CAGE_SWITCH:     take_damage()
        RR_FIRE_TEMPLE_SWITCH_CLIMB:        always
        RR_FIRE_TEMPLE_NARROW_STAIRS_4F:    any_age(can_use(RG_MEGATON_HAMMER))
    }
}

region RR_FIRE_TEMPLE_NARROW_STAIRS_4F {
    name: "Fire Temple Narrow Stairs 4F"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_TOP_OF_COLLAPSING_STAIRS: any_age(can_use(RG_MEGATON_HAMMER))
        #this return path is blocked by a hammer peg that is a perm flag, if a way up is ever added, LOGIC_FIRE_MQ_HIT_SCARECROW_ROOM_PLATFORM should be reworked
        RR_FIRE_TEMPLE_NARROW_STAIRS:            false
    }
}

region RR_FIRE_TEMPLE_TOP_OF_COLLAPSING_STAIRS {
    name: "Fire Temple Top of Collapsing Stairs"
    scene: SCENE_FIRE_TEMPLE

    events {
        LOGIC_FIRE_HIT_STAIRS:             can_use(RG_MEGATON_HAMMER)
        LOGIC_FIRE_CHILD_AT_TOP_OF_STAIRS: is_child()
    }

    exits {
        RR_FIRE_TEMPLE_NARROW_STAIRS_4F:          always
        RR_FIRE_TEMPLE_BASE_OF_COLLAPSING_STAIRS: flag(LOGIC_FIRE_HIT_STAIRS)
    }
}

region RR_FIRE_TEMPLE_BASE_OF_COLLAPSING_STAIRS {
    name: "Fire Temple Base of Collapsing Stairs"
    scene: SCENE_FIRE_TEMPLE

    exits {
        RR_FIRE_TEMPLE_TOP_OF_COLLAPSING_STAIRS: flag(LOGIC_FIRE_HIT_STAIRS) and is_adult()
        # this is here to maintain 1:1 door entrances between regions
        RR_FIRE_TEMPLE_ABOVE_FIRE_MAZE:          flag(LOGIC_FIRE_HIT_STAIRS) and (is_adult() or flag(LOGIC_FIRE_CHILD_AT_TOP_OF_STAIRS)) and 
                                                 has(RG_POWER_BRACELET)
    }
}

region RR_FIRE_TEMPLE_ABOVE_FIRE_MAZE {
    name: "Fire Temple Above Fire Maze"
    scene: SCENE_FIRE_TEMPLE

    events {
        LOGIC_FIRE_HIT_ABOVE_MAZE_PLATFORM: can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_FIRE_TEMPLE_BASE_OF_COLLAPSING_STAIRS: always
        RR_FIRE_TEMPLE_FIRE_MAZE_MAIN:            flag(LOGIC_FIRE_HIT_ABOVE_MAZE_PLATFORM)
        #it's possible to land directly on the upper platform as child and even avoid fall damage, but it's not intuitive (you have to ledge grab, drop down 
        #and then air drift with enough momentum to roll)
        RR_FIRE_TEMPLE_FIRE_MAZE_PLATFORMS:       flag(LOGIC_FIRE_HIT_ABOVE_MAZE_PLATFORM) and can_jumpslash() and take_damage()
    }
}