region RR_GANONS_CASTLE_LOBBY {
    name: "Ganon's Castle Lobby"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_ENTRYWAY: always
        RR_GANONS_CASTLE_MAIN: always
    }
}

region RR_GANONS_CASTLE_MAIN {
    name: "Ganon's Castle Main"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_LOBBY: always
        RR_GANONS_CASTLE_FOREST_TRIAL_WOLFOS_ROOM: not setting(RSK_MEDALLION_LOCKED_TRIALS) or has(RG_FOREST_MEDALLION)
        RR_GANONS_CASTLE_FIRE_TRIAL_FROM_OPEN: not setting(RSK_MEDALLION_LOCKED_TRIALS) or has(RG_FIRE_MEDALLION)
        RR_GANONS_CASTLE_WATER_TRIAL_BLUE_FIRE_ROOM: not setting(RSK_MEDALLION_LOCKED_TRIALS) or has(RG_WATER_MEDALLION)
        RR_GANONS_CASTLE_SHADOW_TRIAL_START: not setting(RSK_MEDALLION_LOCKED_TRIALS) or has(RG_SHADOW_MEDALLION)
        RR_GANONS_CASTLE_SPIRIT_TRIAL_BEAMOS_ROOM: not setting(RSK_MEDALLION_LOCKED_TRIALS) or has(RG_SPIRIT_MEDALLION)
        RR_GANONS_CASTLE_LIGHT_TRIAL_CHESTS_ROOM:
            (not setting(RSK_MEDALLION_LOCKED_TRIALS) or has(RG_LIGHT_MEDALLION)) and
            can_use(RG_GOLDEN_GAUNTLETS)
        RR_GANONS_TOWER_ENTRYWAY:
            (flag(LOGIC_FOREST_TRIAL_CLEAR) or trial_skipped(TK_FOREST_TRIAL)) and
            (flag(LOGIC_FIRE_TRIAL_CLEAR) or trial_skipped(TK_FIRE_TRIAL)) and
            (flag(LOGIC_WATER_TRIAL_CLEAR) or trial_skipped(TK_WATER_TRIAL)) and
            (flag(LOGIC_SHADOW_TRIAL_CLEAR) or trial_skipped(TK_SHADOW_TRIAL)) and
            (flag(LOGIC_SPIRIT_TRIAL_CLEAR) or trial_skipped(TK_SPIRIT_TRIAL)) and
            (flag(LOGIC_LIGHT_TRIAL_CLEAR) or trial_skipped(TK_LIGHT_TRIAL))
        RR_GANONS_CASTLE_DEKU_SCRUBS: trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH)
    }
}

region RR_GANONS_CASTLE_DEKU_SCRUBS {
    name: "Ganon's Castle Deku Scrubs"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_FAIRY_ACCESS: always
    }
}

region RR_GANONS_CASTLE_FOREST_TRIAL_WOLFOS_ROOM {
    name: "Ganon's Castle Forest Trial Wolfos Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_MAIN: always
        RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM: can_use(RG_FIRE_ARROWS) or (can_use(RG_HOOKSHOT) and can_use(RG_DINS_FIRE))
    }
}

region RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM {
    name: "Ganon's Castle Forest Trial Beamos Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        # child can get these by voiding after switch
        LOGIC_FOREST_TRIAL_SILVER_RUPEES: is_adult() or can_use(RG_HOOKSHOT)
    }

    exits {
        RR_GANONS_CASTLE_FOREST_TRIAL_WOLFOS_ROOM: always
        RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_END: always
    }
}

region RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_END {
    name: "Ganon's Castle Forest Trial Beamos Room End"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM: can_use(RG_LONGSHOT)
        RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_FINAL_DOOR: is_adult() or can_ground_jump() or trick(RT_UNINTUITIVE_JUMPS)
    }
}

region RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_FINAL_DOOR {
    name: "Ganon's Castle Forest Trial Beamos Room Final Door"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_END: always
        RR_GANONS_CASTLE_FOREST_TRIAL_FINAL_ROOM: flag(LOGIC_FOREST_TRIAL_SILVER_RUPEES)
    }
}

region RR_GANONS_CASTLE_FOREST_TRIAL_FINAL_ROOM {
    name: "Ganon's Castle Forest Trial Final Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_FOREST_TRIAL_CLEAR: can_use(RG_LIGHT_ARROWS)
    }

    exits {
        RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_FINAL_DOOR: always
    }
}

region RR_GANONS_CASTLE_FIRE_TRIAL_OPEN_DOOR {
    name: "Ganon's Castle Fire Trial Open Door"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_MAIN: always
    }
}

region RR_GANONS_CASTLE_FIRE_TRIAL_FROM_OPEN {
    name: "Ganon's Castle Fire Trial From Open Door"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        # backwalking hoverboots with backflip reaches silver rupee without needing str3
        LOGIC_FIRE_TRIAL_SILVER_RUPEES: fire_timer() >= 48 and can_use(RG_GOLDEN_GAUNTLETS)
    }

    exits {
        RR_GANONS_CASTLE_FIRE_TRIAL_OPEN_DOOR: always
        RR_GANONS_CASTLE_FIRE_TRIAL_BARRED_DOOR: can_use(RG_LONGSHOT) and fire_timer() >= 16
    }
}

region RR_GANONS_CASTLE_FIRE_TRIAL_FROM_BARRED {
    name: "Ganon's Castle Fire Trial From Barred Door"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        # backwalking hoverboots with backflip reaches silver rupee without needing str3
        LOGIC_FIRE_TRIAL_SILVER_RUPEES: fire_timer() >= 56 and can_use(RG_GOLDEN_GAUNTLETS)
    }

    exits {
        RR_GANONS_CASTLE_FIRE_TRIAL_OPEN_DOOR: can_use(RG_LONGSHOT) and fire_timer() >= 24
        RR_GANONS_CASTLE_FIRE_TRIAL_BARRED_DOOR: always
    }
}

region RR_GANONS_CASTLE_FIRE_TRIAL_BARRED_DOOR {
    name: "Ganon's Castle Fire Trial Barred Door"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_FIRE_TRIAL_FINAL_ROOM: flag(LOGIC_FIRE_TRIAL_SILVER_RUPEES)
    }
}

region RR_GANONS_CASTLE_FIRE_TRIAL_FINAL_ROOM {
    name: "Ganon's Castle Fire Trial Final Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_FIRE_TRIAL_CLEAR: can_use(RG_LIGHT_ARROWS)
    }

    exits {
        RR_GANONS_CASTLE_FIRE_TRIAL_FROM_BARRED: always
    }
}

region RR_GANONS_CASTLE_WATER_TRIAL_BLUE_FIRE_ROOM {
    name: "Ganon's Castle Water Trial Blue Fire Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_BLUE_FIRE_ACCESS: can_clear_stalagmite() or trick(RT_ICE_STALAGMITE_CLIP)
    }

    exits {
        RR_GANONS_CASTLE_MAIN: always
        RR_GANONS_CASTLE_WATER_TRIAL_BLOCK_ROOM: blue_fire()
    }
}

region RR_GANONS_CASTLE_WATER_TRIAL_BLOCK_ROOM {
    name: "Ganon's Castle Water Trial Block Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_FAIRY_ACCESS: can_break_pots()
        LOGIC_WATER_TRIAL_RUSTED_SWITCH:
            is_adult() and (has(RG_POWER_BRACELET) or can_middair_ground_jump()) and
            (blue_fire() or trick(RT_VISIBLE_COLLISION)) and
            can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_GANONS_CASTLE_WATER_TRIAL_BLUE_FIRE_ROOM: always
        RR_GANONS_CASTLE_WATER_TRIAL_BLOCK_ROOM_END:
            is_adult() or (has(RG_POWER_BRACELET) and can_use(RG_HOVER_BOOTS)) or can_ground_jump() or trick(RT_SLIDE_JUMP)
    }
}

region RR_GANONS_CASTLE_WATER_TRIAL_BLOCK_ROOM_END {
    name: "Ganon's Castle Water Trial Block Room End"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_WATER_TRIAL_BLOCK_ROOM: always
        RR_GANONS_CASTLE_WATER_TRIAL_FINAL_ROOM: flag(LOGIC_WATER_TRIAL_RUSTED_SWITCH)
    }
}

region RR_GANONS_CASTLE_WATER_TRIAL_FINAL_ROOM {
    name: "Ganon's Castle Water Trial Final Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_WATER_TRIAL_CLEAR: can_use(RG_LIGHT_ARROWS)
    }

    exits {
        RR_GANONS_CASTLE_WATER_TRIAL_BLOCK_ROOM_END: always
    }
}

region RR_GANONS_CASTLE_SHADOW_TRIAL_START {
    name: "Ganon's Castle Shadow Trial Start"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_MAIN: always
        RR_GANONS_CASTLE_SHADOW_TRIAL_POTS_PLATFORM: can_use(RG_FIRE_ARROWS) or can_use(RG_LONGSHOT)
        # shortcut for longshot to torch, dins, longshot to like like, run to chest platform
        RR_GANONS_CASTLE_SHADOW_TRIAL_CHEST_PLATFORM: can_use(RG_DINS_FIRE) and can_use(RG_LONGSHOT)
    }
}

region RR_GANONS_CASTLE_SHADOW_TRIAL_POTS_PLATFORM {
    name: "Ganon's Castle Shadow Pots Platform"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_SHADOW_TRIAL_START: can_use(RG_FIRE_ARROWS) or can_use(RG_LONGSHOT)
        RR_GANONS_CASTLE_SHADOW_TRIAL_CHEST_PLATFORM:
            can_use(RG_FIRE_ARROWS) or can_use(RG_HOVER_BOOTS) or
            (flag(LOGIC_SHADOW_TRIAL_LOWER_SWITCH) and can_use(RG_HOOKSHOT))
    }
}

region RR_GANONS_CASTLE_SHADOW_TRIAL_CHEST_PLATFORM {
    name: "Ganon's Castle Shadow Chest Platform"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_SHADOW_TRIAL_RUSTED_SWITCH:
            (trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_HOVER_BOOTS)) and
            can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_GANONS_CASTLE_SHADOW_TRIAL_POTS_PLATFORM: can_use(RG_FIRE_ARROWS) or can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)
        RR_GANONS_CASTLE_SHADOW_TRIAL_LOWER_SWITCH:
            can_use(RG_FIRE_ARROWS) or trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_HOVER_BOOTS)
        RR_GANONS_CASTLE_SHADOW_TRIAL_END: trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH)
    }
}

region RR_GANONS_CASTLE_SHADOW_TRIAL_LOWER_SWITCH {
    name: "Ganon's Castle Shadow Trial Lower Switch"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_SHADOW_TRIAL_LOWER_SWITCH: always
    }

    exits {
        RR_GANONS_CASTLE_SHADOW_TRIAL_CHEST_PLATFORM:
            can_use(RG_FIRE_ARROWS) or (flag(LOGIC_SHADOW_TRIAL_LOWER_SWITCH) and can_use(RG_LONGSHOT))
    }
}

region RR_GANONS_CASTLE_SHADOW_TRIAL_END {
    name: "Ganon's Castle Shadow Trial End"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_SHADOW_TRIAL_CHEST_PLATFORM:
            (trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH)) or
            (can_use(RG_HOVER_BOOTS) and has_fire_source()) or
            (flag(LOGIC_SHADOW_TRIAL_LOWER_SWITCH) and can_use(RG_LONGSHOT))
        RR_GANONS_CASTLE_SHADOW_TRIAL_POTS_PLATFORM:
            can_use(RG_LONGSHOT) and can_use(RG_DINS_FIRE) and (trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH))
        RR_GANONS_CASTLE_SHADOW_TRIAL_LOWER_SWITCH: can_use(RG_HOVER_BOOTS)
        RR_GANONS_CASTLE_SHADOW_TRIAL_FINAL_ROOM: flag(LOGIC_SHADOW_TRIAL_RUSTED_SWITCH)
    }
}

region RR_GANONS_CASTLE_SHADOW_TRIAL_FINAL_ROOM {
    name: "Ganon's Castle Shadow Trial Final Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_SHADOW_TRIAL_CLEAR: can_use(RG_LIGHT_ARROWS)
    }

    exits {
        RR_GANONS_CASTLE_SHADOW_TRIAL_END: always
    }
}

region RR_GANONS_CASTLE_SPIRIT_TRIAL_BEAMOS_ROOM {
    name: "Ganon's Castle Spirit Trial Beamos Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_MAIN: always
        RR_GANONS_CASTLE_SPIRIT_TRIAL_BEFORE_SWITCH: trick(RT_GANON_SPIRIT_TRIAL_HOOKSHOT) or can_use(RG_HOOKSHOT)
    }
}

region RR_GANONS_CASTLE_SPIRIT_TRIAL_BEFORE_SWITCH {
    name: "Ganon's Castle Spirit Trial Before Switch"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_SPIRIT_TRIAL_BEAMOS_ROOM: always
        RR_GANONS_CASTLE_SPIRIT_TRIAL_AFTER_SWITCH:
            can_use(RG_BOMBCHU_5) or
            (trick(RT_ITEM_EXTENSION) and (can_use(RG_FAIRY_BOW) or can_use(RG_FAIRY_SLINGSHOT)))
    }
}

region RR_GANONS_CASTLE_SPIRIT_TRIAL_AFTER_SWITCH {
    name: "Ganon's Castle Spirit Trial After Switch"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_SPIRIT_TRIAL_BEFORE_SWITCH: always
        RR_GANONS_CASTLE_SPIRIT_TRIAL_FINAL_ROOM:
            can_use(RG_FAIRY_BOW) and (can_use(RG_MIRROR_SHIELD) or sunlight_arrows())
    }
}

region RR_GANONS_CASTLE_SPIRIT_TRIAL_FINAL_ROOM {
    name: "Ganon's Castle Spirit Trial Final Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_SPIRIT_TRIAL_CLEAR: can_use(RG_LIGHT_ARROWS)
        LOGIC_NUT_ACCESS: can_break_pots()
    }

    exits {
        RR_GANONS_CASTLE_SPIRIT_TRIAL_AFTER_SWITCH: always
    }
}

region RR_GANONS_CASTLE_LIGHT_TRIAL_CHESTS_ROOM {
    name: "Ganon's Castle Light Trial Chests Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_MAIN: always
        RR_GANONS_CASTLE_LIGHT_TRIAL_TRIFORCE_ROOM: small_keys(SCENE_INSIDE_GANONS_CASTLE, 1)
    }
}

region RR_GANONS_CASTLE_LIGHT_TRIAL_TRIFORCE_ROOM {
    name: "Ganon's Castle Light Trial Triforce Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_LIGHT_TRIAL_CHESTS_ROOM: always
        RR_GANONS_CASTLE_LIGHT_TRIAL_BOULDER_ROOM: small_keys(SCENE_INSIDE_GANONS_CASTLE, 2)
    }
}

region RR_GANONS_CASTLE_LIGHT_TRIAL_BOULDER_ROOM {
    name: "Ganon's Castle Light Trial Boulder Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    exits {
        RR_GANONS_CASTLE_LIGHT_TRIAL_TRIFORCE_ROOM: small_keys(SCENE_INSIDE_GANONS_CASTLE, 2)
        RR_GANONS_CASTLE_LIGHT_TRIAL_FINAL_ROOM: can_use(RG_HOOKSHOT) or (is_adult() and can_ground_jump())
    }
}

region RR_GANONS_CASTLE_LIGHT_TRIAL_FINAL_ROOM {
    name: "Ganon's Castle Light Trial Final Room"
    scene: SCENE_INSIDE_GANONS_CASTLE

    events {
        LOGIC_LIGHT_TRIAL_CLEAR: (trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_LIGHT_ARROWS)
    }

    exits {
        RR_GANONS_CASTLE_LIGHT_TRIAL_BOULDER_ROOM: always
    }
}
