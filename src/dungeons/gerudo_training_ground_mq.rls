region RR_GERUDO_TRAINING_GROUND_MQ_LOBBY {
    name: "Gerudo Training Ground MQ Lobby"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_ENTRYWAY:         always
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_BY_LOBBY: always
        RR_GERUDO_TRAINING_GROUND_MQ_SAND_ROOM:     any_age(has_fire_source())
        RR_GERUDO_TRAINING_GROUND_MQ_DINOLFOS_ROOM: any_age(can_hit_eye_targets())
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_MAZE_BY_LOBBY {
    name: "Gerudo Training Ground MQ Maze By Lobby"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_LOBBY:           always
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_FIRST_LOCK: small_keys(SCENE_GERUDO_TRAINING_GROUND, 1)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_MAZE_FIRST_LOCK {
    name: "Gerudo Training Ground MQ Maze First Lock"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_LOBBY:       small_keys(SCENE_GERUDO_TRAINING_GROUND, 1)
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_CENTER: small_keys(SCENE_GERUDO_TRAINING_GROUND, 3)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_MAZE_CENTER {
    name: "Gerudo Training Ground MQ Maze Center"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_GTG_MQ_MAZE_SWITCH: can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_FIRST_LOCK: small_keys(SCENE_GERUDO_TRAINING_GROUND, 3)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_SAND_ROOM {
    name: "Gerudo Training Ground MQ Sand Room"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_LOBBY:        always
        RR_GERUDO_TRAINING_GROUND_MQ_BOULDER_ROOM: any_age(can_kill(RE_IRON_KNUCKLE))
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_BOULDER_ROOM {
    name: "Gerudo Training Ground MQ Left Side"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_GTG_SILVER_SLOPE: can_use(RG_LONGSHOT) or trick(RT_GTG_MQ_WITHOUT_HOOKSHOT) or
                                (trick(RT_GTG_MQ_WITH_HOOKSHOT) and is_adult() and can_jumpslash() and can_use(RG_HOOKSHOT))
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_SAND_ROOM:    always
        RR_GERUDO_TRAINING_GROUND_MQ_STALFOS_ROOM: has(RG_GTG_SILVER_SLOPE)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_STALFOS_ROOM {
    name: "Gerudo Training Ground MQ Stalfos Room"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_BLUE_FIRE_ACCESS:                     always
        LOGIC_GTG_UNLOCKED_DOOR_BEHIND_HEAVY_BLOCK: any_age(can_kill(RE_STALFOS, ED_CLOSE, true, 2, true))
        LOGIC_GTG_PUSHED_HEAVY_BLOCK:               can_use(RG_SILVER_GAUNTLETS) and can_avoid(RE_STALFOS, ED_CLOSE, true, 2)
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_BOULDER_ROOM:        always
        RR_GERUDO_TRAINING_GROUND_MQ_BEHIND_BLOCK:        flag(LOGIC_GTG_PUSHED_HEAVY_BLOCK)
        RR_GERUDO_TRAINING_GROUND_MQ_STALFOS_ROOM_ALCOVE: is_adult() and (trick(RT_LENS_GTG_MQ) or can_use(RG_LENS_OF_TRUTH)) and blue_fire() and
                                                          (can_use(RG_SONG_OF_TIME) or (flag(LOGIC_GTG_UNLOCKED_DOOR_BEHIND_HEAVY_BLOCK) and (trick(RT_GTG_FAKE_WALL) or bunny_hood()) and can_use(RG_HOVER_BOOTS)) or can_ground_jump())
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_BEHIND_BLOCK {
    name: "Gerudo Training Ground MQ Behind Block"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_STALFOS_ROOM:      flag(LOGIC_GTG_PUSHED_HEAVY_BLOCK)
        RR_GERUDO_TRAINING_GROUND_MQ_ROOM_BEHIND_BLOCK: flag(LOGIC_GTG_UNLOCKED_DOOR_BEHIND_HEAVY_BLOCK)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_ROOM_BEHIND_BLOCK {
    name: "Gerudo Training Ground MQ Room Behind Block"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_BEHIND_BLOCK: always
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_STALFOS_ROOM_ALCOVE {
    name: "Gerudo Training Ground MQ Stalfos Room Alcove"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_STALFOS_ROOM:      always
        RR_GERUDO_TRAINING_GROUND_MQ_STATUE_ROOM_LEDGE: flag(LOGIC_GTG_UNLOCKED_DOOR_BEHIND_HEAVY_BLOCK)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_STATUE_ROOM_LEDGE {
    name: "Gerudo Training Ground MQ Statue Room Ledge"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_STALFOS_ROOM_ALCOVE: always
        RR_GERUDO_TRAINING_GROUND_MQ_MAGENTA_FIRE_ROOM:   any_age(can_hit_switch(not trick(RT_VISIBLE_COLLISION) ? ED_BOMB_THROW : is_adult() ? ED_MASTER_SWORD_JUMPSLASH : ED_LONG_JUMPSLASH))
        RR_GERUDO_TRAINING_GROUND_MQ_STATUE_ROOM:         always
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_MAGENTA_FIRE_ROOM {
    name: "Gerudo Training Ground MQ Magenta Fire Room"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_STATUE_ROOM_LEDGE: always
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_STATUE_ROOM {
    name: "Gerudo Training Ground MQ Statue Room"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_STATUE_ROOM_LEDGE: can_use(RG_LONGSHOT)
        RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SLUG_ROOM:   always
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SLUG_ROOM {
    name: "Gerudo Training Ground MQ Torch Slug Room"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_STATUE_ROOM:  any_age(can_kill(RE_IRON_KNUCKLE))
        RR_GERUDO_TRAINING_GROUND_MQ_SWITCH_LEDGE: any_age(can_kill(RE_IRON_KNUCKLE))
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_SWITCH_LEDGE {
    name: "Gerudo Training Ground MQ Switch Ledge"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH: can_use(RG_MEGATON_HAMMER)
        LOGIC_GTG_SILVER_LAVA:          can_use(RG_FIRE_ARROWS) and (can_use(RG_HOVER_BOOTS) or bunny_hood())
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_LEDGE_SIDE_PLATFORMS:  can_use(RG_FIRE_ARROWS)
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_UNLIT_TORCH: can_use(RG_LONGSHOT) or
                                                            (has(RG_GTG_SILVER_LAVA) and (can_use(RG_HOOKSHOT) or bunny_hovers() or can_megajump() or can_bomb_recoil_hover())) or
                                                            (trick(RT_GTG_MQ_LAVA_ROOM) and ((is_adult() and bunny_hovers()) or can_use(RG_HOOKSHOT) or can_megajump() or can_bomb_recoil_hover()))
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_RIGHT:            flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) and (can_use(RG_LONGSHOT) or (trick(RT_GTG_MQ_LAVA_ROOM) and can_use(RG_HOOKSHOT)))
        RR_GERUDO_TRAINING_GROUND_MQ_FURTHEST_PLATFORM:     can_use(RG_FIRE_ARROWS) and ((can_use(RG_BUNNY_HOOD) and can_jumpslash()) or can_use(RG_HOVER_BOOTS) or can_megajump())
        RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SLUG_ROOM:       always
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_LEDGE_SIDE_PLATFORMS {
    name: "Gerudo Training Ground MQ Ledge Side Platforms"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_RIGHT:            flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) and can_use(RG_HOOKSHOT)
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_UNLIT_TORCH: can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS) or bunny_hood()
        RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SIDE_PLATFORMS:  can_use(RG_HOVER_BOOTS) or bunny_hood() or trick(RT_GTG_LAVA_JUMP) or (flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) and can_use(RG_HOOKSHOT))
        RR_GERUDO_TRAINING_GROUND_MQ_FURTHEST_PLATFORM:     can_use(RG_HOVER_BOOTS) or bunny_hood() or has(RG_GTG_SILVER_LAVA)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_FURTHEST_PLATFORM {
    name: "Gerudo Training Ground MQ Furthest Platform"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_RIGHT:           flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) and can_use(RG_HOOKSHOT)
        RR_GERUDO_TRAINING_GROUND_MQ_LEDGE_SIDE_PLATFORMS: can_use(RG_HOVER_BOOTS) or bunny_hood() or has(RG_GTG_SILVER_LAVA)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_UNLIT_TORCH {
    name: "Gerudo Training Ground MQ Platforms Unlit Torch"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_GTG_SILVER_LAVA: has_fire_source() and (can_use(RG_HOVER_BOOTS) or bunny_hood())
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_UNDERWATER:           has(RG_GTG_SILVER_LAVA)
        RR_GERUDO_TRAINING_GROUND_MQ_LEDGE_SIDE_PLATFORMS: has_fire_source() and (can_use(RG_HOVER_BOOTS) or bunny_hood() or has(RG_GTG_SILVER_LAVA))
        RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SIDE_PLATFORMS: has_fire_source()
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_LIT_TORCH:  can_use(RG_LONGSHOT) or can_recoil_hover_from_actor(ARECOIL_SHORT) or can_bomb_recoil_hover() or can_megajump(true) or
                                                           (trick(RT_GTG_MQ_LAVA_ROOM) and (can_use(RG_HOVER_BOOTS) or (is_adult() and bunny_hood())))
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_RIGHT:           flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) and
                                                           ((can_use(RG_LONGSHOT) or (can_use(RG_HOOKSHOT) and (has_fire_source() or has(RG_GTG_SILVER_LAVA)))) or
                                                            (trick(RT_GTG_MQ_LAVA_ROOM) and can_use(RG_HOOKSHOT) and bunny_hovers()))
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SIDE_PLATFORMS {
    name: "Gerudo Training Ground MQ Torch Side Platforms"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_GTG_SILVER_LAVA: ((can_use(RG_FAIRY_BOW) and is_adult()) or can_use(RG_FIRE_ARROWS)) and can_use(RG_HOVER_BOOTS)
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_LEDGE_SIDE_PLATFORMS:  can_use(RG_HOVER_BOOTS) or bunny_hood() or (is_adult() and trick(RT_GTG_LAVA_JUMP))
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_UNLIT_TORCH: always
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_LIT_TORCH:   always
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_RIGHT:            flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) and can_use(RG_HOOKSHOT)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_LIT_TORCH {
    name: "Gerudo Training Ground MQ Platforms Lit Torch"
    scene: SCENE_GERUDO_TRAINING_GROUND

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SIDE_PLATFORMS:  (can_use(RG_FAIRY_BOW) and is_adult()) or can_use(RG_FIRE_ARROWS)
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_UNLIT_TORCH: can_use(RG_LONGSHOT) or can_recoil_hover_from_actor(ARECOIL_SHORT) or can_bomb_recoil_hover() or can_megajump(true) or
                                                            (trick(RT_GTG_MQ_LAVA_ROOM) and ((is_adult() and bunny_hood()) or can_use(RG_HOVER_BOOTS)))
        RR_GERUDO_TRAINING_GROUND_MQ_MAZE_RIGHT:            flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) and (can_use(RG_LONGSHOT) or (trick(RT_GTG_MQ_LAVA_ROOM) and can_use(RG_HOOKSHOT)))
        RR_GERUDO_TRAINING_GROUND_MQ_DINOLFOS_ROOM:         always
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_UNDERWATER {
    name: "Gerudo Training Ground MQ Underwater"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_GTG_SILVER_WATER: has_fire_source() and has(RG_BRONZE_SCALE) and can_use(RG_IRON_BOOTS) and water_timer() >= 24 and take_damage()
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_UNLIT_TORCH: always
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_MAZE_RIGHT {
    name: "Gerudo Training Ground MQ Maze Right"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_GTG_SILVER_LAVA: can_use(RG_FIRE_ARROWS) and can_use(RG_HOVER_BOOTS)
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_LOBBY:                 always
        RR_GERUDO_TRAINING_GROUND_MQ_TORCH_SIDE_PLATFORMS:  can_use(RG_FIRE_ARROWS)
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_LIT_TORCH:   can_use(RG_LONGSHOT) or can_recoil_hover(RECOIL_HAMMER) or
                                                            (trick(RT_GTG_MQ_LAVA_ROOM) and (is_adult() or bunny_hood() or can_use(RG_HOVER_BOOTS)))
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_UNLIT_TORCH: can_use(has(RG_GTG_SILVER_LAVA) ? RG_HOOKSHOT : RG_LONGSHOT) or
                                                            can_melee_recoil_hover(flag(LOGIC_GTG_MQ_RIGHT_SIDE_SWITCH) ? RECOIL_HAMMER : RECOIL_HAMMER_AND_SHIELD)
        RR_GERUDO_TRAINING_GROUND_MQ_LEDGE_SIDE_PLATFORMS:  can_use(RG_FIRE_ARROWS)
        RR_GERUDO_TRAINING_GROUND_MQ_FURTHEST_PLATFORM:     can_use(RG_FIRE_ARROWS)
    }
}

region RR_GERUDO_TRAINING_GROUND_MQ_DINOLFOS_ROOM {
    name: "Gerudo Training Ground MQ Dinolfos Room"
    scene: SCENE_GERUDO_TRAINING_GROUND

    events {
        LOGIC_FAIRY_ACCESS: is_adult() and can_use(RG_FAIRY_BOW)
    }

    exits {
        RR_GERUDO_TRAINING_GROUND_MQ_LOBBY:               always
        RR_GERUDO_TRAINING_GROUND_MQ_PLATFORMS_LIT_TORCH: any_age(can_use(RG_MASTER_SWORD) or can_use(RG_BIGGORON_SWORD) or
                                                                  can_use(RG_MEGATON_HAMMER) or can_use(RG_FAIRY_BOW) or
                                                                  ((can_use(RG_NUTS) or can_use(RG_HOOKSHOT) or can_use(RG_BOOMERANG)) and (can_use(RG_KOKIRI_SWORD) or can_use(RG_FAIRY_SLINGSHOT))))
    }
}