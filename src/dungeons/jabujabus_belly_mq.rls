region RR_JABU_JABUS_BELLY_MQ_BEGINNING {
    name: "Jabu Jabus Belly MQ Beginning"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_NUT_ACCESS: can_break_pots()
    }

    exits {
        RR_JABU_JABUS_BELLY_ENTRYWAY:     always
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM: any_age(can_use(RG_FAIRY_SLINGSHOT))
    }
}

region RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM {
    name: "Jabu Jabus Belly MQ Lift Room"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_MQ_LIFT_ROOM_COW: can_use(RG_FAIRY_SLINGSHOT)
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_BEGINNING:                     always
        RR_JABU_JABUS_BELLY_MQ_UNDERWATER_ALCOVE:             has(RG_SILVER_SCALE) or (has(RG_BRONZE_SCALE) and (is_child() or can_use(RG_IRON_BOOTS) or trick(RT_UNINTUITIVE_JUMPS)))
        RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM:                    flag(LOGIC_JABU_MQ_HOLES_ROOM_DOOR)
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM_EAST_LEDGE:          flag(LOGIC_JABU_LOWERED_PATH) or can_use(RG_HOVER_BOOTS) or (can_use(RG_HOOKSHOT) and flag(LOGIC_JABU_MQ_LIFT_ROOM_COW))
        RR_JABU_JABUS_BELLY_MQ_WATER_SWITCH_ROOM_PAST_GEYSER: flag(LOGIC_JABU_MQ_WATER_SWITCH_LIFT_ACCESS)
    }
}

region RR_JABU_JABUS_BELLY_MQ_UNDERWATER_ALCOVE {
    name: "Jabu Jabus Belly MQ Underwater Alcove"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_MQ_HOLES_ROOM_DOOR: always
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM: has(RG_BRONZE_SCALE)
    }
}

region RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM {
    name: "Jabu Jabus Belly MQ Holes Room"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_MQ_FORKED_ROOM_DOOR: (has_explosives() or trick(RT_DISTANT_BOULDER_COLLISION)) and can_use(RG_FAIRY_SLINGSHOT)
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM:              always
        RR_JABU_JABUS_BELLY_MQ_HOLES_BASEMENT:         always
        RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM_PAST_JIGGLY: can_use(RG_BOOMERANG)
    }
}

region RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM_PAST_JIGGLY {
    name: "Jabu Jabus Belly MQ Holes Room Past Jiggly"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM:      can_use(RG_BOOMERANG)
        # It is possible to open the door here without crossing the jiggly using RT_DISTANT_BOULDER and good timing
        RR_JABU_JABUS_BELLY_MQ_FORKED_CORRIDOR: flag(LOGIC_JABU_MQ_FORKED_ROOM_DOOR)
    }
}

region RR_JABU_JABUS_BELLY_MQ_HOLES_BASEMENT {
    name: "Jabu Jabus Belly MQ Holes Basement"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM:           has(RG_CLIMB)
        RR_JABU_JABUS_BELLY_MQ_TO_BIGOCTO:           flag(LOGIC_JABU_WEST_TENTACLE)
        RR_JABU_JABUS_BELLY_MQ_WATER_SWITCH_ROOM:    has(RG_SPEAK_ZORA) and has(RG_POWER_BRACELET)
        RR_JABU_JABUS_BELLY_MQ_INVISIBLE_KEESE_ROOM: flag(LOGIC_JABU_NORTH_TENTACLE)
    }
}

region RR_JABU_JABUS_BELLY_MQ_WATER_SWITCH_ROOM {
    name: "Jabu Jabus Belly MQ Water Switch Room"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_MQ_WATER_SWITCH_LIFT_ACCESS: can_kill(RE_LIZALFOS)
    }

    exits {
        # without swim, jump from rang chest to the other side
        RR_JABU_JABUS_BELLY_MQ_WATER_SWITCH_ROOM_PAST_GEYSER: any_age(can_kill(RE_LIZALFOS))
        RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM:                    (is_adult() or has(RG_BRONZE_SCALE)) and any_age(can_kill(RE_LIZALFOS))
    }
}

region RR_JABU_JABUS_BELLY_MQ_WATER_SWITCH_ROOM_PAST_GEYSER {
    name: "Jabu Jabus Belly MQ Water Switch Room Past Geyser"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_WATER_SWITCH_ROOM: flag(LOGIC_JABU_MQ_WATER_SWITCH_LIFT_ACCESS)
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM:         always
    }
}

region RR_JABU_JABUS_BELLY_MQ_FORKED_CORRIDOR {
    name: "Jabu Jabus Belly MQ Forked Corridor"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_HOLES_ROOM:         can_use(RG_BOOMERANG)
        # If some mode lets an age use sticks and not sling, and other use sling and not sticks, this needs changing
        RR_JABU_JABUS_BELLY_MQ_TO_FORK_WEST:       always
        RR_JABU_JABUS_BELLY_MQ_TO_FORK_NORTH_WEST: always
        RR_JABU_JABUS_BELLY_MQ_TO_FORK_NORTH:      blast_or_smash() and has(RG_POWER_BRACELET)
        RR_JABU_JABUS_BELLY_MQ_FORK_NORTH_EAST:    always
        RR_JABU_JABUS_BELLY_MQ_FORK_EAST:          any_age(can_use(RG_FAIRY_SLINGSHOT) and can_use(RG_STICKS)) or any_age(has_fire_source())
    }
}

# this handles spawning in tentacle
region RR_JABU_JABUS_BELLY_MQ_TO_FORK_WEST {
    name: "Jabu Jabus Belly MQ To Fork West"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_FORKED_CORRIDOR: flag(LOGIC_JABU_EAST_TENTACLE) or take_damage()
        RR_JABU_JABUS_BELLY_MQ_FORK_WEST:       flag(LOGIC_JABU_EAST_TENTACLE)
    }
}

region RR_JABU_JABUS_BELLY_MQ_FORK_WEST {
    name: "Jabu Jabus Belly MQ Fork West"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_WEST_TENTACLE: can_kill(RE_TENTACLE, ED_BOOMERANG)
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_TO_FORK_WEST: always
    }
}

# this handles spawning in tentacle
region RR_JABU_JABUS_BELLY_MQ_TO_FORK_NORTH_WEST {
    name: "Jabu Jabus Belly MQ To Fork North West"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_FORKED_CORRIDOR: flag(LOGIC_JABU_EAST_TENTACLE) or take_damage()
        RR_JABU_JABUS_BELLY_MQ_FORK_NORTH_WEST: flag(LOGIC_JABU_EAST_TENTACLE)
    }
}

region RR_JABU_JABUS_BELLY_MQ_FORK_NORTH_WEST {
    name: "Jabu Jabus Belly MQ Fork North West"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_TO_FORK_NORTH_WEST: always
    }
}

region RR_JABU_JABUS_BELLY_MQ_TO_FORK_NORTH {
    name: "Jabu Jabus Belly MQ To Fork North"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_FORKED_CORRIDOR: blast_or_smash()
        RR_JABU_JABUS_BELLY_MQ_FORK_NORTH:      blast_or_smash() and has(RG_POWER_BRACELET)
    }
}

region RR_JABU_JABUS_BELLY_MQ_FORK_NORTH {
    name: "Jabu Jabus Belly MQ Fork North"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_NORTH_TENTACLE: can_use(RG_BOOMERANG)
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_TO_FORK_NORTH: always
    }
}

region RR_JABU_JABUS_BELLY_MQ_FORK_NORTH_EAST {
    name: "Jabu Jabus Belly MQ Fork North East"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_FORKED_CORRIDOR: always
    }
}

region RR_JABU_JABUS_BELLY_MQ_FORK_EAST {
    name: "Jabu Jabus Belly MQ Fork East"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_EAST_TENTACLE: can_kill(RE_TENTACLE, ED_BOOMERANG)
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_FORKED_CORRIDOR: always
    }
}

region RR_JABU_JABUS_BELLY_MQ_INVISIBLE_KEESE_ROOM {
    name: "Jabu Jabus Belly MQ Invisible Keese Room"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_HOLES_BASEMENT: (flag(LOGIC_JABU_NORTH_TENTACLE) or take_damage()) and has(RG_BRONZE_SCALE)
    }
}

# unlike other entrances behind tentacles, Link spawns behind the tentacle. Running into it throws him into main room still
region RR_JABU_JABUS_BELLY_MQ_TO_BIGOCTO {
    name: "Jabu Jabus Belly MQ To Big Octo"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_HOLES_BASEMENT: flag(LOGIC_JABU_WEST_TENTACLE) or take_damage()
        RR_JABU_JABUS_BELLY_MQ_BIGOCTO:        always
    }
}

# Need Ruto here
region RR_JABU_JABUS_BELLY_MQ_BIGOCTO {
    name: "Jabu Jabus Belly MQ Big Octo"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_TO_BIGOCTO:    any_age(has(RG_SPEAK_ZORA) and has(RG_POWER_BRACELET) and can_kill(RE_BIG_OCTO))
        RR_JABU_JABUS_BELLY_MQ_ABOVE_BIGOCTO: any_age(has(RG_SPEAK_ZORA) and has(RG_POWER_BRACELET) and can_kill(RE_BIG_OCTO))
    }
}

region RR_JABU_JABUS_BELLY_MQ_ABOVE_BIGOCTO {
    name: "Jabu Jabus Belly MQ Above Big Octo"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_JIGGLIES_ROOM: always
        RR_JABU_JABUS_BELLY_MQ_BIGOCTO:       take_damage() and any_age(can_kill(RE_BIG_OCTO))
    }
}

region RR_JABU_JABUS_BELLY_MQ_JIGGLIES_ROOM {
    name: "Jabu Jabus Belly MQ Cubes Room"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_ABOVE_BIGOCTO:   always
        RR_JABU_JABUS_BELLY_MQ_ABOVE_LIFT_ROOM: can_use(RG_BOOMERANG) and can_use(RG_FAIRY_SLINGSHOT) and has(RG_POWER_BRACELET)
    }
}

region RR_JABU_JABUS_BELLY_MQ_ABOVE_LIFT_ROOM {
    name: "Jabu Jabus Belly MQ Above Lift Room"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_JABU_LOWERED_PATH: always
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_JIGGLIES_ROOM: always
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM:     always
    }
}

region RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM_EAST_LEDGE {
    name: "Jabu Jabus Belly MQ Lift Room East Ledge"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM:         always
        RR_JABU_JABUS_BELLY_MQ_TO_NEAR_BOSS_ROOM: always
    }
}

# this handles spawning in tentacle
region RR_JABU_JABUS_BELLY_MQ_TO_NEAR_BOSS_ROOM {
    name: "Jabu Jabus Belly MQ To Near Boss Room"
    scene: SCENE_JABU_JABU

    exits {
        RR_JABU_JABUS_BELLY_MQ_LIFT_ROOM_EAST_LEDGE: flag(LOGIC_JABU_NORTH_TENTACLE) or take_damage()
        RR_JABU_JABUS_BELLY_MQ_NEAR_BOSS_ROOM:       flag(LOGIC_JABU_NORTH_TENTACLE)
    }
}

region RR_JABU_JABUS_BELLY_MQ_NEAR_BOSS_ROOM {
    name: "Jabu Jabus Belly MQ Near Boss Room"
    scene: SCENE_JABU_JABU

    events {
        LOGIC_FAIRY_ACCESS: can_break_pots()
    }

    exits {
        RR_JABU_JABUS_BELLY_MQ_TO_NEAR_BOSS_ROOM: always
        RR_JABU_JABUS_BELLY_BOSS_ENTRYWAY:        any_age(can_use(RG_FAIRY_SLINGSHOT))
    }
}
