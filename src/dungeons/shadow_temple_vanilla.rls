region RR_SHADOW_TEMPLE_BEGINNING {
    name: "Shadow Temple Beginning" 
    scene: SCENE_SHADOW_TEMPLE 
    
    exits {
        RR_SHADOW_TEMPLE_ENTRYWAY:               (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and
                                                 (can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT) or can_megajump())
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_START: trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_FIRST_BEAMOS:           any_age(has(RG_POWER_BRACELET) and (can_use(RG_HOVER_BOOTS) or (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)))) and
                                                 (can_use(RG_HOVER_BOOTS) or (is_adult() and bunny_hood()) or can_megajump())
    }
}

region RR_SHADOW_TEMPLE_WHISPERING_WALLS_START { 
    name: "Shadow Temple Whispering Walls Start" 
    scene: SCENE_SHADOW_TEMPLE

    events {    
        LOGIC_NUT_ACCESS: can_break_pots()
    }

    exits {
        RR_SHADOW_TEMPLE_BEGINNING:             always
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_SIDE: trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_END:  trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
    }
}

region RR_SHADOW_TEMPLE_WHISPERING_WALLS_SIDE { 
    name: "Shadow Temple Whispering Walls Side" 
    scene: SCENE_SHADOW_TEMPLE 

    events {
        LOGIC_NUT_ACCESS: can_break_pots ()
    }

    exits {
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_START:     trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_SIDE_ROOM: always
    }
}

region RR_SHADOW_TEMPLE_WHISPERING_WALLS_END { 
    name: "Shadow Temple Whispering Walls End" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_START: trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_DEAD_HAND:              always
    }
}

region RR_SHADOW_TEMPLE_WHISPERING_WALLS_SIDE_ROOM{ 
    name: "Shadow Temple Whispering Walls Side Room" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_SIDE: any_age(can_kill(RE_REDEAD) and can_kill(RE_KEESE))
    }
}

region RR_SHADOW_TEMPLE_DEAD_HAND { 
    name: "Shadow Temple Dead Hand"
    scene: SCENE_SHADOW_TEMPLE
    
    exits{
        RR_SHADOW_TEMPLE_WHISPERING_WALLS_END: any_age(can_kill(RE_DEAD_HAND))
    }
}

region RR_SHADOW_TEMPLE_FIRST_BEAMOS { 
    name: "Shadow Temple First Beamos" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_BEGINNING:            trick(RT_VISIBLE_COLLISION) and (can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT) or (is_adult() and bunny_hood()))
        RR_SHADOW_TEMPLE_COMPASS_ROOM:         always
        RR_SHADOW_TEMPLE_SPINNING_BLADES:      always
        RR_SHADOW_TEMPLE_B2_TO_B3_CORRIDOR_B2: has_explosives() and small_keys(SCENE_SHADOW_TEMPLE, 1)
    }
}

region RR_SHADOW_TEMPLE_COMPASS_ROOM { 
    name: "Shadow Temple Compass Room" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_FIRST_BEAMOS: any_age(can_kill(RE_GIBDO))
    }
}

region RR_SHADOW_TEMPLE_SPINNING_BLADES { 
    name: "Shadow Temple Spinning Blades"
    scene: SCENE_SHADOW_TEMPLE

    events {
        LOGIC_SHADOW_SILVER_BLADES: (is_adult() and (can_use(RG_HOVER_BOOTS) or can_ground_jump())) or
                                    can_use(RG_HOOKSHOT) or bunny_hood() or (can_megajump() and effective_health() > 12)
    }
    
    exits {
        RR_SHADOW_TEMPLE_FIRST_BEAMOS: always
        RR_SHADOW_TEMPLE_DOCK:         flag(LOGIC_SHADOW_SHORTCUT_BLOCK)
    }
}

region RR_SHADOW_TEMPLE_B2_TO_B3_CORRIDOR_B2 { 
    name: "Shadow Temple B2 to B3 Corridor B2" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_FIRST_BEAMOS:         small_keys(SCENE_SHADOW_TEMPLE, 1)
        RR_SHADOW_TEMPLE_B2_TO_B3_CORRIDOR_B3: can_pass(RE_BIG_SKULLTULA)
    }
}

region RR_SHADOW_TEMPLE_B2_TO_B3_CORRIDOR_B3 { 
    name: "Shadow Temple B2 to B3 Corridor B3"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_B2_TO_B3_CORRIDOR_B2: can_use(RG_HOOKSHOT)
        RR_SHADOW_TEMPLE_UPPER_HUGE_PIT:       can_pass(RE_BIG_SKULLTULA)
        # bunnyhovers + lens lets you go from the very top of upper pit to the stationary invisible platform below quite easily
    }
}

region RR_SHADOW_TEMPLE_UPPER_HUGE_PIT { 
    name: "Shadow Temple Upper Huge Pit" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_B2_TO_B3_CORRIDOR_B3:      can_use(RG_LONGSHOT)
        RR_SHADOW_TEMPLE_UPPER_HUGE_PIT_DOOR_LEDGE: trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_LOWER_HUGE_PIT:            is_adult() or can_jumpslash() or bunny_hood() or can_use(RG_HOVER_BOOTS) or trick(RT_SHADOW_MQ_HUGE_PIT)
    }
}

region RR_SHADOW_TEMPLE_UPPER_HUGE_PIT_DOOR_LEDGE { 
    name: "Shadow Temple Upper Huge Pit Door Ledge" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_UPPER_HUGE_PIT:            trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_INVISIBLE_SPINNING_BLADES: small_keys(SCENE_SHADOW_TEMPLE, 2)
    }
}

region RR_SHADOW_TEMPLE_LOWER_HUGE_PIT{ 
    name: "Shadow Temple Lower Huge Pit" 
    scene: SCENE_SHADOW_TEMPLE

    events {
        LOGIC_SHADOW_SILVER_PIT: always
    }
    
    exits {
        RR_SHADOW_TEMPLE_UPPER_HUGE_PIT:            is_adult() or can_jumpslash() or can_use(RG_HOVER_BOOTS) or bunny_hood()
        RR_SHADOW_TEMPLE_LOWER_HUGE_PIT_DOOR_LEDGE: (trick(RT_LENS_SHADOW_PLATFORM) and trick(RT_LENS_SHADOW)) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_STONE_UMBRELLA:            has(RG_SHADOW_SILVER_PIT)
    }
}

region RR_SHADOW_TEMPLE_STONE_UMBRELLA { 
    name: "Shadow Temple Stone Umbrella" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_LOWER_HUGE_PIT:       trick(RT_VISIBLE_COLLISION)
        RR_SHADOW_TEMPLE_STONE_UMBRELLA_UPPER: trick(RT_SHADOW_UMBRELLA_CLIP) or (trick(RT_DAMAGE_BOOST_SIMPLE) and take_damage(DAMAGE_NO_FAIRY)) or (is_adult() and ((trick(RT_SHADOW_UMBRELLA_HOVER) and can_use(RG_HOVER_BOOTS)) or has(RG_GORONS_BRACELET)))
    }
}

region RR_SHADOW_TEMPLE_STONE_UMBRELLA_UPPER { 
    name: "Shadow Temple Stone Umbrella Upper"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_STONE_UMBRELLA: always
    }
}

region RR_SHADOW_TEMPLE_LOWER_HUGE_PIT_DOOR_LEDGE { 
    name: "Shadow Temple Lower Huge Pit Door Ledge" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_LOWER_HUGE_PIT:      (trick(RT_LENS_SHADOW_PLATFORM) and trick(RT_LENS_SHADOW)) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_S_DOOR: small_keys(SCENE_SHADOW_TEMPLE, 2)
    }
}

region RR_SHADOW_TEMPLE_INVISIBLE_SPINNING_BLADES { 
    name: "Shadow Temple Invisible Spinning Blades" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_UPPER_HUGE_PIT_DOOR_LEDGE: always
    }
}

region RR_SHADOW_TEMPLE_FLOOR_SPIKES_S_DOOR {
    name: "Shadow Temple Floor Spikes South Door"
    scene: SCENE_SHADOW_TEMPLE

    exits {
        RR_SHADOW_TEMPLE_LOWER_HUGE_PIT_DOOR_LEDGE: small_keys(SCENE_SHADOW_TEMPLE, 2)
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_ROOM:         trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_HOVER_BOOTS) or can_use(RG_GORON_TUNIC) or take_damage()
    }
}

# Assumes logic for navigating around spikes is checked on entry
region RR_SHADOW_TEMPLE_FLOOR_SPIKES_ROOM {
    name: "Shadow Temple Floor Spikes Room"
    scene: SCENE_SHADOW_TEMPLE

    events {
        # we always need lens logic due to the invisible objects
        LOGIC_SHADOW_SILVER_SPIKES: (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and
                                    # either we get everything with hookshot, or we use a midair ground jump as adult to get on top of the corner platform twice and..
                                    (can_use(RG_HOOKSHOT) or (is_adult() and can_midair_ground_jump() and
                                    # grab the rupees near the targets with either bunnyhovers and jumpslash, hammer recoils, bomb recoils or megajumps with either bunny or jumpslash
                                    ((bunny_hovers() and can_jumpslash()) or can_melee_recoil_hover(RECOIL_HAMMER) or
                                    # if we use damage boosts, we have to do it twice.
                                    ((can_bomb_recoil_hover() or can_megajump(not can_jumpslash())) and effective_health() > 16))))
    }

    exits {
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_S_DOOR:    always
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_W_DOOR:    always
        RR_SHADOW_TEMPLE_SPIKES_CORNER_PLATFORM: (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and ((is_adult() and can_midair_ground_jump()) or can_use(RG_HOOKSHOT))
        RR_SHADOW_TEMPLE_SPIKES_DOOR_PLATFORM:   (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and ((is_adult() and can_midair_ground_jump()) or
                                                 can_use((is_adult() and any_age(can_kill(RE_REDEAD))) ? RG_HOOKSHOT : RG_LONGSHOT))
    }
}

region RR_SHADOW_TEMPLE_FLOOR_SPIKES_W_DOOR {
    name: "Shadow Temple Floor Spikes West Door"
    scene: SCENE_SHADOW_TEMPLE

    exits {
        RR_SHADOW_TEMPLE_SKULL_JAR:         has(RG_SHADOW_SILVER_SPIKES)
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_ROOM: trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_HOVER_BOOTS) or can_use(RG_GORON_TUNIC) or take_damage()
    }
}

region RR_SHADOW_TEMPLE_SPIKES_CORNER_PLATFORM {
    name: "Shadow Temple Spikes Corner Platform"
    scene: SCENE_SHADOW_TEMPLE

    exits {
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_ROOM:    trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_HOVER_BOOTS) or can_use(RG_GORON_TUNIC) or take_damage()
        RR_SHADOW_TEMPLE_SPIKES_DOOR_PLATFORM: can_megajump() or can_recoil_hover(RECOIL_SWORD_AND_SHIELD)
    }
}

region RR_SHADOW_TEMPLE_SPIKES_DOOR_PLATFORM {
    name: "Shadow Temple Spikes Door Platform"
    scene: SCENE_SHADOW_TEMPLE

    exits {
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_ROOM:      trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_HOVER_BOOTS) or can_use(RG_GORON_TUNIC) or take_damage()
        RR_SHADOW_TEMPLE_SPIKES_CORNER_PLATFORM: (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and
                                                 (can_use(RG_HOVER_BOOTS) or can_megajump())
        RR_SHADOW_TEMPLE_UPPER_WIND_TUNNEL:      small_keys(SCENE_SHADOW_TEMPLE, 3)
    }
}

region RR_SHADOW_TEMPLE_SKULL_JAR { 
    name: "Shadow Temple Skull Jar"
    scene: SCENE_SHADOW_TEMPLE
    
    locations {
        RC_SHADOW_TEMPLE_FREESTANDING_KEY:    can_use(RG_BOMB_BAG) or has(RG_GORONS_BRACELET) or (trick(RT_SHADOW_FREESTANDING_KEY) and can_use(RG_BOMBCHU_5))
    }
    
    exits {
        RR_SHADOW_TEMPLE_FLOOR_SPIKES_W_DOOR: any_age(can_kill(RE_KEESE))
    }
}

region RR_SHADOW_TEMPLE_UPPER_WIND_TUNNEL { 
    name: "Shadow Temple Upper Wind Tunnel"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_SPIKES_DOOR_PLATFORM: small_keys(SCENE_SHADOW_TEMPLE, 3)
        RR_SHADOW_TEMPLE_LOWER_WIND_TUNNEL:    can_use(RG_HOOKSHOT) or ((can_use(RG_HOVER_BOOTS) or bunny_hood()) and can_pass(RE_BIG_SKULLTULA))
    }
}

region RR_SHADOW_TEMPLE_LOWER_WIND_TUNNEL { 
    name: "Shadow Temple Lower Wind Tunnel"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_UPPER_WIND_TUNNEL:     can_use(RG_HOOKSHOT)
        RR_SHADOW_TEMPLE_WIND_TUNNEL_ALCOVE:    trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)
        RR_SHADOW_TEMPLE_WIND_TUNNEL_HINT_ROOM: always
    }
}

region RR_SHADOW_TEMPLE_WIND_TUNNEL_ALCOVE { 
    name: "Shadow Temple Wind Tunnel Alcove"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_LOWER_WIND_TUNNEL: (trick(RT_SHADOW_MQ_WINDY_WALKWAY)) or can_use(RG_HOVER_BOOTS) or bunny_hood()
        RR_SHADOW_TEMPLE_ROOM_TO_BOAT:      always
    }
}

region RR_SHADOW_TEMPLE_WIND_TUNNEL_HINT_ROOM { 
    name: "Shadow Temple Wind Tunnel Hint Room"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_LOWER_WIND_TUNNEL: can_kill(RE_REDEAD)
    }
}

region RR_SHADOW_TEMPLE_ROOM_TO_BOAT { 
    name: "Shadow Temple Room to Boat" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_WIND_TUNNEL_ALCOVE: any_age(can_kill(RE_GIBDO, ED_CLOSE, true, 2))
        RR_SHADOW_TEMPLE_DOCK:               small_keys(SCENE_SHADOW_TEMPLE, 4)
    }
}

region RR_SHADOW_TEMPLE_DOCK { 
    name: "Shadow Temple Dock"
    scene: SCENE_SHADOW_TEMPLE
    
    events {
        LOGIC_SHADOW_SHORTCUT_BLOCK: has(RG_GORONS_BRACELET)
    }
    
    exits {
        RR_SHADOW_TEMPLE_ROOM_TO_BOAT:    small_keys(SCENE_SHADOW_TEMPLE, 4)
        RR_SHADOW_TEMPLE_SPINNING_BLADES: flag(LOGIC_SHADOW_SHORTCUT_BLOCK) and has(RG_CLIMB)
        RR_SHADOW_TEMPLE_BEYOND_BOAT:     ((is_adult() and ((has(RG_GORONS_BRACELET) and has(RG_CLIMB)) or trick(RT_UNINTUITIVE_JUMPS))) or (trick(RT_HOOKSHOT_LADDERS) and can_use(RG_HOOKSHOT))) and can_use(RG_ZELDAS_LULLABY)
    }
}

region RR_SHADOW_TEMPLE_BEYOND_BOAT { 
    name: "Shadow Temple Beyond Boat"
    scene: SCENE_SHADOW_TEMPLE 
    
    events {
        LOGIC_SHADOW_BRIDGE_BEYOND_BOAT_LOWERED: can_use(RG_FAIRY_BOW) or (trick(RT_SHADOW_STATUE) and can_use(RG_BOMBCHU_5))
    }
    
    exits {
        RR_SHADOW_TEMPLE_MAZE:            always
        RR_SHADOW_TEMPLE_CHASM_SCARECROW: reach_distant_scarecrow()
        # a less precise recoil off the broken statue into a jumpslash works.
        RR_SHADOW_TEMPLE_ACROSS_CHASM:    flag(LOGIC_SHADOW_BRIDGE_BEYOND_BOAT_LOWERED) or can_melee_recoil_hover(RECOIL_HAMMER_AND_SHIELD) or can_bunny_mega_jumpslash()
    }
}

region RR_SHADOW_TEMPLE_CHASM_SCARECROW { 
    name: "Shadow Temple Chasm Scarecrow"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_BEYOND_BOAT:   can_megajump(not can_jumpslash()) or can_recoil_hover(RECOIL_HAMMER)
        RR_SHADOW_TEMPLE_ACROSS_CHASM:  always
        RR_SHADOW_TEMPLE_BROKEN_PILLAR: can_use(RG_HOVER_BOOTS) or (bunny_hood() and can_jumpslash()) or (is_adult() and ((trick(RT_UNINTUITIVE_JUMPS) and can_jumpslash()) or bunny_hood()))
    }
}

region RR_SHADOW_TEMPLE_ACROSS_CHASM { 
    name: "Shadow Temple Across Chasm"
    scene: SCENE_SHADOW_TEMPLE
    
    events {
        LOGIC_SHADOW_BRIDGE_BEYOND_BOAT_LOWERED: can_detonate_upright_bomb_flower()
    }
    
    exits  {
        # child can use the statue with hovers, but needs to run around the side so it's unintuitive
        RR_SHADOW_TEMPLE_BEYOND_BOAT:   (flag(LOGIC_SHADOW_BRIDGE_BEYOND_BOAT_LOWERED) and (is_adult() or (trick(RT_SHADOW_BUNNY_STATUE) and bunny_hood() and can_jumpslash()))) or
                                        can_melee_recoil_hover(RECOIL_HAMMER)
        RR_SHADOW_TEMPLE_BROKEN_PILLAR: is_adult() and can_use(RG_SONG_OF_TIME)
        RR_SHADOW_TEMPLE_PRE_BOSS_ROOM: small_keys(SCENE_SHADOW_TEMPLE, 5)
    }
}

region RR_SHADOW_TEMPLE_BROKEN_PILLAR { 
    name: "Shadow Temple Broken Pillar"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_ACROSS_CHASM:    always
        RR_SHADOW_TEMPLE_CHASM_SCARECROW: is_adult() ? reach_scarecrow() : reach_distant_scarecrow()
    }
}

region RR_SHADOW_TEMPLE_MAZE { 
    name: "Shadow Temple Maze"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_BEYOND_BOAT:      always
        RR_SHADOW_TEMPLE_X_CROSS:          always
        RR_SHADOW_TEMPLE_THREE_SKULL_JARS: always
        RR_SHADOW_TEMPLE_WOODEN_SPIKES:    always
    }
}

region RR_SHADOW_TEMPLE_X_CROSS { 
    name: "Shadow Temple X-Cross"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_MAZE: any_age((trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and can_kill(RE_FLOORMASTER))
    }
}

region RR_SHADOW_TEMPLE_THREE_SKULL_JARS { 
    name: "Shadow Temple Three Skull Jars"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_MAZE: always
    }
}

region RR_SHADOW_TEMPLE_WOODEN_SPIKES { 
    name: "Shadow Temple Wooden Spikes" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_MAZE: always
    }
}

region RR_SHADOW_TEMPLE_PRE_BOSS_ROOM { 
    name: "Shadow Temple Pre Boss Room" 
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        RR_SHADOW_TEMPLE_ACROSS_CHASM: small_keys(SCENE_SHADOW_TEMPLE, 5)
        RR_SHADOW_TEMPLE_BOSS_DOOR:    (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and (can_use(RG_HOVER_BOOTS) or (bunny_hood() and is_adult()))
    }
}

region RR_SHADOW_TEMPLE_BOSS_DOOR { 
    name: "Shadow Temple Boss Door"
    scene: SCENE_SHADOW_TEMPLE
    
    exits {
        # child can make this jump with bunny, and it's not hard, but it's too inconsistent for unintuitive
        RR_SHADOW_TEMPLE_PRE_BOSS_ROOM: (trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH)) and
                                        (can_use(RG_HOVER_BOOTS) or (bunny_hood() and is_adult()))
        RR_SHADOW_TEMPLE_BOSS_ENTRYWAY: always
    }
}