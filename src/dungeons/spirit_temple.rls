    name: "Spirit Temple Boss Entryway"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_STATUE_HEAD: never#TODO
        RR_SPIRIT_TEMPLE_MQ_STATUE_HEAD: never#TODO
        RR_SPIRIT_TEMPLE_BOSS_ROOM: never#TODO
