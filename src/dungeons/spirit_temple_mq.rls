region RR_SPIRIT_TEMPLE_MQ_FOYER {
    name: "Spirit Temple MQ Lobby"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # WARNING these events assume you need less or equal keys for forwards entry and reverse
        LOGIC_FORWARDS_SPIRIT_CHILD: is_child()
        LOGIC_FORWARDS_SPIRIT_ADULT: is_adult()
    }

    exits {
        RR_SPIRIT_TEMPLE_ENTRYWAY:           always
        RR_SPIRIT_TEMPLE_MQ_CHILD_SIDE_HUB:  (is_adult() or has(RG_SPEAK_GERUDO) or flag(LOGIC_SPIRIT_NABOORU_KIDNAPPED)) and can_use(RG_CRAWL)
        RR_SPIRIT_TEMPLE_MQ_BEHIND_GEYSER:   trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_HOVER_BOOTS) and (can_use(RG_MEGATON_HAMMER) or (can_standing_shield() and (can_use_sword() or can_use(RG_STICKS))))
        RR_SPIRIT_TEMPLE_MQ_BIG_BLOCKS_HOLE: can_use(RG_LONGSHOT) and can_use(RG_BOMBCHU_5)
    }
}

region RR_SPIRIT_TEMPLE_MQ_CHILD_SIDE_HUB {
    name: "Spirit Temple MQ Child Side Hub"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # not technically a rusted switch, but a boulder through a wall, but is part of the same trick on N64
        LOGIC_SPIRIT_MQ_CRAWL_BOULDER: can_use(RG_BOMBCHU_5) or (trick(RT_VISIBLE_COLLISION) and can_use(RG_MEGATON_HAMMER))
    }

    exits {
        # Nabooru's legs are technically visible one way collision here, but I'm not sure if this counts
        RR_SPIRIT_TEMPLE_MQ_FOYER:               can_use(RG_CRAWL)
        RR_SPIRIT_TEMPLE_MQ_GIBDO_GRAVES:        any_age(can_kill(RE_TORCH_SLUG))
        RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_CHEST: any_age(can_kill(RE_TORCH_SLUG))
        RR_SPIRIT_TEMPLE_MQ_1F_CHEST_SWITCH:     can_use(RG_CRAWL) and flag(LOGIC_SPIRIT_MQ_CRAWL_BOULDER)
    }
}

region RR_SPIRIT_TEMPLE_MQ_GIBDO_GRAVES {
    name: "Spirit Temple MQ Gibdo Graves"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_MQ_GIBDOS_CLEARED: has(RG_POWER_BRACELET) and
                                        ((can_use(RG_BOMBCHU_5) and can_hit_eye_targets()) or can_use(RG_HOVER_BOOTS)) and
                                        can_kill(RE_GIBDO, ED_CLOSE, true, 3)
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_CHILD_SIDE_HUB: always
        RR_SPIRIT_TEMPLE_MQ_GIBDO_POTS:     has(RG_POWER_BRACELET) and
                                            (can_use(RG_BOMBCHU_5) and can_hit_eye_targets()) or
                                            can_use(RG_HOVER_BOOTS)
    }
}

region RR_SPIRIT_TEMPLE_MQ_GIBDO_POTS {
    name: "Spirit Temple MQ Gibdo Pots"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_TURNTABLE: flag(LOGIC_SPIRIT_MQ_GIBDOS_CLEARED)
    }
}

region RR_SPIRIT_TEMPLE_MQ_TURNTABLE {
    name: "Spirit Temple MQ Turntable"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_MQ_TURNTABLE_ENEMY: can_kill(RE_STALFOS)
        LOGIC_FAIRY_ACCESS:              flag(LOGIC_SPIRIT_MQ_TURNTABLE_ENEMY)
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_GIBDO_POTS:            always
        RR_SPIRIT_TEMPLE_MQ_TURNTABLE_BEHIND_FIRE: flag(LOGIC_SPIRIT_MQ_TURNTABLE_ENEMY)
    }
}

region RR_SPIRIT_TEMPLE_MQ_TURNTABLE_BEHIND_FIRE {
    name: "Spirit Temple MQ Turntable Behind Fire"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_TURNTABLE:           flag(LOGIC_SPIRIT_MQ_TURNTABLE_ENEMY)
        RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_GRAVE: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_GRAVE {
    name: "Spirit Temple MQ Anubis Bridge Grave"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_MQ_MAP_ROOM_ENEMIES: (can_kill(RE_ANUBIS) and can_kill(RE_KEESE)) and
                                          (has(RG_POWER_BRACELET) or can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT)) or
                                          (can_kill(RE_ANUBIS, ED_BOOMERANG) and can_kill(RE_KEESE, ED_FAR))
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_TURNTABLE:           always
        RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_CHEST: has(RG_POWER_BRACELET) or can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT)
    }
}

region RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_CHEST {
    name: "Spirit Temple MQ Anubis Bridge Chest"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # You can lure the keese over by aggroing them with dins if you use it as close to the torch keese as possible, but it's a trick as it's not intuitive and basically never comes up
        LOGIC_SPIRIT_MQ_MAP_ROOM_ENEMIES: can_kill(RE_ANUBIS) and can_kill(RE_KEESE, ED_BOOMERANG)
    }

    exits {
        # The bridge is a temp flag, so not a way to cross south to north in logic
        RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_GRAVE: can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)
        RR_SPIRIT_TEMPLE_MQ_CHILD_SIDE_HUB:      always
    }
}

region RR_SPIRIT_TEMPLE_MQ_1F_CHEST_SWITCH {
    name: "Spirit Temple MQ West 1F Rusted Switch"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_MQ_TIME_TRAVEL_CHEST: can_use(RG_MEGATON_HAMMER) and has(RG_OPEN_CHEST)
        LOGIC_SPIRIT_MQ_CRAWL_BOULDER:     can_use(RG_BOMBCHU_5) or (trick(RT_VISIBLE_COLLISION) and can_use(RG_MEGATON_HAMMER))
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_CHILD_SIDE_HUB:  can_use(RG_CRAWL) and flag(LOGIC_SPIRIT_MQ_CRAWL_BOULDER)
        # This tracks possible child access, if adult has not entered STATUE_ROOM. Certain Child Access is checked for separately as 7 Keys
        RR_SPIRIT_TEMPLE_MQ_UNDER_LIKE_LIKE: small_keys(SCENE_SPIRIT_TEMPLE, 1)
    }
}

region RR_SPIRIT_TEMPLE_MQ_UNDER_LIKE_LIKE {
    name: "Spirit Temple MQ Under Like Like"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        # This covers adult and reverse access only, as child going forwards arrives here from the other side of this door
        RR_SPIRIT_TEMPLE_MQ_1F_CHEST_SWITCH: small_keys(SCENE_SPIRIT_TEMPLE, 7)
        RR_SPIRIT_TEMPLE_MQ_SUN_ON_FLOOR:    can_hit_switch() and (has(RG_CLIMB) or can_use(RG_LONGSHOT))
    }
}

region RR_SPIRIT_TEMPLE_MQ_SUN_ON_FLOOR {
    name: "Spirit Temple MQ Sun on Floor Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_UNDER_LIKE_LIKE:   can_hit_switch()
        # This exit only governs child forwards access, adult and reverse access starts on the other side so never checks this
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_CHILD: small_keys(SCENE_SPIRIT_TEMPLE, 2)
    }
}

region RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_CHILD {
    name: "Spirit Temple MQ Statue Room Child"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        # !QUANTUM LOGIC!
        # If we entered in reverse and dungeon entrances are off, we only need 6 keys, access to Gauntlets Hand, and the ability to
        # crawl through the boulder filled tunnel to reach colossus.
        # This is because with 6 keys it becomes impossible to avoid opening either the west hand lock or the first child side lock
        # and either direction lets child reach colossus. CanHitSwitch and CanKillEnemy(RE_IRON_KNUCKLE) is implied.
        # Logic can then allow child back into spirit, putting 1F west in logic with only 6 keys without forwards entry
        RR_DESERT_COLOSSUS:                      can_use(RG_CRAWL) and setting(RSK_SHUFFLE_DUNGEON_ENTRANCES) is RO_DUNGEON_ENTRANCE_SHUFFLE_OFF and
                                                 small_keys(SCENE_SPIRIT_TEMPLE, 6) and mq_spirit_statue_to_sun_block() and
                                                 (can_use(RG_BOMBCHU_5) or (trick(RT_VISIBLE_COLLISION) and any_age(can_use(RG_MEGATON_HAMMER))))
        RR_SPIRIT_TEMPLE_MQ_SUN_ON_FLOOR:        small_keys(SCENE_SPIRIT_TEMPLE, 6)
        RR_SPIRIT_TEMPLE_MQ_POT_LEDGE:           can_use(RG_HOVER_BOOTS) or can_use(RG_SONG_OF_TIME)
        RR_SPIRIT_TEMPLE_MQ_INNER_RIGHT_HAND:    is_adult() or can_jumpslash() or can_use(RG_HOVER_BOOTS)
        RR_SPIRIT_TEMPLE_MQ_FLAMETHROWER_STAIRS: mq_spirit_statue_to_sun_block()
        # explicit adult check here is a precaution against possible child logic leaking, child with a hookshot can do this
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT:   is_adult() and can_use(RG_HOOKSHOT)
    }
}

region RR_SPIRIT_TEMPLE_MQ_POT_LEDGE {
    name: "Spirit Temple MQ Pot Ledge"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # This event does not need handling in SpiritShared as it only affects navigation, adult access here is always Certain, and Child has no way through that Adult does not.
        LOGIC_SPIRIT_STATUE_SOUTH_DOOR: trick(RT_SPIRIT_MQ_FROZEN_EYE) and can_use(RG_FAIRY_BOW) and can_use(RG_SONG_OF_TIME)
    }

    exits {
        # This is pretty tight to reach the SoT block, but you can just go via the hand...
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_CHILD: always
        RR_SPIRIT_TEMPLE_MQ_INNER_RIGHT_HAND:  always
    }
}

region RR_SPIRIT_TEMPLE_MQ_INNER_RIGHT_HAND {
    name: "Spirit Temple MQ Inner Right Hand"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        # Land on the SoT block
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_CHILD: always
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM:       always
        RR_SPIRIT_TEMPLE_MQ_POT_LEDGE:         is_adult() and trick(RT_SPIRIT_STATUE_JUMP)
        RR_SPIRIT_TEMPLE_MQ_PLATFORM:          flag(LOGIC_SPIRIT_PLATFORM_LOWERED) and
                                               (can_use(RG_LONGSHOT) or (trick(RT_SPIRIT_PLATFORM_HOOKSHOT) and can_use(RG_HOOKSHOT)))
    }
}

region RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM {
    name: "Spirit Temple MQ Statue Room"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # This event does not need handling in SpiritShared as it only affects navigation, Adult access here is always Certain, and Child has no way through that adult does not.
        LOGIC_SPIRIT_STATUE_SOUTH_DOOR:      has_fire_source()
        # Assuming all higher areas filter down to here for this despite there being many good angles to use FAs
        LOGIC_SPIRIT_MQ_STATUE_ROOM_TORCHES: can_use(RG_FIRE_ARROWS) or (trick(RT_SPIRIT_MQ_LOWER_ADULT) and can_use(RG_DINS_FIRE))
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_CHILD: has(RG_CLIMB) or can_use(RG_HOOKSHOT)
        RR_SPIRIT_TEMPLE_MQ_BIG_BLOCKS_DOOR:   flag(LOGIC_SPIRIT_STATUE_SOUTH_DOOR)
        # explicit adult check here is a precaution against possible Child logic leaking, Child with a hookshot can do this
        # It's possible to climb the legs of the statue to line up a longshot hit, but you can just go via West
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT: is_adult() and reach_scarecrow()
    }
}

region RR_SPIRIT_TEMPLE_MQ_FLAMETHROWER_STAIRS {
    name: "Spirit Temple MQ Flamethrower Stairs"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM:    always
        RR_SPIRIT_TEMPLE_MQ_SUN_BLOCK_ROOM: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_SUN_BLOCK_ROOM {
    name: "Spirit Temple MQ Sun Block Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_FLAMETHROWER_STAIRS: has(RG_POWER_BRACELET) or sunlight_arrows()
        RR_SPIRIT_TEMPLE_MQ_SKULLTULA_STAIRS:    has(RG_POWER_BRACELET) or sunlight_arrows()
    }
}

region RR_SPIRIT_TEMPLE_MQ_SKULLTULA_STAIRS {
    name: "Spirit Temple MQ Skulltula Stairs"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_SUN_BLOCK_ROOM: always
        RR_SPIRIT_TEMPLE_MQ_CHILD_THRONE:   small_keys(SCENE_SPIRIT_TEMPLE, 4)
    }
}

region RR_SPIRIT_TEMPLE_MQ_CHILD_THRONE {
    name: "Spirit Temple MQ Child Throne"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_SKULLTULA_STAIRS: small_keys(SCENE_SPIRIT_TEMPLE, 7)
        RR_SPIRIT_TEMPLE_MQ_RIGHT_HAND_EXIT:  any_age(can_kill(RE_IRON_KNUCKLE))
    }
}

region RR_SPIRIT_TEMPLE_MQ_RIGHT_HAND_EXIT {
    name: "Spirit Temple MQ Right Hand Exit"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_CHILD_THRONE:     always
        RR_SPIRIT_TEMPLE_MQ_OUTER_RIGHT_HAND: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_OUTER_RIGHT_HAND {
    name: "Spirit Temple MQ Outer Right Hand"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_NABOORU_KIDNAPPED: spirit_shared(RR_SPIRIT_TEMPLE_MQ_OUTER_RIGHT_HAND, has(RG_OPEN_CHEST))
    }

    exits {
        # If it is ever relevent for 1 age to spawn the mirror shield chest for the other can longshot across, it needs an eventAccess
        RR_SPIRIT_TEMPLE_MQ_RIGHT_HAND_EXIT: always
        RR_DESERT_COLOSSUS:                  spirit_certain_access(RR_SPIRIT_TEMPLE_MQ_OUTER_RIGHT_HAND)
    }
}

region RR_SPIRIT_TEMPLE_MQ_BIG_BLOCKS_HOLE {
    name: "Spirit Temple MQ Big Blocks Hole"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_FOYER:           always
        # The block here is unusual in that it is a permanent flag, but reset anyway as child. This is because there's a check that would be blocked off by pushing them otherwise
        # It may be worth considering making this always temp in future so adult doesn't have the same issue
        RR_SPIRIT_TEMPLE_MQ_BIG_BLOCKS_DOOR: is_child() ? can_use(RG_SILVER_GAUNTLETS) : any_age(can_use(RG_SILVER_GAUNTLETS))
    }
}

region RR_SPIRIT_TEMPLE_MQ_BIG_BLOCKS_DOOR {
    name: "Spirit Temple MQ Big Blocks Door"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        # if going to RR_SPIRIT_TEMPLE_MQ_BIG_BLOCKS_HOLE from here is ever relevant, there needs to be an event to handle the block
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT {
    name: "Spirit Temple MQ Statue Room Adult"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM:            always
        RR_SPIRIT_TEMPLE_MQ_INNER_LEFT_HAND:        is_adult() or can_jumpslash() or can_use(RG_HOVER_BOOTS)
        RR_SPIRIT_TEMPLE_MQ_CHEST_LEDGE:            can_use(RG_HOVER_BOOTS) or
                                                    ((trick(RT_LENS_SPIRIT_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_LONGSHOT))
        RR_SPIRIT_TEMPLE_MQ_3_SUNS_ROOM_2F:         flag(LOGIC_SPIRIT_MQ_STATUE_ROOM_TORCHES)
        RR_DESERT_COLOSSUS:                         small_keys(SCENE_SPIRIT_TEMPLE, 4) and mq_spirit_4_key_colossus()
        RR_SPIRIT_TEMPLE_MQ_OUTER_RIGHT_HAND:       small_keys(SCENE_SPIRIT_TEMPLE, 4) and mq_spirit_4_key_west_hand()
        RR_SPIRIT_TEMPLE_MQ_FIRE_WALL_STAIRS_LOWER: small_keys(SCENE_SPIRIT_TEMPLE, 5)
        RR_SPIRIT_TEMPLE_MQ_PLATFORM:               flag(LOGIC_SPIRIT_PLATFORM_LOWERED) and
                                                    (can_use(RG_LONGSHOT) or (trick(RT_SPIRIT_PLATFORM_HOOKSHOT) and can_use(RG_HOOKSHOT)))
    }
}

region RR_SPIRIT_TEMPLE_MQ_INNER_LEFT_HAND {
    name: "Spirit Temple MQ Inner East Hand"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM:       always
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT: can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT)
        RR_SPIRIT_TEMPLE_MQ_CHEST_LEDGE:       ((is_adult() or trick(RT_SPIRIT_WEST_LEDGE)) and (trick(RT_LENS_SPIRIT_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_HOOKSHOT)) or
                                               (is_adult() and trick(RT_SPIRIT_STATUE_JUMP))
    }
}

region RR_SPIRIT_TEMPLE_MQ_CHEST_LEDGE {
    name: "Spirit Temple MQ Chest Ledge"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM:       always
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT: can_use(RG_HOVER_BOOTS) or can_use(RG_LONGSHOT)
        RR_SPIRIT_TEMPLE_MQ_INNER_LEFT_HAND:   always
    }
}

region RR_SPIRIT_TEMPLE_MQ_3_SUNS_ROOM_2F {
    name: "Spirit Temple MQ Three Suns Room 2F"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # implies can_kill(RE_WALLMASTER). If we have lights, we can kill stalfos and wallmasters with bow
        LOGIC_SPIRIT_MQ_3SUNS_ENEMIES: (can_use(RG_MIRROR_SHIELD) and can_kill(RE_STALFOS, ED_CLOSE, true, 2)) or sunlight_arrows()
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT: always
        RR_SPIRIT_TEMPLE_MQ_3_SUNS_ROOM_1F:    flag(LOGIC_SPIRIT_MQ_3SUNS_ENEMIES)
    }
}

region RR_SPIRIT_TEMPLE_MQ_3_SUNS_ROOM_1F {
    name: "Spirit Temple MQ 3 Suns Room 1F"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        # It is possible to clip through here with longshot by aiming high enough
        RR_SPIRIT_TEMPLE_MQ_3_SUNS_ROOM_2F: flag(LOGIC_SPIRIT_MQ_3SUNS_ENEMIES) and (has(RG_CLIMB) or can_use(RG_LONGSHOT))
        RR_SPIRIT_TEMPLE_MQ_BEHIND_GEYSER:  always
    }
}

region RR_SPIRIT_TEMPLE_MQ_BEHIND_GEYSER {
    name: "Spirit Temple MQ 1F East"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # Assumes RR_SPIRIT_TEMPLE_MQ_FOYER access
        LOGIC_SPIRIT_1F_SILVER_RUPEES: can_use(RG_MEGATON_HAMMER)
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_FOYER:               can_use(RG_MEGATON_HAMMER) or (trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_HOVER_BOOTS) and can_standing_shield() and (can_use_sword() or can_use(RG_STICKS)))
        RR_SPIRIT_TEMPLE_MQ_3_SUNS_ROOM_1F:      always
        RR_SPIRIT_TEMPLE_MQ_SAND_PIT:            always
        RR_SPIRIT_TEMPLE_MQ_SYMPHONY_ROOM_UPPER: small_keys(SCENE_SPIRIT_TEMPLE, 7)
    }
}

region RR_SPIRIT_TEMPLE_MQ_SAND_PIT {
    name: "Spirit Temple MQ Sand Pit"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_BEHIND_GEYSER: can_use(RG_ZELDAS_LULLABY)
    }
}

region RR_SPIRIT_TEMPLE_MQ_SYMPHONY_ROOM_UPPER {
    name: "Spirit Temple MQ Symphony Room Upper"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_MQ_SYMPHONY_ROOM_DOOR: can_use(RG_MEGATON_HAMMER) and can_use(RG_SONG_OF_TIME) and can_use(RG_EPONAS_SONG) and
                                            can_use(RG_SUNS_SONG) and can_use(RG_SONG_OF_STORMS) and can_use(RG_ZELDAS_LULLABY)
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_BEHIND_GEYSER:       small_keys(SCENE_SPIRIT_TEMPLE, 7)
        # implies can_pass(RE_MOBLIN_CHIEF)
        RR_SPIRIT_TEMPLE_MQ_SYMPHONY_ROOM_LOWER: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_SYMPHONY_ROOM_LOWER {
    name: "Spirit Temple MQ Symphony Room Lower"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_SYMPHONY_ROOM_UPPER: is_adult() or has(RG_CLIMB) or can_use(RG_HOOKSHOT) or can_ground_jump()
        # implies can_pass(RE_MOBLIN_CHIEF)
        RR_SPIRIT_TEMPLE_MQ_SKULLTULA_ROOM:      flag(LOGIC_SPIRIT_MQ_SYMPHONY_ROOM_DOOR)
    }
}

region RR_SPIRIT_TEMPLE_MQ_SKULLTULA_ROOM {
    name: "Spirit Temple MQ Skulltula Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_SYMPHONY_ROOM_LOWER: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_FIRE_WALL_STAIRS_LOWER {
    name: "Spirit Temple MQ Fire Wall Stairs Lower"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT:      small_keys(SCENE_SPIRIT_TEMPLE, 5)
        RR_SPIRIT_TEMPLE_MQ_FIRE_WALL_STAIRS_UPPER: can_use(RG_HOOKSHOT) or (trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_HOVER_BOOTS) and can_use(RG_MEGATON_HAMMER))
    }
}

region RR_SPIRIT_TEMPLE_MQ_FIRE_WALL_STAIRS_UPPER {
    name: "Spirit Temple MQ Fire Wall Stairs Upper"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_FIRE_WALL_STAIRS_LOWER: can_use(RG_HOOKSHOT) or (trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_HOVER_BOOTS) and can_use(RG_MEGATON_HAMMER))
        RR_SPIRIT_TEMPLE_MQ_BEAMOS_PITS:            always
    }
}

region RR_SPIRIT_TEMPLE_MQ_BEAMOS_PITS {
    name: "Spirit Temple MQ Beamos Pits"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_FIRE_WALL_STAIRS_UPPER: can_avoid(RE_BEAMOS, true, 4) and can_use(RG_SONG_OF_TIME) and has(RG_POWER_BRACELET)
        RR_SPIRIT_TEMPLE_MQ_SOT_SUN_ROOM:           can_avoid(RE_BEAMOS, true, 4) and can_use(RG_SONG_OF_TIME) and has(RG_POWER_BRACELET)
        RR_SPIRIT_TEMPLE_MQ_BIG_WALL_BASE:          small_keys(SCENE_SPIRIT_TEMPLE, 6)
    }
}

region RR_SPIRIT_TEMPLE_MQ_SOT_SUN_ROOM {
    name: "Spirit Temple MQ SoT Sun Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_BEAMOS_PITS:        always
        RR_SPIRIT_TEMPLE_MQ_FLOORMASTER_STAIRS: can_jumpslash()
        RR_SPIRIT_TEMPLE_MQ_3F_GIBDO_ROOM:      any_age(((is_adult() or can_use(RG_SONG_OF_TIME)) and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows())
    }
}

region RR_SPIRIT_TEMPLE_MQ_FLOORMASTER_STAIRS {
    name: "Spirit Temple MQ Floormaster Stairs"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_SOT_SUN_ROOM: always
        RR_SPIRIT_TEMPLE_MQ_ADULT_THRONE: (trick(RT_LENS_SPIRIT_MQ) or can_use(RG_LENS_OF_TRUTH)) and any_age(can_kill(RE_FLOORMASTER))
    }
}

region RR_SPIRIT_TEMPLE_MQ_ADULT_THRONE {
    name: "Spirit Temple MQ Adult Throne"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_FLOORMASTER_STAIRS: always
        RR_SPIRIT_TEMPLE_MQ_LEFT_HAND_EXIT:     any_age(can_kill(RE_IRON_KNUCKLE))
    }
}

region RR_SPIRIT_TEMPLE_MQ_LEFT_HAND_EXIT {
    name: "Spirit Temple MQ Left Hand Exit"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_ADULT_THRONE:    always
        RR_SPIRIT_TEMPLE_MQ_OUTER_LEFT_HAND: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_OUTER_LEFT_HAND {
    name: "Spirit Temple MQ Outer Left Hand"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_OUTER_RIGHT_HAND: can_use(RG_LONGSHOT)
        RR_SPIRIT_TEMPLE_MQ_ADULT_THRONE:     always
        RR_DESERT_COLOSSUS:                   always
    }
}

region RR_SPIRIT_TEMPLE_MQ_3F_GIBDO_ROOM {
    name: "Spirit Temple MQ 3F Gibdo Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_SOT_SUN_ROOM: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_BIG_WALL_BASE {
    name: "Spirit Temple MQ Big Wall Base"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_BEAMOS_PITS:    always
        # technically we only need to avoid them, but the sheer height and the moving walls makes getting to the top after only stunning them very difficult/impossible
        RR_SPIRIT_TEMPLE_MQ_BIG_WALL_UPPER: (can_kill(RE_KEESE) or can_use(RG_SKULL_MASK)) and (has(RG_CLIMB) or can_use(RG_LONGSHOT))
    }
}

region RR_SPIRIT_TEMPLE_MQ_BIG_WALL_UPPER {
    name: "Spirit Temple MQ Big Wall Upper"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # Getting some of these with just climbing downwards is theoretically possible but definitely a trick
        LOGIC_SPIRIT_MQ_BIG_WALL_SILVERS: (can_kill(RE_KEESE) or can_use(RG_SKULL_MASK)) and (has(RG_CLIMB) or can_use(RG_LONGSHOT))
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_BIG_WALL_BASE: always
        RR_SPIRIT_TEMPLE_MQ_4F_CENTRAL:    flag(LOGIC_SPIRIT_MQ_BIG_WALL_SILVERS)
    }
}

region RR_SPIRIT_TEMPLE_MQ_4F_CENTRAL {
    name: "Spirit Temple MQ 4F Central"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_BIG_WALL_UPPER:  always
        RR_SPIRIT_TEMPLE_MQ_9_THRONES_ROOM:  small_keys(SCENE_SPIRIT_TEMPLE, 7)
        RR_SPIRIT_TEMPLE_MQ_BIG_MIRROR_ROOM: can_use(RG_ZELDAS_LULLABY)
    }
}

region RR_SPIRIT_TEMPLE_MQ_9_THRONES_ROOM {
    name: "Spirit Temple MQ 9 Thrones Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_4F_CENTRAL: always
    }
}

region RR_SPIRIT_TEMPLE_MQ_BIG_MIRROR_ROOM {
    name: "Spirit Temple MQ Big Mirror Room"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # Needs the mirror in the cave to be a perm flag and event for doorsanity
        LOGIC_SPIRIT_PLATFORM_LOWERED: (flag(LOGIC_SPIRIT_PUSHED_4F_MIRRORS) and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows()
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_4F_CENTRAL:      always
        RR_SPIRIT_TEMPLE_MQ_BIG_MIRROR_CAVE: any_age(can_use(RG_MEGATON_HAMMER))
        RR_SPIRIT_TEMPLE_MQ_PLATFORM:        flag(LOGIC_SPIRIT_PLATFORM_LOWERED)
    }
}

region RR_SPIRIT_TEMPLE_MQ_BIG_MIRROR_CAVE {
    name: "Spirit Temple MQ Big Mirror Cave"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_PUSHED_4F_MIRRORS: ((is_adult() and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows() or (trick(RT_FIRE_RINGS) and take_damage())) and has(RG_POWER_BRACELET)
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_BIG_MIRROR_ROOM: always
    }
}

# Assumes SpiritPlatformLowered is checked on entry
region RR_SPIRIT_TEMPLE_MQ_PLATFORM {
    name: "Spirit Temple MQ Platform"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_HEAD:       flag(LOGIC_SPIRIT_PUSHED_4F_MIRRORS) and can_use(RG_MIRROR_SHIELD) and can_use(RG_HOOKSHOT)
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_CHILD: always
        RR_SPIRIT_TEMPLE_MQ_INNER_RIGHT_HAND:  always
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM:       always
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM_ADULT: always
        RR_SPIRIT_TEMPLE_MQ_INNER_LEFT_HAND:   always
    }
}

region RR_SPIRIT_TEMPLE_MQ_STATUE_HEAD {
    name: "Spirit Temple MQ Statue Head"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # WARNING these events are not glitchproofed and assume you need all keys to reach from the front
        LOGIC_REVERSE_SPIRIT_CHILD: is_child()
        LOGIC_REVERSE_SPIRIT_ADULT: is_adult()
    }

    exits {
        RR_SPIRIT_TEMPLE_MQ_STATUE_ROOM:      always
        # CanBunnyJump with a jumpslash can reach either hand and with good timing the platform as child. the latter is definitely a trick, the former may not be
        # If this interaction with the hands is added, SpiritSharedLogic needs updating for it
        RR_SPIRIT_TEMPLE_MQ_INNER_RIGHT_HAND: can_use(RG_HOVER_BOOTS)
        RR_SPIRIT_TEMPLE_MQ_INNER_LEFT_HAND:  can_use(RG_HOVER_BOOTS)
        RR_SPIRIT_TEMPLE_MQ_PLATFORM:         flag(LOGIC_SPIRIT_PLATFORM_LOWERED) and (can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT))
        RR_SPIRIT_TEMPLE_BOSS_ENTRYWAY:       always
    }
}
