region RR_SPIRIT_TEMPLE_FOYER {
    name: "Spirit Temple Foyer"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_FORWARDS_SPIRIT_CHILD: is_child()
        LOGIC_FORWARDS_SPIRIT_ADULT: is_adult()
    }

    exits {
        RR_SPIRIT_TEMPLE_ENTRYWAY:       always
        RR_SPIRIT_TEMPLE_CHILD_SIDE_HUB: (is_adult() or has(RG_SPEAK_GERUDO) or flag(LOGIC_SPIRIT_NABOORU_KIDNAPPED)) and can_use(RG_CRAWL)
        RR_SPIRIT_TEMPLE_ADULT_SIDE_HUB: can_use(RG_SILVER_GAUNTLETS)
    }
}

region RR_SPIRIT_TEMPLE_CHILD_SIDE_HUB {
    name: "Spirit Temple Child Side Hub"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_NUT_ACCESS:                         can_break_small_crates()
        LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE_TORCHES: any_age(can_kill(RE_ARMOS)) and can_use(RG_STICKS) # not usable in doorsanity
    }

    exits {
        RR_SPIRIT_TEMPLE_FOYER:               can_use(RG_CRAWL)
        RR_SPIRIT_TEMPLE_CHILD_BOXES:         can_use(RG_CRAWL)
        # Implies logic->CanKillEnemy(RE_KEESE)
        RR_SPIRIT_TEMPLE_SWITCH_BRIDGE_SOUTH: any_age(can_kill(RE_ARMOS))
        RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_SOUTH:  any_age(can_kill(RE_ARMOS))
    }
}

region RR_SPIRIT_TEMPLE_SWITCH_BRIDGE_SOUTH {
    name: "Spirit Temple Switch Bridge South"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_CHILD_SWITCH_BRIDGE: can_use(RG_BOOMERANG) or can_use(RG_FAIRY_SLINGSHOT) or can_use(RG_FAIRY_BOW) or (can_use(RG_BOMBCHU_5) and trick(RT_SPIRIT_CHILD_CHU))
    }

    exits {
        RR_SPIRIT_TEMPLE_CHILD_SIDE_HUB:      always
        RR_SPIRIT_TEMPLE_SWITCH_BRIDGE_NORTH: (flag(LOGIC_SPIRIT_CHILD_SWITCH_BRIDGE) and can_pass(RE_GREEN_BUBBLE, ED_CLOSE, false)) or
                                              can_use(RG_HOVER_BOOTS) or can_use(RG_LONGSHOT)
    }
}

region RR_SPIRIT_TEMPLE_SWITCH_BRIDGE_NORTH {
    name: "Spirit Temple Switch Bridge North"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_CHILD_SWITCH_BRIDGE: can_hit_switch()
    }

    exits {
        RR_SPIRIT_TEMPLE_SWITCH_BRIDGE_SOUTH: can_use(RG_HOVER_BOOTS) or (flag(LOGIC_SPIRIT_CHILD_SWITCH_BRIDGE) and can_pass(RE_GREEN_BUBBLE, ED_CLOSE, false))
        RR_SPIRIT_TEMPLE_1F_ANUBIS:           always
    }
}

region RR_SPIRIT_TEMPLE_1F_ANUBIS {
    name: "Spirit Temple 1F Anubis"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_SWITCH_BRIDGE_NORTH: any_age(can_hit_switch() or has(RG_POWER_BRACELET) or can_kill(RE_ANUBIS))
        RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_NORTH:  any_age(can_hit_switch() or has(RG_POWER_BRACELET) or can_kill(RE_ANUBIS))
    }
}

region RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_NORTH {
    name: "Spirit Temple Rupee Bridge North"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE:         has(RG_CLIMB) or can_use(RG_HOOKSHOT)
        LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE_TORCHES: (flag(LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE) and has_fire_source_with_torch()) or can_use(RG_DINS_FIRE)
    }

    exits {
        RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_SOUTH: flag(LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE)
        RR_SPIRIT_TEMPLE_1F_ANUBIS:          always
    }
}

region RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_SOUTH {
    name: "Spirit Temple Rupee Bridge South"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE_TORCHES: has_fire_source()
    }

    exits {
        RR_SPIRIT_TEMPLE_CHILD_SIDE_HUB:     always
        RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_NORTH: flag(LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE)
    }
}

region RR_SPIRIT_TEMPLE_CHILD_BOXES {
    name: "Child Spirit Temple Before Climb"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_CHILD_SIDE_HUB:  can_use(RG_CRAWL)
        RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_1F: small_keys(SCENE_SPIRIT_TEMPLE, 1)
    }
}

region RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_1F {
    name: "Spirit Temple Sun On Floor 1F"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_CHILD_BOXES:     small_keys(SCENE_SPIRIT_TEMPLE, 5)
        RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F: has(RG_CLIMB) or can_use(RG_LONGSHOT)
    }
}

region RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F {
    name: "Spirit Temple Sun On Floor 2F"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_1F: always
        RR_SPIRIT_TEMPLE_STATUE_ROOM:     has_explosives() or (setting(RSK_SUNLIGHT_ARROWS) and can_use(RG_LIGHT_ARROWS))
    }
}

region RR_SPIRIT_TEMPLE_ADULT_SIDE_HUB {
    name: "Spirit Temple Adult Side Hub"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_FOYER:          always
        RR_SPIRIT_TEMPLE_SAND_PIT:       any_age(can_hit_switch(is_adult() and trick(RT_SPIRIT_LOWER_ADULT_SWITCH) ? ED_BOMB_THROW : ED_BOOMERANG))
        RR_SPIRIT_TEMPLE_BOULDERS:       any_age(can_hit_switch(is_adult() and trick(RT_SPIRIT_LOWER_ADULT_SWITCH) ? ED_BOMB_THROW : ED_BOOMERANG))
        RR_SPIRIT_TEMPLE_1F_MIRROR_ROOM: small_keys(SCENE_SPIRIT_TEMPLE, 1)
    }
}

region RR_SPIRIT_TEMPLE_SAND_PIT {
    name: "Spirit Temple Sand Pit"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_ADULT_SIDE_HUB: always
    }
}

region RR_SPIRIT_TEMPLE_ABOVE_BOULDERS {
    name: "Spirit Temple Above Boulders"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_BOUNDERS_SILVERS: can_use(RG_HOVER_BOOTS) or can_jumpslash() or can_use(RG_LONGSHOT)
    }

    exits {
        RR_SPIRIT_TEMPLE_ADULT_SIDE_HUB: always
        RR_SPIRIT_TEMPLE_BOULDERS:       always
    }
}

region RR_SPIRIT_TEMPLE_BOULDERS {
    name: "Spirit Temple Boulders"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_ABOVE_BOULDERS: is_adult() or has(RG_CLIMB) or can_use(RG_HOOKSHOT) or can_ground_jump()
        RR_SPIRIT_TEMPLE_PAST_BOULDERS:  flag(LOGIC_SPIRIT_BOUNDERS_SILVERS)
    }
}

region RR_SPIRIT_TEMPLE_PAST_BOULDERS {
    name: "Spirit Temple Past Boulders"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_BOULDERS: always
    }
}

region RR_SPIRIT_TEMPLE_1F_MIRROR_ROOM {
    name: "Spirit Temple 1F Mirror Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_ADULT_SIDE_HUB: small_keys(SCENE_SPIRIT_TEMPLE, 5)
        RR_SPIRIT_TEMPLE_2F_MIRROR_ROOM: has(RG_CLIMB) or can_use(RG_LONGSHOT)
    }
}

region RR_SPIRIT_TEMPLE_2F_MIRROR_ROOM {
    name: "Spirit Temple 2F Mirror Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_1F_MIRROR_ROOM:    always
        RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT: has(RG_POWER_BRACELET) or sunlight_arrows()
    }
}

region RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD {
    name: "Spirit Temple Statue Rooom Child"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F: always
        RR_SPIRIT_TEMPLE_INNER_WEST_HAND: always
        RR_SPIRIT_TEMPLE_GS_LEDGE:        can_use(RG_HOVER_BOOTS) or reach_scarecrow()
        # RT_SPIRIT_PLATFORM_HOOKSHOT is currently disabled
        RR_SPIRIT_TEMPLE_PLATFORM:        flag(LOGIC_SPIRIT_PLATFORM_LOWERED) and
                                          (can_use(RG_LONGSHOT) or (trick(RT_SPIRIT_PLATFORM_HOOKSHOT) and can_use(RG_HOOKSHOT)))
        RR_SPIRIT_TEMPLE_EMPTY_STAIRS:    has(RG_POWER_BRACELET)
        # !QUANTUM LOGIC!
        # When child enters spirit in reverse, has 4 keys, and dungeon entrance shuffle is off, 
        # Child cannot lock themselves out of desert colossus access as if they save the west hand lock for last
        # they will be able to exit the dungeon through the intended entrance and vice versa
        # for needing to open the west hand lock to block the intended child route
        RR_DESERT_COLOSSUS:               setting(RSK_SHUFFLE_DUNGEON_ENTRANCES) is RO_DUNGEON_ENTRANCE_SHUFFLE_OFF and has(RG_POWER_BRACELET) and
                                          can_use(RG_CRAWL) and small_keys(SCENE_SPIRIT_TEMPLE, 4) and can_kill(RE_IRON_KNUCKLE)
    }
}

region RR_SPIRIT_TEMPLE_INNER_WEST_HAND {
    name: "Spirit Temple Inner West Hand"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_DESERT_COLOSSUS: (is_child() and small_keys(SCENE_SPIRIT_TEMPLE, 5)) or (can_use(RG_SILVER_GAUNTLETS) and ((small_keys(SCENE_SPIRIT_TEMPLE, 3) and has_explosives()) or small_keys(SCENE_SPIRIT_TEMPLE, 5)))
    }
}

region RR_SPIRIT_TEMPLE_GS_LEDGE {
    name: "Spirit Temple GS ledge"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD: can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT)
        RR_SPIRIT_TEMPLE_INNER_WEST_HAND:   always
    }
}

region RR_SPIRIT_TEMPLE_STATUE_ROOM {
    name: "Spirit Temple Statue Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD: has(RG_CLIMB) or can_use(RG_HOOKSHOT)
        RR_SPIRIT_TEMPLE_PLATFORM:          flag(LOGIC_SPIRIT_PLATFORM_LOWERED) and
                                            (can_use(RG_LONGSHOT) or (trick(RT_SPIRIT_PLATFORM_HOOKSHOT) and can_use(RG_HOOKSHOT)))
        # explicit adult check here is a precaution against possible child logic leaking, child with a hookshot can do this
        RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT: is_adult() and can_use(RG_HOOKSHOT)
        RR_SPIRIT_TEMPLE_SHORTCUT:          flag(LOGIC_SPIRIT_STATUE_SOUTH_DOOR)
        # !QUANTUM LOGIC!
        # If dungeon entrance randomiser is off, Adult entered spirit in reverse, and they have str 2 to get there from the front and Explosives,
        # it is always possible for them to reach 1F_EAST with only 2 keys. This is because you can only waste 1 key (on the first child side lock)
        # before you either allow you to climb down through 2F mirror room, or give yourself access to a hand to jump down from.
        # If for whatever reason you can reach east hand but not west hand, this becomes possible with 3 keys instead.
        # If you do not have explosives to kill Beamos, but do have a way to defeat Iron Knuckles, this becomes possible with 4 keys instead.
        RR_SPIRIT_TEMPLE_ADULT_SIDE_HUB:    setting(RSK_SHUFFLE_DUNGEON_ENTRANCES) is RO_DUNGEON_ENTRANCE_SHUFFLE_OFF and
                                            can_use(RG_SILVER_GAUNTLETS) and is_adult() and
                                            ((can_kill(RE_BEAMOS) and small_keys(SCENE_SPIRIT_TEMPLE, (has(RG_CLIMB) or can_use(RG_HOOKSHOT)) and has(RG_POWER_BRACELET) ? 2 : 3)) or
                                             ((has(RG_CLIMB) or can_use(RG_HOOKSHOT)) and has(RG_POWER_BRACELET) and can_kill(RE_IRON_KNUCKLE) and small_keys(SCENE_SPIRIT_TEMPLE, 4)))
    }
}

region RR_SPIRIT_TEMPLE_EMPTY_STAIRS {
    name: "Spirit Temple Empty Stairs"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM:    always
        RR_SPIRIT_TEMPLE_SUN_BLOCK_ROOM: always
    }
}

region RR_SPIRIT_TEMPLE_SUN_BLOCK_ROOM {
    name: "Spirit Temple Sun Block Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_EMPTY_STAIRS:          has(RG_POWER_BRACELET) or sunlight_arrows()
        # The blocks can be used to get onto this ledge itemless
        RR_SPIRIT_TEMPLE_SUN_BLOCK_CHEST_LEDGE: spirit_sun_block_south_ledge()
        RR_SPIRIT_TEMPLE_SKULLTULA_STAIRS:      has(RG_POWER_BRACELET) or sunlight_arrows()
    }
}

region RR_SPIRIT_TEMPLE_SUN_BLOCK_CHEST_LEDGE {
    name: "Spirit Temple Sun Block Chest ledge"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_SUN_BLOCK_TORCH: spirit_shared(RR_SPIRIT_TEMPLE_SUN_BLOCK_CHEST_LEDGE, always, true)
    }

    exits {
        RR_SPIRIT_TEMPLE_SUN_BLOCK_ROOM: always
    }
}

region RR_SPIRIT_TEMPLE_SKULLTULA_STAIRS {
    name: "Spirit Temple Skulltula Stairs"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_SUN_BLOCK_ROOM: always
        RR_SPIRIT_TEMPLE_CHILD_THRONE:   small_keys(SCENE_SPIRIT_TEMPLE, 3)
    }
}

region RR_SPIRIT_TEMPLE_CHILD_THRONE {
    name: "Spirit Temple Child Throne"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_SKULLTULA_STAIRS: small_keys(SCENE_SPIRIT_TEMPLE, 3)
        RR_SPIRIT_TEMPLE_RIGHT_HAND_EXIT:  any_age(can_kill(RE_IRON_KNUCKLE))
    }
}

region RR_SPIRIT_TEMPLE_RIGHT_HAND_EXIT {
    name: "Spirit Temple Right Hand Exit"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_CHILD_THRONE:     always
        RR_SPIRIT_TEMPLE_OUTER_RIGHT_HAND: always
    }
}

region RR_SPIRIT_TEMPLE_OUTER_RIGHT_HAND {
    name: "Spirit Temple Outer Right Hand"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_NABOORU_KIDNAPPED: spirit_shared(RR_SPIRIT_TEMPLE_OUTER_RIGHT_HAND, has(RG_OPEN_CHEST))
    }

    exits {
        RR_SPIRIT_TEMPLE_RIGHT_HAND_EXIT: always
        RR_DESERT_COLOSSUS:               spirit_certain_access(RR_SPIRIT_TEMPLE_OUTER_RIGHT_HAND)
    }
}

region RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT {
    name: "Spirit Temple Statue Room Adult"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_2F_MIRROR_ROOM:  always
        RR_SPIRIT_TEMPLE_STATUE_ROOM:     always
        RR_SPIRIT_TEMPLE_INNER_LEFT_HAND: always
        RR_SPIRIT_TEMPLE_SHORTCUT_SWITCH: spirit_east_to_switch()
        RR_SPIRIT_TEMPLE_POT_STAIRS:      small_keys(SCENE_SPIRIT_TEMPLE, 4)
        RR_SPIRIT_TEMPLE_PLATFORM:        flag(LOGIC_SPIRIT_PLATFORM_LOWERED) and
                                          (can_use(RG_LONGSHOT) or (trick(RT_SPIRIT_PLATFORM_HOOKSHOT) and can_use(RG_HOOKSHOT)))
    }
}

region RR_SPIRIT_TEMPLE_INNER_LEFT_HAND {
    name: "Spirit Temple Inner Left Hand"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM:       always
        RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT: can_use(RG_HOVER_BOOTS)
        # Assumes RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT access via RR_SPIRIT_TEMPLE_STATUE_ROOM
        RR_SPIRIT_TEMPLE_SHORTCUT_SWITCH:   (is_adult() and trick(RT_SPIRIT_STATUE_JUMP)) or
                                            (can_use(RG_ZELDAS_LULLABY) and can_use(RG_HOOKSHOT))
    }
}

region RR_SPIRIT_TEMPLE_SHORTCUT_SWITCH {
    name: "Spirit Temple Shortcut Switch"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_STATUE_SOUTH_DOOR: spirit_shared(RR_SPIRIT_TEMPLE_SHORTCUT_SWITCH, can_use(RG_MEGATON_HAMMER))
    }

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT: always
        RR_SPIRIT_TEMPLE_INNER_LEFT_HAND:   always
    }
}

region RR_SPIRIT_TEMPLE_SHORTCUT {
    name: "Spirit Temple Shortcut"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        # If child can ever use silver gauntlets, there needs to be an event here to account for child entering in reverse
        # opening the way for adult entering via the front.
        RR_SPIRIT_TEMPLE_STATUE_ROOM: always
        RR_SPIRIT_TEMPLE_FOYER:       can_use(RG_SILVER_GAUNTLETS) and can_use(RG_MEGATON_HAMMER)
    }
}

region RR_SPIRIT_TEMPLE_POT_STAIRS {
    name: "Spirit Temple Pot Stairs"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT: small_keys(SCENE_SPIRIT_TEMPLE, 4)
        RR_SPIRIT_TEMPLE_BEAMOS_PITS:       always
    }
}

region RR_SPIRIT_TEMPLE_BEAMOS_PITS {
    name: "Spirit Temple Beamos Pits"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_POT_STAIRS:    can_kill(RE_BEAMOS)
        RR_SPIRIT_TEMPLE_4_ARMOS:       can_kill(RE_BEAMOS)
        RR_SPIRIT_TEMPLE_BIG_WALL_BASE: small_keys(SCENE_SPIRIT_TEMPLE, 5)
    }
}

region RR_SPIRIT_TEMPLE_4_ARMOS {
    name: "Spirit Temple 4 Armos"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_BEAMOS_PITS:       always
        RR_SPIRIT_TEMPLE_4_ARMOS_SIDE_ROOM: can_use(RG_MIRROR_SHIELD) or sunlight_arrows()
        RR_SPIRIT_TEMPLE_CHEST_STAIRS:      always
    }
}

region RR_SPIRIT_TEMPLE_4_ARMOS_SIDE_ROOM {
    name: "Spirit Temple 4 Armos Side Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_4_ARMOS: always
    }
}

region RR_SPIRIT_TEMPLE_CHEST_STAIRS {
    name: "Spirit Temple Chest Stairs"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_4_ARMOS:      always
        RR_SPIRIT_TEMPLE_ADULT_THRONE: always
    }
}

region RR_SPIRIT_TEMPLE_ADULT_THRONE {
    name: "Spirit Temple Adult Throne"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_CHEST_STAIRS:   any_age(can_kill(RE_IRON_KNUCKLE))
        RR_SPIRIT_TEMPLE_LEFT_HAND_EXIT: any_age(can_kill(RE_IRON_KNUCKLE))
    }
}

region RR_SPIRIT_TEMPLE_LEFT_HAND_EXIT {
    name: "Spirit Temple Left Hand Exit"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_ADULT_THRONE:    always
        RR_SPIRIT_TEMPLE_OUTER_LEFT_HAND: always
    }
}

region RR_SPIRIT_TEMPLE_OUTER_LEFT_HAND {
    name: "Spirit Temple Outer Left Hand"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_LEFT_HAND_EXIT:   always
        RR_SPIRIT_TEMPLE_OUTER_RIGHT_HAND: can_use(RG_LONGSHOT)
        RR_DESERT_COLOSSUS:                always
    }
}

region RR_SPIRIT_TEMPLE_BIG_WALL_BASE {
    name: "Spirit Temple Big Wall Base"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_BEAMOS_PITS:    always
        RR_SPIRIT_TEMPLE_BIG_WALL_UPPER: (trick(RT_SPIRIT_WALL) or (can_avoid(RE_BEAMOS, true, 2) and can_pass(RE_WALLTULA, ED_BOOMERANG))) and
                                         (has(RG_CLIMB) or can_use(RG_LONGSHOT))
    }
}

region RR_SPIRIT_TEMPLE_BIG_WALL_UPPER {
    name: "Spirit Temple Big Wall Upper"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_BIG_WALL_BASE: always
        RR_SPIRIT_TEMPLE_4F_CENTRAL:    always
    }
}

region RR_SPIRIT_TEMPLE_4F_CENTRAL {
    name: "Spirit Temple 4F Central"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_BIG_WALL_UPPER:  always
        RR_SPIRIT_TEMPLE_FAKE_DOORS_ROOM: can_use(RG_ZELDAS_LULLABY)
        RR_SPIRIT_TEMPLE_BIG_MIRROR_ROOM: always
    }
}

region RR_SPIRIT_TEMPLE_FAKE_DOORS_ROOM {
    name: "Spirit Temple Fake Doors Room"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_4F_CENTRAL: always
    }
}

region RR_SPIRIT_TEMPLE_BIG_MIRROR_ROOM {
    name: "Spirit Temple Big Mirror Room"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_4F_SWITCH:        can_jumpslash() or has_explosives() or can_use(RG_GIANTS_KNIFE) or
                                       (trick(RT_ITEM_EXTENSION) and ((is_adult() and can_use(RG_HOOKSHOT)) or can_use(RG_FAIRY_BOW) or can_use(RG_FAIRY_SLINGSHOT)))
        LOGIC_SPIRIT_PLATFORM_LOWERED: (flag(LOGIC_SPIRIT_PUSHED_4F_MIRRORS) and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows()
    }

    exits {
        RR_SPIRIT_TEMPLE_4F_CENTRAL:      always
        # Rang can hit the switch on the way back but that's a trick
        RR_SPIRIT_TEMPLE_BIG_MIRROR_CAVE: flag(LOGIC_SPIRIT_4F_SWITCH)
        # Assumes RR_SPIRIT_TEMPLE_BIG_MIRROR_CAVE access
        RR_SPIRIT_TEMPLE_PLATFORM:        flag(LOGIC_SPIRIT_PLATFORM_LOWERED)
    }
}

region RR_SPIRIT_TEMPLE_BIG_MIRROR_CAVE {
    name: "Spirit Temple Big Mirror Cave"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        LOGIC_SPIRIT_4F_SWITCH:         has_explosives()
        LOGIC_SPIRIT_PUSHED_4F_MIRRORS: has_explosives() and has(RG_POWER_BRACELET)
    }

    exits {
        RR_SPIRIT_TEMPLE_BIG_MIRROR_ROOM: always
    }
}

# Assumes a SpiritPlatformLowered check on entry
region RR_SPIRIT_TEMPLE_PLATFORM {
    name: "Spirit Temple Lowered Platform"
    scene: SCENE_SPIRIT_TEMPLE

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM:       always
        RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD: always
        RR_SPIRIT_TEMPLE_INNER_WEST_HAND:   always
        RR_SPIRIT_TEMPLE_STATUE_ROOM_ADULT: always
        RR_SPIRIT_TEMPLE_INNER_LEFT_HAND:   always
        RR_SPIRIT_TEMPLE_STATUE_HEAD:       flag(LOGIC_SPIRIT_PUSHED_4F_MIRRORS) and can_use(RG_MIRROR_SHIELD) and can_use(RG_HOOKSHOT)
    }
}

region RR_SPIRIT_TEMPLE_STATUE_HEAD {
    name: "Spirit Temple Statue Head"
    scene: SCENE_SPIRIT_TEMPLE

    events {
        # WARNING these events are not glitchproofed and assume you need all keys to reach from the front
        LOGIC_REVERSE_SPIRIT_CHILD: is_child()
        LOGIC_REVERSE_SPIRIT_ADULT: is_adult()
    }

    exits {
        RR_SPIRIT_TEMPLE_STATUE_ROOM:     always
        RR_SPIRIT_TEMPLE_INNER_WEST_HAND: can_use(RG_HOVER_BOOTS)
        RR_SPIRIT_TEMPLE_INNER_LEFT_HAND: can_use(RG_HOVER_BOOTS)
        RR_SPIRIT_TEMPLE_PLATFORM:        flag(LOGIC_SPIRIT_PLATFORM_LOWERED) and (can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT))
        RR_SPIRIT_TEMPLE_BOSS_ENTRYWAY:   always
    }
}
