#Water Temple logic currently assumes that the locked door leading to the upper water raising location is unlocked from the start
region RR_WATER_TEMPLE_ENTRANCE_LEDGE {
    name: "Water Temple Entrance Ledge"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_WATER_COULD_MIDDLE: has_fire_source_with_torch() or can_use(RG_FAIRY_BOW)
    }
    
    exits {
        RR_WATER_TEMPLE_ENTRYWAY:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS)
        RR_WATER_TEMPLE_MAIN:          always
        RR_WATER_TEMPLE_3F_CENTRAL_A:  (water_level(WL_HIGH) and can_use(RG_HOOKSHOT)) or can_use(RG_HOVER_BOOTS)
        RR_WATER_TEMPLE_3F_CENTRAL_H:  water_level(WL_HIGH) and (can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS))
        RR_WATER_TEMPLE_3F_CENTRAL_LM: can_use(RG_HOVER_BOOTS) and water_level(WL_LOW_OR_MID)
        RR_WATER_TEMPLE_2F_CENTRAL_LM: water_level(WL_LOW_OR_MID)
    }
}

#This region covers simply existing in the area around the central pillar without being on a specific platform, either swimming or walking on the lakebed
#Entry should only include being in the correct area, taking any possible fall damage, and floating up to the surface of WL_HIGH if coming from below
#This area then leads to others based on level and worst-case water timers for follow-up exits from the water's surface
#remember that any solution that works for any level doesn't need to be given a level, even if that solution is overkill for a lower level
#Water Temple logic currently assumes that the locked door leading to the upper water raising location is unlocked from the start
region RR_WATER_TEMPLE_MAIN {
    name: "Water Temple Main"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_WATER_PUSHED_1F_BLOCK:     water_level(WL_LOW) and has(RG_GORONS_BRACELET)
        LOGIC_WATER_COULD_MIDDLE:        (can_use(RG_LONGSHOT) and (has_fire_source_with_torch() or can_use(RG_FAIRY_BOW))) or
                                         (can_use(RG_HOOKSHOT) and small_keys(SCENE_WATER_TEMPLE, 5))
        #Assumes RR_WATER_TEMPLE_JET_LIFT and RR_WATER_TEMPLE_HIGH_EMBLEM access
        LOGIC_WATER_COULD_HIGH_FROM_MID: (can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS) or has(RG_BRONZE_SCALE)) and
                                         can_hit_switch(ED_BOMB_THROW)
    }
    
    exits {
        RR_WATER_TEMPLE_ENTRANCE_LEDGE: has(RG_BRONZE_SCALE) and water_level(WL_HIGH)
        RR_WATER_TEMPLE_SIDE_TOWER_1F:  (water_timer() >= 24 and can_use(RG_IRON_BOOTS)) or (water_level(WL_MID) and has(RG_GOLDEN_SCALE) and 
                                        water_timer() >= 16) or water_level(WL_LOW) or (can_use(RG_LONGSHOT) and trick(RT_WATER_LONGSHOT_TORCH) and 
                                        has(RG_BRONZE_SCALE) and water_timer() >= 8)
        RR_WATER_TEMPLE_3F_CENTRAL_A:   water_level(WL_HIGH) and has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_3F_CENTRAL_H:    water_level(WL_HIGH) and has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_2F_CENTRAL_H:   water_level(WL_HIGH) and can_use(RG_IRON_BOOTS) and ((water_timer() >= 8 and has(RG_BRONZE_SCALE)) or 
                                        (water_timer() >= 40 and can_use(RG_LONGSHOT)))
        RR_WATER_TEMPLE_2F_CENTRAL_LM:  water_level(WL_LOW_OR_MID) and ((water_level(WL_MID) and has(RG_BRONZE_SCALE)) or ((water_level(WL_LOW) or 
                                        (can_use(RG_IRON_BOOTS) and water_timer() >= 40)) and can_use(RG_LONGSHOT)))
        RR_WATER_TEMPLE_PILLAR_1F:      water_level(WL_LOW) and small_keys(SCENE_WATER_TEMPLE, 5)
        RR_WATER_TEMPLE_SPIKE_MOAT:     ((water_level(WL_LOW) and has(RG_BRONZE_SCALE)) or (can_use(RG_IRON_BOOTS) and water_timer() >= 16 and 
                                        (can_use(RG_HOOKSHOT) or has(RG_BRONZE_SCALE))))
        RR_WATER_TEMPLE_BLOCK_U_BEND:   flag(LOGIC_WATER_PUSHED_1F_BLOCK) and ((can_use(RG_IRON_BOOTS) and has(RG_BRONZE_SCALE) and water_timer() >= 16) or
                                        (water_level(WL_LOW) and has(RG_SILVER_SCALE)))
        RR_WATER_TEMPLE_NEAR_CAGE:      any_age(water_level(WL_LOW) and has_explosives()) and (water_level(WL_LOW) and has(RG_SILVER_SCALE) or
                                        (can_use(RG_IRON_BOOTS) and has(RG_BRONZE_SCALE) and water_timer() >= 16))
    }
}

region RR_WATER_TEMPLE_3F_CENTRAL_A {
    name: "Water Temple 3F Central Any Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN: always
        RR_WATER_TEMPLE_ENTRANCE_LEDGE:      can_use(RG_LONGSHOT) or can_use(RG_HOVER_BOOTS)
        RR_WATER_TEMPLE_HIGH_EMBLEM:         water_3f_central_to_high_emblem()
        RR_WATER_TEMPLE_JET_CHEST_ROOM:      can_use(RG_HOOKSHOT) and can_use(RG_IRON_BOOTS) and water_timer() >= 16
        RR_WATER_TEMPLE_RISING_TARGET_LEDGE: trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_HOVER_BOOTS) and (can_use(RG_MEGATON_HAMMER) or 
                                             (trick(RT_DAMAGE_BOOST_SIMPLE) and has_explosives()))
    }
}

#assumes checking for WL_HIGH on entry
region RR_WATER_TEMPLE_3F_CENTRAL_H {
    name: "Water Temple 3F Central High Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_3F_CENTRAL_A:        always
        RR_WATER_TEMPLE_2F_CENTRAL_H:        can_use(RG_IRON_BOOTS) and water_timer() >= 8 and has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_OUTSIDE_WATERFALL:   is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)
        RR_WATER_TEMPLE_BLOCK_LOOP_3F_H:     can_use(RG_HOVER_BOOTS) or has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_RISING_TARGET_LEDGE: can_use(RG_LONGSHOT) or (trick(RT_WATER_IRON_BOOTS_LEDGE_GRAB) and is_adult() and has(RG_BRONZE_SCALE) and 
                                             can_use(RG_IRON_BOOTS))
    }
}

#assumes checking for WL_LOW_OR_MID on entry
region RR_WATER_TEMPLE_3F_CENTRAL_LM {
    name: "Water Temple 3F Central Low Or Mid Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_3F_CENTRAL_A:     always
        RR_WATER_TEMPLE_2F_CENTRAL_LM:    always
        RR_WATER_TEMPLE_BLOCK_LOOP:       trick(RT_WATER_CENTRAL_BOW) and can_hit_eye_targets()
        RR_WATER_TEMPLE_BLOCK_LOOP_3F_LM: can_use(RG_HOVER_BOOTS)
        #assumes RR_WATER_TEMPLE_HIGH_EMBLEM and RR_WATER_TEMPLE_3F_CENTRAL_LM access
        RR_WATER_TEMPLE_PILLAR_H:         trick(RT_WATER_IRONS_CENTRAL_GS) and can_use(RG_DINS_FIRE) and water_3f_central_to_high_emblem()
    }
}

#Assumes checking for iron boots and WL_HIGH on entry
region RR_WATER_TEMPLE_2F_CENTRAL_H {
    name: "Water Temple 2F Central High Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:           always
        #Implies CanAvoid(RE_STINGERS)
        RR_WATER_TEMPLE_JET_CHEST_ROOM: (can_use(RG_HOOKSHOT) or (trick(RT_WATER_IRON_BOOTS_LEDGE_GRAB) and has(RG_BRONZE_SCALE) and take_damage())) and 
                                        water_timer() >= 48
        RR_WATER_TEMPLE_3F_CENTRAL_H:   can_use(RG_LONGSHOT) and water_timer() >= 40
    }
}

#assumes checking for WL_LOW_OR_MID on entry
region RR_WATER_TEMPLE_2F_CENTRAL_LM {
    name: "Water Temple 2F Central Low Or Mid Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:                always
        #Implies CanAvoid(RE_STINGERS)
        RR_WATER_TEMPLE_JET_CHEST_ROOM:      can_use(RG_HOOKSHOT)
        RR_WATER_TEMPLE_OUTSIDE_JET_LIFT_2F: water_level(WL_MID) and (is_adult() and can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS) or has(RG_BRONZE_SCALE))
        #Child can jumpslash with the lit stick to light the torch
        RR_WATER_TEMPLE_PILLAR_2F:           has_fire_source_with_torch() or can_use(RG_FAIRY_BOW)
        #assumes RR_WATER_TEMPLE_3F_CENTRAL_LM and RR_WATER_TEMPLE_HIGH_EMBLEM access
        RR_WATER_TEMPLE_PILLAR_H:            trick(RT_WATER_IRONS_CENTRAL_GS) and (has_fire_source_with_torch() or can_use(RG_FAIRY_BOW)) and
                                             can_use(RG_LONGSHOT) and water_3f_central_to_high_emblem()
        #hookshot + jumpslash can make it up through the platform slit as adult, is easier with WL_MID but still possible on WL_LOW, but it's a trick
        RR_WATER_TEMPLE_3F_CENTRAL_LM:       can_use(RG_LONGSHOT)
        RR_WATER_TEMPLE_BLOCK_LOOP:          can_hit_eye_targets() and (can_use(RG_LONGSHOT) or can_use(RG_HOVER_BOOTS))
    }
}

region RR_WATER_TEMPLE_SIDE_TOWER_1F {
    name: "Water Temple Side Tower 1F"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_WATER_COULD_LOW_FROM_HIGH: has(RG_BRONZE_SCALE)
    }
    
    exits {
        RR_WATER_TEMPLE_MAIN:          water_level(WL_LOW) or (can_use(RG_IRON_BOOTS) and water_timer() >= 8)
        RR_WATER_TEMPLE_LOW_EMBLEM:    water_level(WL_HIGH) and has(RG_BRONZE_SCALE) and water_timer() >= 8
        RR_WATER_TEMPLE_SIDE_TOWER_2F: water_level(WL_MID) and has(RG_BRONZE_SCALE) and water_timer() >= 8
        RR_WATER_TEMPLE_TORCH_ROOM:    water_level(WL_LOW) and (has_fire_source_with_torch() or can_use(RG_FAIRY_BOW))
    }
}

region RR_WATER_TEMPLE_SIDE_TOWER_2F {
    name: "Water Temple Side Tower 2F"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:         (can_use(RG_IRON_BOOTS) and water_timer() >= 8) or water_level(WL_LOW)
        RR_WATER_TEMPLE_CRACKED_WALL: water_level(WL_LOW_OR_MID) and has_explosives()
    }
}

region RR_WATER_TEMPLE_LOW_EMBLEM {
    name: "Water Temple Low Emblem"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_WATER_LOW:       can_use(RG_ZELDAS_LULLABY)
        LOGIC_WATER_COULD_LOW: always
    }
    
    exits {
        #trick: with WL_HIGH, chu cracked wall from here, then open underwater chest
        RR_WATER_TEMPLE_MAIN:          water_level(WL_LOW) or (water_timer() >= 24 and can_use(RG_IRON_BOOTS))
        RR_WATER_TEMPLE_SIDE_TOWER_2F: water_level(WL_LOW_OR_MID) and ((can_use(RG_HOVER_BOOTS) and trick(RT_WATER_CRACKED_WALL_HOVERS)) or 
                                       trick(RT_WATER_CRACKED_WALL)) or water_level(WL_MID) and has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_4_SPIKES_ROOM: always
    }
}

region RR_WATER_TEMPLE_4_SPIKES_ROOM {
    name: "Water Temple 4 Spikes Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_SIDE_TOWER_1F: any_age(can_kill(RE_SPIKE, ED_CLOSE, true, 4))
    }
}

region RR_WATER_TEMPLE_CRACKED_WALL {
    name: "Water Temple Cracked Wall"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_SIDE_TOWER_2F: always
    }
}

region RR_WATER_TEMPLE_TORCH_ROOM {
    name: "Water Temple Torch Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_SIDE_TOWER_1F: ((water_level(WL_LOW) or can_use(RG_IRON_BOOTS)) and any_age(
                                       (water_level(WL_LOW) and can_kill(RE_SHELL_BLADE, ED_CLOSE, true, 3)) or can_use(RG_HOOKSHOT)))
    }
}

region RR_WATER_TEMPLE_SPIKE_MOAT {
    name: "Water Temple Spike Moat"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:              has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_BEHIND_SPIKE_MOAT: (can_use(RG_LONGSHOT) or (trick(RT_WATER_BK_REGION) and can_use(RG_HOVER_BOOTS)))
    }
}

region RR_WATER_TEMPLE_BEHIND_SPIKE_MOAT {
    name: "Water Temple Behind Spike Moat"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        #You can backflip over the spikes and into the water. You can equip irons to get over while skipping swim, but it leaves you stuck in the pond
        RR_WATER_TEMPLE_SPIKE_MOAT:     has(RG_BRONZE_SCALE) or can_use(RG_LONGSHOT) or (can_use(RG_HOOKSHOT) and can_use(RG_IRON_BOOTS))
        RR_WATER_TEMPLE_BOULDERS_SOUTH: small_keys(SCENE_WATER_TEMPLE, 4)
    }
}

region RR_WATER_TEMPLE_BOULDERS_SOUTH {
    name: "Water Temple Boulders South"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BEHIND_SPIKE_MOAT: small_keys(SCENE_WATER_TEMPLE, 4)
        RR_WATER_TEMPLE_BOULDERS_NORTH:    has(RG_BRONZE_SCALE) or (trick(RT_WATER_INVISIBLE_HOOKSHOT_TARGET) and 
                                           can_use(is_adult() ? RG_HOOKSHOT : RG_LONGSHOT) and can_use(RG_IRON_BOOTS) and water_timer() >= 8)
        RR_WATER_TEMPLE_BOULDER_CANAL:     (is_adult() and (can_use(RG_HOVER_BOOTS) or trick(RT_WATER_NORTH_BASEMENT_LEDGE_JUMP))) or
        # A midair ground jump gets child onto the ledge, but they can't reasonably do anything without irons, and this may need TakeDamage due to the boulders
        # swim can be skipped by boots changing during the ledge climb
                                           (can_middair_ground_jump() and can_use(RG_IRON_BOOTS) and water_timer() >= 8)
    }
}

region RR_WATER_TEMPLE_BOULDERS_NORTH {
    name: "Water Temple Boulders North"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BOULDERS_SOUTH:    has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_BLOCK_ROOM_TARGET: always
    }
}

#The water rising in this room is permanent, but there is no way to do so without breaking the walls without glitches
#because of this the logic for this room must either check for if you can raise the water, or be possible regardless of the water
region RR_WATER_TEMPLE_BLOCK_ROOM_TARGET {
    name: "Water Temple Block Room Target"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BLOCK_ROOM:        always
        RR_WATER_TEMPLE_BLOCK_ROOM_STAIRS: can_use(RG_HOVER_BOOTS)
    }
}

region RR_WATER_TEMPLE_BLOCK_ROOM {
    name: "Water Temple Block Room"
    scene: SCENE_WATER_TEMPLE
    
    events {
        #Implies CanAvoid(RE_STINGER)
        #the full logic for the puzzle, as it is cut down here for optimisation
        #LOGIC_WATER_PUSHED_B1_BLOCK: has(RG_GORONS_BRACELET) and has_explosives() and
        #                (can_use(RG_HOOKSHOT) or has(RG_BRONZE_SCALE) or can_use(RG_HOVER_BOOTS))
    }
    
    exits {
        RR_WATER_TEMPLE_BLOCK_ROOM_TARGET: any_age(has(RG_GORONS_BRACELET) and has_explosives()) and has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_BLOCK_ROOM_STAIRS: any_age(has(RG_GORONS_BRACELET) and has_explosives()) and has(RG_BRONZE_SCALE)
    }
}

region RR_WATER_TEMPLE_BLOCK_ROOM_STAIRS {
    name: "Water Temple Block Room Stairs"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BLOCK_ROOM:        always
        RR_WATER_TEMPLE_BLOCK_ROOM_TARGET: can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)
    }
}

region RR_WATER_TEMPLE_3_JETS_SWITCH {
    name: "Water Temple 3 Jets Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BLOCK_ROOM_STAIRS: always
        RR_WATER_TEMPLE_3_JETS_NO_SWITCH:  always
    }
}

region RR_WATER_TEMPLE_3_JETS_NO_SWITCH {
    name: "Water Temple 3 Jets Room No Switch"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_3_JETS_SWITCH: can_use(RG_HOOKSHOT) or (trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_HOVER_BOOTS) and 
                                       can_use(RG_MEGATON_HAMMER) and can_standing_shield())
        RR_WATER_TEMPLE_CANAL_ALCOVE:  always
    }
}

region RR_WATER_TEMPLE_CANAL_ALCOVE {
    name: "Water Temple Canal Alcove"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_3_JETS_SWITCH: always
        RR_WATER_TEMPLE_BOULDER_CANAL: is_adult() or has(RG_BRONZE_SCALE) or (can_use(RG_IRON_BOOTS) and water_timer() >= 8)
        RR_WATER_TEMPLE_BEHIND_CANAL:  is_adult() and trick(RT_UNINTUITIVE_JUMPS) and has(RG_BRONZE_SCALE)
    }
}

region RR_WATER_TEMPLE_BOULDER_CANAL {
    name: "Water Temple Boulder Canal"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        #making the jump as adult without jumpslash is possible, but hard enough to be a trick
        RR_WATER_TEMPLE_BOULDERS_SOUTH: has(RG_BRONZE_SCALE) or (is_adult() and (can_jumpslash() or can_use(RG_HOVER_BOOTS)))
        RR_WATER_TEMPLE_BOULDERS_NORTH: has(RG_BRONZE_SCALE) or (trick(RT_WATER_INVISIBLE_HOOKSHOT_TARGET) and 
                                        can_use(is_adult() ? RG_HOOKSHOT : RG_LONGSHOT) and can_use(RG_IRON_BOOTS) and water_timer() >= 8)
        RR_WATER_TEMPLE_CANAL_ALCOVE:   is_adult()
        RR_WATER_TEMPLE_BEHIND_CANAL:   can_use(RG_IRON_BOOTS) and has(RG_BRONZE_SCALE) and water_timer() >= 8
    }
}

region RR_WATER_TEMPLE_BEHIND_CANAL {
    name: "Water Temple Behind Canal"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BOULDER_CANAL: has(RG_BRONZE_SCALE)
        RR_WATER_TEMPLE_BOSS_KEY_ROOM: small_keys(SCENE_WATER_TEMPLE, 5)
    }
}

region RR_WATER_TEMPLE_BOSS_KEY_ROOM {
    name: "Water Temple Boss Key Room"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_FAIRY_ACCESS: can_break_pots()
    }
    
    exits {
        RR_WATER_TEMPLE_BEHIND_CANAL: small_keys(SCENE_WATER_TEMPLE, 5)
    }
}

region RR_WATER_TEMPLE_NEAR_CAGE_STEPS {
    name: "Water Temple Near Cage Steps"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:      can_use(RG_IRON_BOOTS) and has(RG_BRONZE_SCALE) and water_timer() >= 16
        RR_WATER_TEMPLE_NEAR_CAGE: can_use(RG_HOOKSHOT) or ((is_adult() and can_use(RG_HOVER_BOOTS)) or can_middair_ground_jump())
    }
}

region RR_WATER_TEMPLE_NEAR_CAGE {
    name: "Water Temple Near Cage"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_NEAR_CAGE_STEPS: always
        #Chus can hit the switch, but not bombs, and it's a kinda narrow timing so probably a trick
        RR_WATER_TEMPLE_GS_CAGE:         can_jumpslash() or (trick(RT_ITEM_EXTENSION) and (can_use(RG_FAIRY_BOW) or can_use(RG_FAIRY_SLINGSHOT)))
    }
}

region RR_WATER_TEMPLE_GS_CAGE {
    name: "Water Temple GS Cage"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        #The room is too small to hit the switch with pots
        RR_WATER_TEMPLE_NEAR_CAGE: can_hit_switch()
    }
}

region RR_WATER_TEMPLE_BLOCK_U_BEND {
    name: "Water Temple Block U-Bend"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:                flag(LOGIC_WATER_PUSHED_1F_BLOCK) and ((can_use(RG_IRON_BOOTS) and ((can_use(RG_HOOKSHOT) and 
                                             water_level(WL_LOW)) or has(RG_BRONZE_SCALE))) or (water_level(WL_HIGH_OR_MID) and 
                                             can_use(RG_SILVER_SCALE))) and water_timer() >= 8
        RR_WATER_TEMPLE_OUTSIDE_DRAGON_ROOM: can_hit_switch()
    }
}

region RR_WATER_TEMPLE_OUTSIDE_DRAGON_ROOM {
    name: "Water Temple Outside Dragon Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BLOCK_U_BEND: can_hit_switch(ED_BOOMERANG) or can_use(RG_HOVER_BOOTS)
        RR_WATER_TEMPLE_DRAGON_ROOM:  always
    }
}

region RR_WATER_TEMPLE_DRAGON_ROOM {
    name: "Water Temple Dragon Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_OUTSIDE_DRAGON_ROOM: always
        RR_WATER_TEMPLE_ABOVE_DRAGON:        never
    }
}

region RR_WATER_TEMPLE_PILLAR_1F {
    name: "Water Temple Pillar 1F"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:      small_keys(SCENE_WATER_TEMPLE, 5) and water_level(WL_LOW)
        RR_WATER_TEMPLE_PILLAR_2F: can_use(RG_HOOKSHOT) or (water_level(WL_MID) and trick(RT_WATER_FW_CENTRAL_GS) and can_use(RG_FARORES_WIND) and has(RG_BRONZE_SCALE))
        RR_WATER_TEMPLE_PILLAR_B1: water_level(WL_MID) and can_use(RG_IRON_BOOTS) and water_timer() >= 40
        RR_WATER_TEMPLE_PILLAR_H:  trick(RT_WATER_FW_CENTRAL_GS) and can_use(RG_FARORES_WIND) and (can_use(RG_IRON_BOOTS) or has(RG_BRONZE_SCALE))
    }
}

region RR_WATER_TEMPLE_PILLAR_2F {
    name: "Water Temple Pillar 2F"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_WATER_MIDDLE:       can_use(RG_ZELDAS_LULLABY)
        LOGIC_WATER_COULD_MIDDLE: always
    }
    
    exits {
        RR_WATER_TEMPLE_2F_CENTRAL_LM: always
        RR_WATER_TEMPLE_PILLAR_1F:     water_level(WL_LOW) or can_use(RG_IRON_BOOTS) and water_timer() >= 8
        RR_WATER_TEMPLE_PILLAR_H:      trick(RT_WATER_FW_CENTRAL_GS) and can_use(RG_FARORES_WIND) and (can_use(RG_IRON_BOOTS) or has(RG_BRONZE_SCALE))
    }
}

region RR_WATER_TEMPLE_PILLAR_H {
    name: "Water Temple Pillar High Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:          can_use(RG_IRON_BOOTS) and water_timer() >= 8
        RR_WATER_TEMPLE_2F_CENTRAL_LM: can_use(RG_IRON_BOOTS) and water_timer() >= 8
        RR_WATER_TEMPLE_PILLAR_B1:     can_use(RG_IRON_BOOTS) and water_timer() >= 40
    }
}

#Assuming tunic and irons was checked on entry
region RR_WATER_TEMPLE_PILLAR_B1 {
    name: "Water Temple Pillar B1"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        #Can't know water level, so we'll just assume any possibility and skip to MAIN
        RR_WATER_TEMPLE_MAIN: has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS)
    }
}

region RR_WATER_TEMPLE_JET_CHEST_ROOM {
    name: "Water Temple Jet Chest Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN: (can_use(RG_IRON_BOOTS) and water_timer() >= 8) or water_level(WL_LOW_OR_MID)
    }
}

region RR_WATER_TEMPLE_OUTSIDE_JET_LIFT_2F {
    name: "Water Temple Outside Jet Lift 2F"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:          has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS)
        RR_WATER_TEMPLE_2F_CENTRAL_LM: water_level(WL_MID) and (is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS))
        RR_WATER_TEMPLE_JET_LIFT_2F:   water_level(WL_MID)
    }
}

region RR_WATER_TEMPLE_JET_LIFT_2F {
    name: "Water Temple Jet Lift 2F"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_OUTSIDE_JET_LIFT_2F: water_level(WL_LOW_OR_MID) or can_use(RG_IRON_BOOTS)
        RR_WATER_TEMPLE_JET_LIFT_3F:         can_hit_switch(ED_BOMB_THROW)
    }
}

region RR_WATER_TEMPLE_JET_LIFT_3F {
    name: "Water Temple Jet Lift 3F"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_JET_LIFT_2F: always
        RR_WATER_TEMPLE_HIGH_EMBLEM: always
    }
}

region RR_WATER_TEMPLE_HIGH_EMBLEM {
    name: "Water Temple High Emblem"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_WATER_HIGH:      always
        LOGIC_WATER_SCARECROW: scarecrows_song()
    }
    
    exits {
        RR_WATER_TEMPLE_MAIN:         always
        RR_WATER_TEMPLE_3F_CENTRAL_A: always
        RR_WATER_TEMPLE_3F_CENTRAL_H: water_level(WL_HIGH)
    }
}

#This region represents being able to be in "front" of the block while it's in it's half-pushed state
#Currently assumes WL_LOW_OR_MID as there's no way to reach it on WL_HIGH in logic, this will need splitting if one is added
region RR_WATER_TEMPLE_BLOCK_LOOP {
    name: "Water Temple Block Loop"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BLOCK_LOOP_BACK:  has(RG_GORONS_BRACELET) and water_level(WL_LOW_OR_MID)
        RR_WATER_TEMPLE_BLOCK_LOOP_3F_LM: can_use(RG_HOOKSHOT)
    }
}

#Currently assumes WL_LOW_OR_MID as there's no way to reach it on WL_HIGH in logic, this will need splitting if one is added
region RR_WATER_TEMPLE_BLOCK_LOOP_BACK {
    name: "Water Temple Block Loop Back"
    scene: SCENE_WATER_TEMPLE
}

#This region is not able to finish pushing the block out of the way to reach the chest
region RR_WATER_TEMPLE_BLOCK_LOOP_3F_A {
    name: "Water Temple Block Loop 3F Any Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:         always
        RR_WATER_TEMPLE_3F_CENTRAL_A: can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)
    }
}

#This region is not able to finish pushing the block out of the way to reach the chest
#assumes checking WL_HIGH on entry
region RR_WATER_TEMPLE_BLOCK_LOOP_3F_H {
    name: "Water Temple Block Loop 3F High Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BLOCK_LOOP_3F_A: always
        RR_WATER_TEMPLE_3F_CENTRAL_H:    can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)
    }
}

#This region is not able to finish pushing the block out of the way to reach the chest
#Assumes checking WL_LOW_OR_MID on entry
region RR_WATER_TEMPLE_BLOCK_LOOP_3F_LM {
    name: "Water Temple Block Loop 3F Low or Mid Water"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_BLOCK_LOOP_3F_A: always
        RR_WATER_TEMPLE_3F_CENTRAL_LM:   can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS)
        RR_WATER_TEMPLE_2F_CENTRAL_LM:   always
    }
}

region RR_WATER_TEMPLE_OUTSIDE_WATERFALL {
    name: "Water Temple Outside Waterfall"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_MAIN:                always
        RR_WATER_TEMPLE_OUTSIDE_JET_LIFT_2F: water_level(WL_MID)
        RR_WATER_TEMPLE_WATERFALL:           water_level(WL_HIGH) and small_keys(SCENE_WATER_TEMPLE, 4)
        RR_WATER_TEMPLE_3F_CENTRAL_H:        water_level(WL_HIGH) and (is_adult() or can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT) or has(RG_BRONZE_SCALE))
        RR_WATER_TEMPLE_2F_CENTRAL_H:        water_level(WL_HIGH) and can_use(RG_HOOKSHOT) and can_use(RG_IRON_BOOTS)
    }
}

#This is specifically the initial entrance alcove and platform directly underneath
region RR_WATER_TEMPLE_WATERFALL {
    name: "Water Temple Waterfall"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_OUTSIDE_WATERFALL: small_keys(SCENE_WATER_TEMPLE, 4)
        RR_WATER_TEMPLE_WATERFALL_TOP:     can_use(RG_HOOKSHOT)
    }
}

region RR_WATER_TEMPLE_WATERFALL_TOP {
    name: "Water Temple Waterfall Top"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_WATERFALL:     can_use(RG_HOOKSHOT)
        RR_WATER_TEMPLE_TOGGLE_SWITCH: small_keys(SCENE_WATER_TEMPLE, 5)
    }
}

region RR_WATER_TEMPLE_TOGGLE_SWITCH {
    name: "Water Temple Toggle Switch"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_WATERFALL_TOP:    small_keys(SCENE_WATER_TEMPLE, 5)
        #you can reach the spikes with hovers + CanHitSwitch(ED_BOMB_THROW) but can't cross them
        RR_WATER_TEMPLE_LIKE_LIKE_SPIKES: can_use(RG_HOOKSHOT)
    }
}

#specifically the area past the spikes
region RR_WATER_TEMPLE_LIKE_LIKE_SPIKES {
    name: "Water Temple Like Like Spikes"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        #swim can be skipped here as adult if you have hookshot and a melee weapon, as you can use the side of the snouts of the pillars to just barely reach the next platform,
        #and get a glitchy ledge grab by jumping from it while it is raised for the final one, which can be escaped with a jumpslash.
        #this is a trick separate from glitch ledge grabs however as the snouts are very wonky collision to climb on.
        RR_WATER_TEMPLE_TOGGLE_SWITCH:  (has(RG_BRONZE_SCALE) and can_hit_switch(ED_BOMB_THROW)) or can_use(RG_HOVER_BOOTS)
        RR_WATER_TEMPLE_DARK_LINK_ROOM: always
    }
}

region RR_WATER_TEMPLE_DARK_LINK_ROOM {
    name: "Water Temple Dark Link Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_LIKE_LIKE_SPIKES: can_kill(RE_DARK_LINK)
        RR_WATER_TEMPLE_SOT_PIT_ROOM:     can_kill(RE_DARK_LINK)
    }
}

region RR_WATER_TEMPLE_SOT_PIT_ROOM {
    name: "Water Temple Song Of Time Pit Room"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_DARK_LINK_ROOM: always
        RR_WATER_TEMPLE_RIVER:          is_child() or can_use(RG_SONG_OF_TIME)
    }
}

region RR_WATER_TEMPLE_RIVER {
    name: "Water Temple River"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        #it is possible with persistence for adult to make it past the final whirlpool with only irons and climb to the pots,
        #but the collision around there is very janky and loves making you slide back down.
        #combined with the drowning time pressure this is a trick.
        #For best results walk to the right of the seam pointing to the pots, then move left to try and cross it at the very top.
        RR_WATER_TEMPLE_RIVER_POTS: (can_use(RG_IRON_BOOTS) and water_timer() >= 32 and can_use(RG_LONGSHOT)) or has(RG_BRONZE_SCALE)
    }
}

region RR_WATER_TEMPLE_RIVER_POTS {
    name: "Water Temple River Pots"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        #Child can enter the water without jumping to have just enough time to make it with just swim, but it's a trick
        RR_WATER_TEMPLE_ABOVE_DRAGON: can_hit_eye_targets() and (is_adult() or can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT))
        RR_WATER_TEMPLE_RIVER:        can_use(RG_IRON_BOOTS) and has(RG_BRONZE_SCALE)
    }
}

region RR_WATER_TEMPLE_ABOVE_DRAGON {
    name: "Water Temple Above Dragon"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_DRAGON_ROOM: has(RG_BRONZE_SCALE) or can_use(RG_LONGSHOT) or (is_adult() and can_use(RG_HOVER_BOOTS) and can_jumpslash())
    }
}

region RR_WATER_TEMPLE_RISING_TARGET_LEDGE {
    name: "Water Temple Rising Target Ledge"
    scene: SCENE_WATER_TEMPLE
    
    events {
        LOGIC_FAIRY_ACCESS:       can_break_pots()
        LOGIC_WATER_COULD_MIDDLE: water_rising_target_to_3f_central() and (has_fire_source_with_torch() or can_use(RG_FAIRY_BOW))
    }
    
    exits {
        #As you cannot change the water level from here, we must be able to make the drop on any water level
        #Bronze scale does this alone thanks to the nearby pond cancelling fall damage
        #otherwise we need irons for high level and taking damage for low
        RR_WATER_TEMPLE_MAIN:          has(RG_BRONZE_SCALE) or (can_use(RG_IRON_BOOTS) and take_damage())
        RR_WATER_TEMPLE_3F_CENTRAL_A:  water_rising_target_to_3f_central()
        RR_WATER_TEMPLE_3F_CENTRAL_H:  water_rising_target_to_3f_central() and water_level(WL_HIGH)
        RR_WATER_TEMPLE_3F_CENTRAL_LM: water_rising_target_to_3f_central() and water_level(WL_LOW_OR_MID)
        #Assumes RR_WATER_TEMPLE_3F_CENTRAL, RR_WATER_TEMPLE_HIGH_EMBLEM and RR_WATER_TEMPLE_2F_CENTRAL access
        RR_WATER_TEMPLE_PILLAR_H:      trick(RT_WATER_IRONS_CENTRAL_GS) and can_use(RG_FIRE_ARROWS) and water_rising_target_to_3f_central()
        RR_WATER_TEMPLE_TRAPPED_SLOPE: always
    }
}

region RR_WATER_TEMPLE_TRAPPED_SLOPE {
    name: "Water Temple Trapped Slope"
    scene: SCENE_WATER_TEMPLE
    
    exits {
        RR_WATER_TEMPLE_RISING_TARGET_LEDGE: always
        RR_WATER_TEMPLE_BOSS_ENTRYWAY:       always
    }
}