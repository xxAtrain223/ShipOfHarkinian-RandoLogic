            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RR_DMC_ROCK_GROTTO:
            (fire_timer() >= 32 or hearts() >= 6) and can_climb_ladder() or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RR_DMC_CRACKED_WALL:
            (fire_timer() >= 32 or hearts() >= 6) and can_climb_ladder() or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RR_DMC_SCRUB:           fire_timer() >= 16 or hearts() >= 3
        RR_DMC_BLOCKED_EXIT:    fire_timer() >= 8 or hearts() >= 2
        RR_DMC_POTS:            always
        RR_DMC_POT_GROTTO_EXIT: fire_timer() >= 8 or hearts() >= 2
        RR_DMC_CENTRAL:
            ((fire_timer() >= 32 or hearts() >= 6) and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 56 or hearts() >= 11) and take_damage() and trick(RT_UNINTUITIVE_JUMPS) and reach_distant_scarecrow() and can_climb_ladder())
        RR_DMC_FAR_PLATFORM:
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad() and reach_distant_scarecrow()) or
            ((fire_timer() >= 32 or hearts() >= 6) and take_damage() and trick(RT_UNINTUITIVE_JUMPS) and can_climb_ladder())
        RR_DMC_TEMPLE_EXIT:
            ((fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 56 or hearts() >= 11) and take_damage() and trick(RT_UNINTUITIVE_JUMPS) and reach_distant_scarecrow() and can_climb_ladder())
    }
}

region RR_DMC_POT_GROTTO_ENTRY {
    name: "DMC Pot Grotto Entry"
    scene: SCENE_DEATH_MOUNTAIN_CRATER

    locations {
        RC_DMC_WALL_FREESTANDING_POH:
            (fire_timer() >= 40 or hearts() >= 8) and can_climb_ladder() or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RC_DMC_VOLCANO_FREESTANDING_POH:
            (fire_timer() >= 16 or hearts() >= 3) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) or
