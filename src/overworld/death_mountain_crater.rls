            (is_adult() and (fire_timer() >= 32 or hearts() >= 6) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL))
    }

    exits {
