# Notes for calculating timers:
#   - RT_DMC_BOLERO_JUMP takes about 16 seconds to perform.
#   - RT_DMC_BOULDER_SKIP assumes a setup that takes 14 seconds to fully execute.
#   - Spawning and killing the bean skull takes around 10 seconds, as does getting the bean sprout,
#     as does getting the rupees on the near plank platform, but as it's child only it does not
#     stack with RT_DMC_BOLERO_JUMP or RT_DMC_BOULDER_SKIP.
#   - Whatever number of hearts is used for Fewer Tunic Requirements, the default time check is
#     that +50%, rounded up. This applies to both adult and child.
#   - All child only checks must be possible with 3 hearts, or minimal item pool breaks.
#   - Pot Grotto is separate but Rocks Grotto is not, because it needs a different amount of hearts
#     to reach the blocked exit, which will matter with mods.
# RANDOTODO: when randomised entrances can be in more than 1 region, make it so the player can
# always turn around and go back the way they came.

region RR_DMC_UPPER_ENTRY {
    name: "DMC Upper Entry"
    scene: SCENE_DEATH_MOUNTAIN_CRATER

    locations {
        RC_DMC_WALL_FREESTANDING_POH: fire_timer() >= 16 or hearts() >= 3
        RC_DMC_VOLCANO_FREESTANDING_POH:
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS)) or
            (is_adult() and (fire_timer() >= 56 or hearts() >= 11) and dmc_pots_to_pad() and dmc_upper_to_pots() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL))
    }

    exits {
        RR_DMC_CRATE:        always
        RR_DMC_ROCK_GROTTO:  fire_timer() >= 8 or hearts() >= 2
        RR_DMC_CRACKED_WALL: fire_timer() >= 16 or hearts() >= 3
        RR_DMC_SCRUB:        fire_timer() >= 16 or hearts() >= 3
        RR_DMC_BLOCKED_EXIT:
            ((fire_timer() >= 24 or hearts() >= 5) and dmc_upper_to_pots()) or
            (is_adult() and (fire_timer() >= 56 or hearts() >= 11) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_POTS:
            ((fire_timer() >= 32 or hearts() >= 6) and dmc_upper_to_pots()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_POT_GROTTO_EXIT:
            ((fire_timer() >= 32 or hearts() >= 6) and dmc_upper_to_pots()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_CENTRAL:
            ((fire_timer() >= 64 or hearts() >= 12) and dmc_upper_to_pots() and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_FAR_PLATFORM:
            (is_adult() and (fire_timer() >= 72 or hearts() >= 14) and dmc_upper_to_pots() and dmc_pots_to_pad() and reach_distant_scarecrow()) or
            (fire_timer() >= 24 or hearts() >= 5) and take_damage() and trick(RT_UNINTUITIVE_JUMPS)
        RR_DMC_TEMPLE_EXIT:
            ((fire_timer() >= 72 or hearts() >= 14) and dmc_upper_to_pots() and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
    }
}

region RR_DMC_ROCKS_GROTTO_ENTRY {
    name: "DMC Rocks Grotto Entry"
    scene: SCENE_DEATH_MOUNTAIN_CRATER

    locations {
        RC_DMC_WALL_FREESTANDING_POH: fire_timer() >= 8 or hearts() >= 2
        RC_DMC_VOLCANO_FREESTANDING_POH:
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS)) or
            (is_adult() and (fire_timer() >= 64 or hearts() >= 12) and dmc_pots_to_pad() and dmc_upper_to_pots() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL))
    }

    exits {
        RR_DMC_CRATE:        fire_timer() >= 8 or hearts() >= 2
        RR_DMC_ROCK_GROTTO:  always
        RR_DMC_CRACKED_WALL: fire_timer() >= 16 or hearts() >= 3
        RR_DMC_SCRUB:        fire_timer() >= 16 or hearts() >= 3
        RR_DMC_BLOCKED_EXIT:
            ((fire_timer() >= 32 or hearts() >= 6) and dmc_upper_to_pots()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_POTS:
            ((fire_timer() >= 32 or hearts() >= 6) and dmc_upper_to_pots()) or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_POT_GROTTO_EXIT:
            ((fire_timer() >= 40 or hearts() >= 8) and dmc_upper_to_pots()) or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_CENTRAL:
            ((fire_timer() >= 64 or hearts() >= 12) and dmc_upper_to_pots() and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 3) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
        RR_DMC_FAR_PLATFORM:
            (is_adult() and (fire_timer() >= 72 or hearts() >= 14) and dmc_upper_to_pots() and dmc_pots_to_pad() and reach_distant_scarecrow()) or
            (fire_timer() >= 16 or hearts() >= 3) and take_damage() and trick(RT_UNINTUITIVE_JUMPS)
        RR_DMC_TEMPLE_EXIT:
            ((fire_timer() >= 64 or hearts() >= 12) and dmc_upper_to_pots() and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 3) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS))
    }
}

region RR_DMC_BLOCKED_ENTRY {
    name: "DMC Blocked Entry"
    scene: SCENE_DEATH_MOUNTAIN_CRATER

    locations {
        RC_DMC_WALL_FREESTANDING_POH:
            ((fire_timer() >= 24 or hearts() >= 5) and can_climb_ladder()) or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RC_DMC_VOLCANO_FREESTANDING_POH:
            ((fire_timer() >= 16 or hearts() >= 3) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS)) or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL))
    }

    exits {
        RR_DMC_CRATE:
            ((fire_timer() >= 24 or hearts() >= 5) and can_climb_ladder()) or
            (is_adult() and (fire_timer() >= 56 or hearts() >= 11) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RR_DMC_ROCK_GROTTO:
            ((fire_timer() >= 24 or hearts() >= 5) and can_climb_ladder()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RR_DMC_CRACKED_WALL:
            (fire_timer() >= 32 or hearts() >= 6) and can_climb_ladder() or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 32 or hearts() >= 6) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
        RR_DMC_SCRUB:           fire_timer() >= 8 or hearts() >= 2
        RR_DMC_BLOCKED_EXIT:    always
        RR_DMC_POTS:            fire_timer() >= 8 or hearts() >= 2
        RR_DMC_POT_GROTTO_EXIT: fire_timer() >= 16 or hearts() >= 3
        RR_DMC_CENTRAL:
            ((fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and reach_distant_scarecrow() and take_damage() and trick(RT_UNINTUITIVE_JUMPS) and can_climb_ladder())
        RR_DMC_FAR_PLATFORM:
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and dmc_pots_to_pad() and reach_distant_scarecrow()) or
            ((fire_timer() >= 32 or hearts() >= 6) and take_damage() and trick(RT_UNINTUITIVE_JUMPS) and can_climb_ladder()) or
            (is_adult() and (fire_timer() >= 48 or hearts() >= 9) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 32 or hearts() >= 6) and take_damage() and trick(RT_UNINTUITIVE_JUMPS) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS))
        RR_DMC_TEMPLE_EXIT:
            ((fire_timer() >= 48 or hearts() >= 9) and dmc_pots_to_pad()) or
            (is_adult() and (fire_timer() >= 56 or hearts() >= 11) and take_damage() and trick(RT_UNINTUITIVE_JUMPS) and reach_distant_scarecrow() and can_climb_ladder())
    }
}

region RR_DMC_POTS_ENTRY {
    name: "DMC Pots Entry"
    scene: SCENE_DEATH_MOUNTAIN_CRATER

    locations {
        RC_DMC_WALL_FREESTANDING_POH:
            (fire_timer() >= 40 or hearts() >= 8) and can_climb_ladder() or
            (is_adult() and (fire_timer() >= 40 or hearts() >= 8) and dmc_pots_to_pad() and can_plant_bean(RR_DMC_CENTRAL, RG_DEATH_MOUNTAIN_CRATER_BEAN_SOUL)) or
            ((fire_timer() >= 24 or hearts() >= 5) and trick(RT_DMC_HOVER_BEAN_POH) and can_use(RG_HOVER_BOOTS) and can_use(RG_LONGSHOT))
