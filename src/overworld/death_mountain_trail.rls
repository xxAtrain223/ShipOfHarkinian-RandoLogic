region RR_DEATH_MOUNTAIN_TRAIL {
    name: "Death Mountain Trail"
    scene: SCENE_DEATH_MOUNTAIN_TRAIL

    events {
        LOGIC_PLANT_DEATH_MOUNTAIN_TRAIL_BEAN: can_plant_bean(RG_DEATH_MOUNTAIN_TRAIL_BEAN_SOUL) and (has_explosives() or has(RG_GORONS_BRACELET))
        LOGIC_FAIRY_ACCESS:                    is_child() and bean_planted(LOGIC_PLANT_DEATH_MOUNTAIN_TRAIL_BEAN) and can_use(RG_SONG_OF_STORMS) and
                                               (has_explosives() or has(RG_GORONS_BRACELET))
    }

    locations {
        # adult and bunny jump off the nearby ledge and over the fence
        RC_DMT_FREESTANDING_POH: is_adult() or take_damage() or can_use(RG_HOVER_BOOTS) or bunny_hood()
    }

    exits {
        RR_KAK_BEHIND_GATE:          always
        RR_GORON_CITY:               always
        RR_DEATH_MOUNTAIN_ROCKFALL:  any_age(blast_or_smash()) or
                                     (is_adult() and
                                     ((bean_planted(LOGIC_PLANT_DEATH_MOUNTAIN_TRAIL_BEAN) and has(RG_GORONS_BRACELET)) or
                                     (can_use(RG_HOVER_BOOTS) and trick(RT_DMT_CLIMB_HOVERS))))
        RR_DODONGOS_CAVERN_ENTRYWAY: has_explosives() or has(RG_GORONS_BRACELET) or is_adult()
        RR_DMT_STORMS_GROTTO:        can_open_storms_grotto()
    }
}

region RR_DEATH_MOUNTAIN_ROCKFALL {
    name: "Death Mountain Rockfall"
    scene: SCENE_DEATH_MOUNTAIN_TRAIL

    exits {
        RR_DEATH_MOUNTAIN_TRAIL:  always
        # bunny keeps you ahead of the aimed boulders, but random boulders ahead become unavoidable
        # because the aimed boulders catch you if you change course
        RR_DEATH_MOUNTAIN_SUMMIT: has(RG_CLIMB) and
                                  (is_adult() or trick(RT_DMT_SHIELDLESS_CLIMB) or has(RG_HYLIAN_SHIELD) or can_use(RG_NAYRUS_LOVE))
        RR_DMT_COW_GROTTO:        any_age(blast_or_smash())
    }
}

region RR_DEATH_MOUNTAIN_SUMMIT {
    name: "Death Mountain Summit"
    scene: SCENE_DEATH_MOUNTAIN_TRAIL

    events {
        LOGIC_FAIRY_ACCESS: call_gossip_fairy()
        LOGIC_BUG_ACCESS:   is_child() and has(RG_POWER_BRACELET)
    }

    locations {
        RC_DMT_TRADE_CLAIM_CHECK: is_adult() and can_use(RG_CLAIM_CHECK)
    }

    exits {
        RR_DEATH_MOUNTAIN_ROCKFALL:  always
        RR_DMC_UPPER_ENTRY:          always
        RR_DMT_OWL_FLIGHT:           is_child() and
                                     (has(RG_SPEAK_DEKU) or has(RG_SPEAK_GERUDO) or has(RG_SPEAK_GORON) or
                                     has(RG_SPEAK_KOKIRI) or has(RG_SPEAK_HYLIAN) or has(RG_SPEAK_ZORA))
        RR_DMT_GREAT_FAIRY_FOUNTAIN: any_age(blast_or_smash())
    }
}

region RR_DMT_OWL_FLIGHT {
    name: "DMT Owl Flight"
    scene: SCENE_DEATH_MOUNTAIN_TRAIL

    exits {
        RR_KAK_IMPAS_ROOFTOP: always
    }
}

region RR_DMT_COW_GROTTO {
    name: "DMT Cow Grotto"
    scene: SCENE_GROTTOS

    exits {
        RR_DEATH_MOUNTAIN_ROCKFALL: always
    }
}

region RR_DMT_STORMS_GROTTO {
    name: "DMT Storms Grotto"
    scene: SCENE_GROTTOS

    events {
        LOGIC_FAIRY_ACCESS: call_gossip_fairy() or can_use(RG_STICKS)
        LOGIC_BUG_ACCESS:   can_cut_shrubs()
        LOGIC_FISH_ACCESS:  always
    }

    exits {
        RR_DEATH_MOUNTAIN_TRAIL: always
    }
}

region RR_DMT_GREAT_FAIRY_FOUNTAIN {
    name: "DMT Great Fairy Fountain"
    scene: SCENE_GREAT_FAIRYS_FOUNTAIN_MAGIC

    locations {
        RC_DMT_GREAT_FAIRY_REWARD: can_use(RG_ZELDAS_LULLABY)
    }

    exits {
        RR_DEATH_MOUNTAIN_SUMMIT: always
    }
}
