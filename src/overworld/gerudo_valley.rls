region RR_GERUDO_VALLEY {
    name: "Gerudo Valley"
    scene: SCENE_GERUDO_VALLEY
    
    events {
        LOGIC_BUG_ACCESS: is_child() and has(RG_POWER_BRACELET)
    }
    
    exits {
        RR_HYRULE_FIELD:          always
        RR_GV_UPPER_STREAM:       (is_child() and has(RG_POWER_BRACELET)) or take_damage()
        RR_GV_UPPER_STREAM_WATER: always
        RR_GV_CRATE_LEDGE:        (is_child() and has(RG_POWER_BRACELET)) or can_use(RG_LONGSHOT)
        RR_GV_GROTTO_LEDGE:       always
        # bunnyhovers need to aim for the sides of the bridge
        # you can sword recoil off a boulder, but breaking it is a perm flag and it's precise
        RR_GV_FORTRESS_SIDE:      (is_adult() and (summon_epona() or can_use(RG_LONGSHOT) or flag(LOGIC_TH_RESCUED_ALL_CARPENTERS) or
                                    can_recoil_hover(RECOIL_HAMMER) or (bunny_hovers() and has(RG_CLIMB)))) or ((is_child() or
                                    trick(RT_GV_HOOKSHOT_BRIDGE)) and can_use(RG_HOOKSHOT)) or (is_child() and trick(RT_GV_CHILD_CUCCO_JUMP) and
                                   has(RG_POWER_BRACELET) and can_jumpslash())
        RR_GV_WATERFALL_ALCOVE:   is_child() and has(RG_POWER_BRACELET)
        RR_GV_LOWER_STREAM:       is_child() and has(RG_POWER_BRACELET)
    }
}

region RR_GV_UPPER_STREAM {
    name: "GV Upper Stream"
    scene: SCENE_GERUDO_VALLEY
    
    events {
        LOGIC_PLANT_GERUDO_VALLEY_BEAN: can_plant_bean(RG_GERUDO_VALLEY_BEAN_SOUL)
        LOGIC_FAIRY_ACCESS:             call_gossip_fairy() or (is_child() and bean_planted(LOGIC_PLANT_GERUDO_VALLEY_BEAN) and can_use(RG_SONG_OF_STORMS))
    }
    
    exits {
        RR_GV_UPPER_STREAM_WATER: always
        RR_GV_WATERFALL_ALCOVE:   (can_use(RG_LONGSHOT) and (has(RG_CLIMB) or trick(RT_HOOKSHOT_LADDERS))) or
                                  bean_planted(LOGIC_PLANT_GERUDO_VALLEY_BEAN)
    }
}

region RR_GV_UPPER_STREAM_WATER {
    name: "GV Upper Stream Water"
    scene: SCENE_GERUDO_VALLEY
    
    exits {
        RR_GV_UPPER_STREAM:     has(RG_BRONZE_SCALE)
        RR_GV_LOWER_STREAM:     has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS)
        RR_GV_WATERFALL_ALCOVE: (has(RG_BRONZE_SCALE) or (can_use(RG_IRON_BOOTS) and can_use(RG_HOOKSHOT))) and has(RG_CLIMB)
    }
}

region RR_GV_LOWER_STREAM {
    name: "GV Lower Stream"
    scene: SCENE_GERUDO_VALLEY
    
    exits {
        RR_LAKE_HYLIA: always
    }
}

region RR_GV_WATERFALL_ALCOVE {
    name: "GV Waterfall Alcove"
    scene: SCENE_GERUDO_VALLEY
    
    exits {
        RR_GV_UPPER_STREAM:       is_adult() and can_use(RG_HOVER_BOOTS)
        RR_GV_UPPER_STREAM_WATER: always
    }
}

region RR_GV_GROTTO_LEDGE {
    name: "GV Grotto Ledge"
    scene: SCENE_GERUDO_VALLEY
    
    exits {
        RR_GV_UPPER_STREAM:   can_megadive() or (((bunny_hovers() and can_jumpslash()) or can_recoil_hover(RECOIL_HAMMER)) and take_damage())
        RR_GV_LOWER_STREAM:   has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_megadive(false)
        RR_GV_OCTOROK_GROTTO: can_use(RG_SILVER_GAUNTLETS)
        RR_GV_CRATE_LEDGE:    can_use(RG_LONGSHOT) or can_recoil_hover_from_actor(ARECOIL_SHORT)
    }
}

region RR_GV_CRATE_LEDGE {
    name: "GV Crate Ledge"
    scene: SCENE_GERUDO_VALLEY
    
    exits {
        RR_GV_UPPER_STREAM: can_megadive()
        RR_GV_LOWER_STREAM: has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_megadive(false)
    }
}

region RR_GV_FORTRESS_SIDE {
    name: "GV Fortress Side"
    scene: SCENE_GERUDO_VALLEY
    
    exits {
        RR_GF_OUTSKIRTS:          always
        RR_GV_UPPER_STREAM:       take_damage()
        RR_GV_UPPER_STREAM_WATER: always
        RR_GERUDO_VALLEY:         is_child() or summon_epona() or can_use(RG_LONGSHOT) or flag(LOGIC_TH_RESCUED_ALL_CARPENTERS) or
                                  can_recoil_hover(RECOIL_HAMMER) or (bunny_hovers() and has(RG_CLIMB))
        RR_GV_CARPENTER_TENT:     is_adult() or trick(RT_GV_CHILD_TENT)
        RR_GV_STORMS_GROTTO:      is_adult() and can_open_storms_grotto()
        RR_GV_GROTTO_LEDGE:       can_megadive()
        RR_GV_CRATE_LEDGE:        can_megadive() or (trick(RT_GV_CRATE_HOVERS) and take_damage() and can_use(RG_HOVER_BOOTS) and
                                   (can_use(RG_MASTER_SWORD) or can_use(RG_BIGGORON_SWORD)))
    }
}

region RR_GV_CARPENTER_TENT {
    name: "GV Carpenter Tent"
    scene: SCENE_CARPENTERS_TENT
    
    exits {
        RR_GV_FORTRESS_SIDE: always
    }
}

region RR_GV_OCTOROK_GROTTO {
    name: "GV Octorok Grotto"
    scene: SCENE_GROTTOS
    
    exits {
        RR_GV_GROTTO_LEDGE: always
    }
}

region RR_GV_STORMS_GROTTO {
    name: "GV Storms Grotto"
    scene: SCENE_GROTTOS
    
    exits {
        RR_GV_FORTRESS_SIDE: always
    }
}