region RR_THE_GRAVEYARD {
    name: "The Graveyard"
    scene: SCENE_GRAVEYARD

    events {
        LOGIC_FAIRY_ACCESS: (at_day() and can_use(RG_STICKS)) or (is_child() and can_use(RG_MAGIC_BEAN) and can_use(RG_SONG_OF_STORMS))
        LOGIC_BUG_ACCESS: has(RG_POWER_BRACELET)
        LOGIC_BORROW_BUNNY_HOOD: is_child() and at_day() and flag(LOGIC_BORROW_SPOOKY_MASK) and has(RG_CHILD_WALLET) and has(RG_SPEAK_HYLIAN)
    }

    locations {
        RC_GRAVEYARD_FREESTANDING_POH:
            (((is_adult() and can_plant_bean(RR_THE_GRAVEYARD, RG_GRAVEYARD_BEAN_SOUL)) or can_use(RG_LONGSHOT)) and can_break_crates()) or
            (trick(RT_GY_POH) and can_use(RG_BOOMERANG))
        RC_GRAVEYARD_DAMPE_GRAVEDIGGING_TOUR: has(RG_CHILD_WALLET) and has(RG_SPEAK_HYLIAN) and is_child() and at_night()
    }

    exits {
        RR_GRAVEYARD_SHIELD_GRAVE: (is_adult() or at_night()) and has(RG_POWER_BRACELET)
        RR_GRAVEYARD_COMPOSERS_GRAVE: can_use(RG_ZELDAS_LULLABY)
        RR_GRAVEYARD_HEART_PIECE_GRAVE: (is_adult() or at_night()) and has(RG_POWER_BRACELET)
        RR_GRAVEYARD_DAMPES_GRAVE: is_adult() and has(RG_POWER_BRACELET)
        RR_GRAVEYARD_DAMPES_HOUSE: is_adult() and can_open_overworld_door(RG_DAMPES_HUT_KEY)
        RR_KAKARIKO_VILLAGE: always
        RR_GRAVEYARD_WARP_PAD_REGION: never
    }
}

region RR_GRAVEYARD_SHIELD_GRAVE {
    name: "Graveyard Shield Grave"
    scene: SCENE_GRAVE_WITH_FAIRYS_FOUNTAIN

    exits {
        RR_THE_GRAVEYARD: always
        RR_GRAVEYARD_SHIELD_GRAVE_BACK: any_age(can_break_mud_walls())
    }
}

region RR_GRAVEYARD_SHIELD_GRAVE_BACK {
    name: "Graveyard Shield Grave Back"
    scene: SCENE_GRAVE_WITH_FAIRYS_FOUNTAIN

    exits {
        RR_GRAVEYARD_SHIELD_GRAVE: always
    }
}

region RR_GRAVEYARD_HEART_PIECE_GRAVE {
    name: "Graveyard Heart Piece Grave"
    scene: SCENE_REDEAD_GRAVE

    exits {
        RR_THE_GRAVEYARD: always
    }
}

region RR_GRAVEYARD_COMPOSERS_GRAVE {
    name: "Graveyard Composers Grave"
    scene: SCENE_ROYAL_FAMILYS_TOMB

    locations {
        RC_SONG_FROM_ROYAL_FAMILYS_TOMB: can_use_projectile() or can_jumpslash()
    }

    exits {
        RR_THE_GRAVEYARD: always
    }
}

region RR_GRAVEYARD_DAMPES_GRAVE {
    name: "Graveyard Dampes Grave"
    scene: SCENE_WINDMILL_AND_DAMPES_GRAVE

    events {
        LOGIC_NUT_ACCESS: can_break_pots()
    }

    locations {
        RC_GRAVEYARD_DAMPE_RACE_FREESTANDING_POH: (is_adult() or trick(RT_GY_CHILD_DAMPE_RACE_POH)) and has(RG_SPEAK_HYLIAN)
    }

    exits {
        RR_THE_GRAVEYARD: always
        RR_KAK_WINDMILL_UPPER: (is_adult() and can_use(RG_SONG_OF_TIME)) or (is_child() and can_ground_jump())
    }
}

region RR_GRAVEYARD_DAMPES_HOUSE {
    name: "Graveyard Dampes House"
    scene: SCENE_GRAVEKEEPERS_HUT

    exits {
        RR_THE_GRAVEYARD: always
    }
}

region RR_GRAVEYARD_WARP_PAD_REGION {
    name: "Graveyard Warp Pad Region"
    scene: SCENE_GRAVEYARD

    events {
        LOGIC_FAIRY_ACCESS: call_gossip_fairy_except_suns()
    }

    exits {
        RR_THE_GRAVEYARD: always
        RR_SHADOW_TEMPLE_ENTRYWAY: can_use(RG_DINS_FIRE) or (trick(RT_GY_SHADOW_FIRE_ARROWS) and is_adult() and can_use(RG_FIRE_ARROWS))
    }
}
