extend region RR_ROOT {
    events {
        LOGIC_TH_COULD_FREE_1_TORCH_CARPENTER:     setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FREE
        LOGIC_TH_COULD_FREE_DOUBLE_CELL_CARPENTER: setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FREE or setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FAST
        LOGIC_TH_COULD_FREE_DEAD_END_CARPENTER:    setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FREE or setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FAST
        LOGIC_TH_COULD_FREE_SLOPE_CARPENTER:       setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FREE or setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FAST
        LOGIC_TH_RESCUED_ALL_CARPENTERS:           setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_FREE
    }
}

# When Thieves' Hideout entrances are shuffled, getting caught by guards should behave like void outs to avoid logic headaches.

region RR_TH_1_TORCH_CELL {
    name: "Thieves Hideout 1 Torch Cell"
    scene: SCENE_THIEVES_HIDEOUT

    events {
        LOGIC_TH_COULD_FREE_1_TORCH_CARPENTER: can_kill(RE_GERUDO_WARRIOR) and has(RG_SPEAK_HYLIAN)
        LOGIC_TH_RESCUED_ALL_CARPENTERS:       small_keys(SCENE_THIEVES_HIDEOUT, setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_NORMAL ? 4 : 1) and
                                               flag(LOGIC_TH_COULD_FREE_1_TORCH_CARPENTER) and flag(LOGIC_TH_COULD_FREE_DOUBLE_CELL_CARPENTER) and
                                               flag(LOGIC_TH_COULD_FREE_DEAD_END_CARPENTER) and flag(LOGIC_TH_COULD_FREE_SLOPE_CARPENTER)
    }

    locations {
        RC_TH_1_TORCH_CARPENTER: can_kill(RE_GERUDO_WARRIOR)
        RC_TH_FREED_CARPENTERS:  flag(LOGIC_TH_RESCUED_ALL_CARPENTERS)
    }

    exits {
        RR_GF_OUTSKIRTS:   always
        RR_GF_NEAR_GROTTO: always
    }
}

region RR_TH_DOUBLE_CELL {
    name: "Thieves Hideout Double Cell"
    scene: SCENE_THIEVES_HIDEOUT

    events {
        LOGIC_TH_COULD_FREE_DOUBLE_CELL_CARPENTER: can_kill(RE_GERUDO_WARRIOR) and has(RG_SPEAK_HYLIAN)
        LOGIC_TH_RESCUED_ALL_CARPENTERS:           small_keys(SCENE_THIEVES_HIDEOUT, setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_NORMAL ? 4 : 1) and
                                                   flag(LOGIC_TH_COULD_FREE_1_TORCH_CARPENTER) and flag(LOGIC_TH_COULD_FREE_DOUBLE_CELL_CARPENTER) and
                                                   flag(LOGIC_TH_COULD_FREE_DEAD_END_CARPENTER) and flag(LOGIC_TH_COULD_FREE_SLOPE_CARPENTER)
    }

    locations {
        RC_TH_DOUBLE_CELL_CARPENTER: can_kill(RE_GERUDO_WARRIOR)
        RC_TH_FREED_CARPENTERS:      flag(LOGIC_TH_RESCUED_ALL_CARPENTERS)
    }

    exits {
        RR_GF_OUTSKIRTS:          always
        RR_GF_ABOVE_GTG:          always
        RR_GF_TOP_OF_LOWER_VINES: always
    }
}

region RR_TH_DEAD_END_CELL {
    name: "Thieves Hideout Dead End Cell"
    scene: SCENE_THIEVES_HIDEOUT

    events {
        LOGIC_TH_COULD_FREE_DEAD_END_CARPENTER: can_kill(RE_GERUDO_WARRIOR) and has(RG_SPEAK_HYLIAN)
        LOGIC_TH_RESCUED_ALL_CARPENTERS:        small_keys(SCENE_THIEVES_HIDEOUT, setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_NORMAL ? 4 : 1) and
                                                flag(LOGIC_TH_COULD_FREE_1_TORCH_CARPENTER) and flag(LOGIC_TH_COULD_FREE_DOUBLE_CELL_CARPENTER) and
                                                flag(LOGIC_TH_COULD_FREE_DEAD_END_CARPENTER) and flag(LOGIC_TH_COULD_FREE_SLOPE_CARPENTER)
    }

    locations {
        RC_TH_DEAD_END_CARPENTER: can_kill(RE_GERUDO_WARRIOR)
        RC_TH_FREED_CARPENTERS:   flag(LOGIC_TH_RESCUED_ALL_CARPENTERS)
    }

    exits {
        RR_GF_BELOW_GS: always
    }
}

region RR_TH_STEEP_SLOPE_CELL {
    name: "Thieves Hideout Steep Slope Cell"
    scene: SCENE_THIEVES_HIDEOUT

    events {
        LOGIC_TH_COULD_FREE_SLOPE_CARPENTER: can_kill(RE_GERUDO_WARRIOR) and has(RG_SPEAK_HYLIAN)
        LOGIC_TH_RESCUED_ALL_CARPENTERS:     small_keys(SCENE_THIEVES_HIDEOUT, setting(RSK_GERUDO_FORTRESS) is RO_GF_CARPENTERS_NORMAL ? 4 : 1) and
                                             flag(LOGIC_TH_COULD_FREE_1_TORCH_CARPENTER) and flag(LOGIC_TH_COULD_FREE_DOUBLE_CELL_CARPENTER) and
                                             flag(LOGIC_TH_COULD_FREE_DEAD_END_CARPENTER) and flag(LOGIC_TH_COULD_FREE_SLOPE_CARPENTER)
    }

    locations {
        RC_TH_STEEP_SLOPE_CARPENTER: can_kill(RE_GERUDO_WARRIOR)
        RC_TH_FREED_CARPENTERS:      flag(LOGIC_TH_RESCUED_ALL_CARPENTERS)
    }

    exits {
        RR_GF_BOTTOM_OF_LOWER_VINES: always
        RR_GF_NEAR_GROTTO:           always
    }
}

region RR_TH_KITCHEN_CORRIDOR {
    name: "Thieves Hideout Kitchen Corridor"
    scene: SCENE_THIEVES_HIDEOUT

    exits {
        RR_GF_NEAR_GROTTO:  always
        RR_GF_ABOVE_GTG:    always
        RR_TH_KITCHEN_MAIN: can_pass(RE_GERUDO_GUARD)
    }
}

region RR_TH_KITCHEN_MAIN {
    name: "Thieves Hideout Kitchen Bottom"
    scene: SCENE_THIEVES_HIDEOUT

    exits {
        RR_TH_KITCHEN_CORRIDOR:          can_pass(RE_GERUDO_GUARD)
        RR_TH_KITCHEN_BY_CORRIDOR:       can_pass(RE_GERUDO_GUARD)
        RR_TH_KITCHEN_OPPOSITE_CORRIDOR: can_pass(RE_GERUDO_GUARD)
    }
}

region RR_TH_KITCHEN_BY_CORRIDOR {
    name: "Thieves Hideout Kitchen Top By Corridor"
    scene: SCENE_THIEVES_HIDEOUT

    exits {
        RR_TH_KITCHEN_MAIN:              always
        # hookshot to cross using rafters implied by can_pass(RE_GERUDO_GUARD)
        RR_TH_KITCHEN_OPPOSITE_CORRIDOR: can_pass(RE_GERUDO_GUARD) or can_use(RG_HOVER_BOOTS)
        RR_GF_TOP_OF_LOWER_VINES:        always
    }
}

region RR_TH_KITCHEN_OPPOSITE_CORRIDOR {
    name: "Thieves Hideout Kitchen Top Across From Corridor"
    scene: SCENE_THIEVES_HIDEOUT

    exits {
        RR_TH_KITCHEN_MAIN:        always
        # hookshot to cross using rafters implied by can_pass(RE_GERUDO_GUARD)
        RR_TH_KITCHEN_BY_CORRIDOR: can_pass(RE_GERUDO_GUARD) or can_use(RG_HOVER_BOOTS)
        RR_GF_NEAR_GS:             always
    }
}

region RR_TH_BREAK_ROOM {
    name: "Thieves Hideout Break Room"
    scene: SCENE_THIEVES_HIDEOUT

    exits {
        RR_GF_BELOW_CHEST:         can_pass(RE_GERUDO_GUARD)
        # Implies can_pass(RE_GERUDO_GUARD)
        RR_TH_BREAK_ROOM_CORRIDOR: can_use(RG_HOOKSHOT)
    }
}

region RR_TH_BREAK_ROOM_CORRIDOR {
    name: "Thieves Hideout Break Room"
    scene: SCENE_THIEVES_HIDEOUT

    exits {
        RR_TH_BREAK_ROOM: can_use(RG_HOOKSHOT)
        RR_GF_ABOVE_JAIL: always
    }
}
