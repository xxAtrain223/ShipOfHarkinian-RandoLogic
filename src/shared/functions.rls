define has_projectile(age: HasProjectileAge):
	has_explosives() or
	(age is Child and (can_use(RG_FAIRY_SLINGSHOT) or can_use(RG_BOOMERANG))) or
	(age is Adult and (can_use(RG_HOOKSHOT) or can_use(RG_FAIRY_BOW))) or
	(age is Both and (can_use(RG_FAIRY_SLINGSHOT) or can_use(RG_BOOMERANG)) and (can_use(RG_HOOKSHOT) or can_use(RG_FAIRY_BOW))) or
	(age is Either and (can_use(RG_FAIRY_SLINGSHOT) or can_use(RG_BOOMERANG) or can_use(RG_HOOKSHOT) or can_use(RG_FAIRY_BOW)))

define has_boss_soul(item: Item):
	not setting(RSK_SHUFFLE_BOSS_SOULS) or
	match item {
		RG_GOHMA_SOUL or
		RG_KING_DODONGO_SOUL or
		RG_BARINADE_SOUL or
		RG_PHANTOM_GANON_SOUL or
		RG_VOLVAGIA_SOUL or
		RG_MORPHA_SOUL or
		RG_BONGO_BONGO_SOUL or
		RG_TWINROVA_SOUL: has(item)
		RG_GANON_SOUL: setting(RSK_SHUFFLE_BOSS_SOULS) is not RO_BOSS_SOULS_ON_PLUS_GANON or has(RG_GANON_SOUL)
		_: never
	}

define can_open_overworld_door(key: Item):
	not setting(RSK_LOCK_OVERWORLD_DOORS) or has(RG_SKELETON_KEY) or has(key)

define can_ground_jump(hasBombflower: Bool = false):
	trick(RT_GROUND_JUMP) and can_standing_shield() and (can_use(RG_BOMB_BAG) or (hasBombflower and has(RG_GORONS_BRACELET)))

define can_ground_jumpslash(hasBombflower: Bool = false):
	trick(RT_GROUND_JUMP_HARD) and can_standing_shield() and can_jumpslash() and
	(can_use(RG_BOMB_BAG) or (hasBombflower and has(RG_GORONS_BRACELET)))

define can_middair_ground_jump(hasBombflower: Bool = false):
	trick(RT_GROUND_JUMP_HARD) and can_standing_shield() and can_use(RG_HOVER_BOOTS) and
	(can_use(RG_BOMB_BAG) or (hasBombflower and has(RG_GORONS_BRACELET)))

define can_open_underwater_chest():
	trick(RT_OPEN_UNDERWATER_CHEST) and can_use(RG_IRON_BOOTS) and can_use(RG_HOOKSHOT) and has(RG_OPEN_CHEST)

# TODO CanDoGlitch is always false. Leaving this as never for now
define can_equip_swap(itemName: Item):
	never

define can_break_mud_walls():
	blast_or_smash() or (trick(RT_BLUE_FIRE_MUD_WALLS) and blue_fire())

define can_get_deku_baba_sticks():
	can_use_sword() or can_use(RG_BOOMERANG)

define can_get_deku_baba_nuts():
	can_jumpslash() or can_use(RG_FAIRY_SLINGSHOT) or can_use(RG_FAIRY_BOW) or has_explosives() or can_use(RG_DINS_FIRE)

define can_hit_eye_targets():
	can_use(RG_FAIRY_BOW) or can_use(RG_FAIRY_SLINGSHOT)

define can_detonate_bomb_flowers():
	can_use(RG_FAIRY_BOW) or has_explosives() or can_use(RG_DINS_FIRE)

define can_detonate_upright_bomb_flower():
	can_detonate_bomb_flowers() or has(RG_GORONS_BRACELET) or
	(trick(RT_BLUE_FIRE_MUD_WALLS) and can_use(RG_BOTTLE_WITH_BLUE_FIRE) and (effective_health() != 1 or can_use(RG_NAYRUS_LOVE)))

define can_hammer_recoil_hover(needShield: Bool):
	can_use(RG_HOVER_BOOTS) and trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_MEGATON_HAMMER) and
	(not needShield or can_standing_shield())

define water_3f_central_to_high_emblem():
	(is_adult() and (can_use(RG_HOVER_BOOTS) or
	(trick(RT_DAMAGE_BOOST_SIMPLE) and can_use(RG_BOMB_BAG) and take_damage()))) or
	can_middair_ground_jump() or (flag(LOGIC_WATER_SCARECROW) and can_use(RG_HOOKSHOT))

define water_rising_target_to_3f_central():
	can_use(RG_LONGSHOT) or
	(trick(RT_HOVER_BOOST_SIMPLE) and trick(RT_DAMAGE_BOOST_SIMPLE) and has_explosives() and can_use(RG_HOVER_BOOTS))

define water_level(level: WaterLevel):
	match level {
		WL_LOW: flag(LOGIC_WATER_LOW) or
			(flag(LOGIC_WATER_COULD_LOW_FROM_HIGH) and
			(flag(LOGIC_WATER_COULD_HIGH_FROM_MID) or flag(LOGIC_WATER_HIGH)) and can_use(RG_ZELDAS_LULLABY))
		WL_LOW_OR_MID: flag(LOGIC_WATER_LOW) or flag(LOGIC_WATER_MIDDLE) or
			((flag(LOGIC_WATER_COULD_LOW_FROM_HIGH) or flag(LOGIC_WATER_LOW)) and can_use(RG_ZELDAS_LULLABY))
		WL_MID: flag(LOGIC_WATER_MIDDLE) or
			(flag(LOGIC_WATER_LOW) and flag(LOGIC_WATER_COULD_MIDDLE)) or
			((flag(LOGIC_WATER_COULD_LOW_FROM_HIGH) or flag(LOGIC_WATER_COULD_LOW)) and
			flag(LOGIC_WATER_COULD_MIDDLE) and can_use(RG_ZELDAS_LULLABY))
		WL_HIGH: flag(LOGIC_WATER_HIGH) or
			(flag(LOGIC_WATER_COULD_HIGH_FROM_MID) and flag(LOGIC_WATER_COULD_MIDDLE))
		WL_HIGH_OR_MID: flag(LOGIC_WATER_MIDDLE) or flag(LOGIC_WATER_HIGH) or flag(LOGIC_WATER_COULD_MIDDLE)
	}

define has_bottle():
	bottle_count() >= 1

define can_use_sword():
	can_use(RG_KOKIRI_SWORD) or can_use(RG_MASTER_SWORD) or can_use(RG_BIGGORON_SWORD)

define can_jumpslash_except_hammer():
	can_use(RG_STICKS) or can_use_sword()

define can_jumpslash():
	can_jumpslash_except_hammer() or can_use(RG_MEGATON_HAMMER)

define can_clear_stalagmite():
	can_jumpslash() or has_explosives() or can_use(RG_GIANTS_KNIFE) or (trick(RT_ICE_STALAGMITE_HOOKSHOT) and can_use(RG_HOOKSHOT))

define can_hit_switch(distance: Distance = ED_CLOSE, inWater: Bool = false):
	match distance {
		ED_CLOSE or
		ED_SHORT_JUMPSLASH:        can_use(RG_KOKIRI_SWORD) or can_use(RG_MEGATON_HAMMER) or can_use(RG_GIANTS_KNIFE) or
		ED_MASTER_SWORD_JUMPSLASH: can_use(RG_MASTER_SWORD) or
		ED_LONG_JUMPSLASH:         can_use(RG_BIGGORON_SWORD) or can_use(RG_STICKS) or
		ED_BOMB_THROW:             (not inWater and can_use(RG_BOMB_BAG)) or
		ED_BOOMERANG:              can_use(RG_BOOMERANG) or
		ED_HOOKSHOT:               can_use(RG_HOOKSHOT) or can_use(RG_BOMBCHU_5) or
		ED_LONGSHOT:               can_use(RG_LONGSHOT) or
		ED_FAR:                    can_use(RG_FAIRY_SLINGSHOT) or can_use(RG_FAIRY_BOW)
	}

define can_damage():
	can_use(RG_FAIRY_SLINGSHOT) or can_jumpslash() or has_explosives() or can_use(RG_DINS_FIRE) or can_use(RG_FAIRY_BOW)

define can_attack():
	can_damage() or can_use(RG_BOOMERANG) or can_use(RG_HOOKSHOT)

define bombchu_refill():
	flag(LOGIC_BUY_BOMBCHUS) or flag(LOGIC_COULD_PLAY_BOWLING) or flag(LOGIC_CARPET_MERCHANT) or
	setting(RSK_ENABLE_BOMBCHU_DROPS) is RO_AMMO_DROPS_ON

define hookshot_or_boomerang():
	can_use(RG_HOOKSHOT) or can_use(RG_BOOMERANG)

define scarecrows_song():
	(setting(RSK_SKIP_SCARECROWS_SONG) and has(RG_FAIRY_OCARINA) and ocarina_buttons() >= 2) or
	(flag(LOGIC_CHILD_SCARECROW) and flag(LOGIC_ADULT_SCARECROW))

define blue_fire():
	can_use(RG_BOTTLE_WITH_BLUE_FIRE) or (setting(RSK_BLUE_FIRE_ARROWS) and can_use(RG_ICE_ARROWS))

define can_break_pots(distance: Distance = ED_CLOSE, wallOrFloor: Bool = true, inWater: Bool = false):
	match distance {
		ED_CLOSE:                  has(RG_POWER_BRACELET) or
		ED_SHORT_JUMPSLASH:        can_use(RG_KOKIRI_SWORD) or can_use(RG_MEGATON_HAMMER) or can_use(RG_GIANTS_KNIFE) or
		ED_MASTER_SWORD_JUMPSLASH: can_use(RG_MASTER_SWORD) or
		ED_LONG_JUMPSLASH:         can_use(RG_BIGGORON_SWORD) or can_use(RG_STICKS) or
		ED_BOMB_THROW:             (not inWater and can_use(RG_BOMB_BAG)) or
		ED_BOOMERANG:              can_use(RG_BOOMERANG) or
		ED_HOOKSHOT:               can_use(RG_HOOKSHOT) or
		ED_LONGSHOT:               can_use(RG_LONGSHOT) or
		ED_FAR:                    can_use(RG_FAIRY_SLINGSHOT) or can_use(RG_FAIRY_BOW)
	} or (wallOrFloor and can_use(RG_BOMBCHU_5))

define can_break_crates():
	always

define can_break_small_crates():
	can_jumpslash() or has_explosives() or has(RG_POWER_BRACELET)

define can_bonk_trees():
	always

define has_explosives():
	can_use(RG_BOMB_BAG) or can_use(RG_BOMBCHU_5)

define blast_or_smash():
	has_explosives() or can_use(RG_MEGATON_HAMMER)

define can_spawn_soil_skull(bean: Item):
	is_child() and can_use(RG_BOTTLE_WITH_BUGS) and has(bean)

define can_reflect_nuts():
	can_use(RG_DEKU_SHIELD) or (is_adult() and has(RG_HYLIAN_SHIELD))

define can_cut_shrubs():
	can_use(RG_KOKIRI_SWORD) or can_use(RG_BOOMERANG) or has_explosives() or can_use(RG_MASTER_SWORD) or
	can_use(RG_MEGATON_HAMMER) or can_use(RG_BIGGORON_SWORD) or can_use(RG_GIANTS_KNIFE) or
	has(RG_GORONS_BRACELET)

define can_stun_deku():
	can_attack() or can_use(RG_NUTS) or can_reflect_nuts()

define call_gossip_fairy_except_suns():
	can_use(RG_ZELDAS_LULLABY) or can_use(RG_EPONAS_SONG) or can_use(RG_SONG_OF_TIME)

define call_gossip_fairy():
	call_gossip_fairy_except_suns() or can_use(RG_SUNS_SONG)

define take_damage():
	can_use(RG_BOTTLE_WITH_FAIRY) or effective_health() != 1 or can_use(RG_NAYRUS_LOVE)

define can_open_bomb_grotto():
	blast_or_smash() and (has(RG_STONE_OF_AGONY) or trick(RT_GROTTOS_WITHOUT_AGONY))

define can_open_storms_grotto():
	can_use(RG_SONG_OF_STORMS) and (has(RG_STONE_OF_AGONY) or trick(RT_GROTTOS_WITHOUT_AGONY))

define can_get_night_time_gs():
	at_night() and (can_use(RG_SUNS_SONG) or not setting(RSK_SKULLS_SUNS_SONG))

define can_break_upper_beehives():
	hookshot_or_boomerang() or (trick(RT_BOMBCHU_BEEHIVES) and can_use(RG_BOMBCHU_5)) or
	(setting(RSK_SLINGBOW_BREAK_BEEHIVES) and (can_use(RG_FAIRY_BOW) or can_use(RG_FAIRY_SLINGSHOT)))

define can_break_lower_beehives():
	can_break_upper_beehives() or can_use(RG_BOMB_BAG)

define has_fire_source():
	can_use(RG_DINS_FIRE) or can_use(RG_FIRE_ARROWS)

define has_fire_source_with_torch():
	has_fire_source() or can_use(RG_STICKS)

define sunlight_arrows():
	setting(RSK_SUNLIGHT_ARROWS) and can_use(RG_LIGHT_ARROWS)

define trade_quest_step(rg: Item):
	not setting(RSK_SHUFFLE_ADULT_TRADE) and
	match rg {
		RG_POCKET_EGG:   has(RG_POCKET_EGG) or
		RG_COJIRO:       has(RG_COJIRO) or
		RG_ODD_MUSHROOM: has(RG_ODD_MUSHROOM) or
		RG_ODD_POTION:   has(RG_ODD_POTION) or
		RG_POACHERS_SAW: has(RG_POACHERS_SAW) or
		RG_BROKEN_SWORD: has(RG_BROKEN_SWORD) or
		RG_PRESCRIPTION: has(RG_PRESCRIPTION) or
		RG_EYEDROPS:     has(RG_EYEDROPS) or
		RG_CLAIM_CHECK:  has(RG_CLAIM_CHECK)
		_: never
	}

define can_standing_shield():
	can_use(RG_MIRROR_SHIELD) or (is_adult() and has(RG_HYLIAN_SHIELD)) or can_use(RG_DEKU_SHIELD)

define can_shield():
	can_use(RG_MIRROR_SHIELD) or has(RG_HYLIAN_SHIELD) or can_use(RG_DEKU_SHIELD)

define can_use_projectile():
	has_explosives() or can_use(RG_FAIRY_BOW) or can_use(RG_HOOKSHOT) or can_use(RG_FAIRY_SLINGSHOT) or
	can_use(RG_BOOMERANG)

define is_fire_loop_locked():
	setting(RSK_KEYSANITY) is RO_DUNGEON_ITEM_LOC_ANYWHERE or
	setting(RSK_KEYSANITY) is RO_DUNGEON_ITEM_LOC_OVERWORLD or
	setting(RSK_KEYSANITY) is RO_DUNGEON_ITEM_LOC_ANY_DUNGEON

define reach_scarecrow():
	scarecrows_song() and can_use(RG_HOOKSHOT)

define reach_distant_scarecrow():
	scarecrows_song() and can_use(RG_LONGSHOT)

define can_climb_ladder():
	has(RG_CLIMB) or (trick(RT_HOOKSHOT_LADDERS) and can_use(RG_HOOKSHOT))

define can_climb_high_ladder():
	has(RG_CLIMB) or (trick(RT_HOOKSHOT_LADDERS) and can_use(RG_LONGSHOT))

define summon_epona():
	is_adult() and flag(LOGIC_FREED_EPONA) and can_use(RG_EPONAS_SONG)

define is_reverse_access_possible():
	setting(RSK_SHUFFLE_BOSS_ENTRANCES) is not RO_BOSS_ROOM_ENTRANCE_SHUFFLE_OFF and
	((setting(RSK_DECOUPLED_ENTRANCES) and setting(RSK_SHUFFLE_BOSS_ENTRANCES) is RO_BOSS_ROOM_ENTRANCE_SHUFFLE_FULL) or
	(setting(RSK_MIX_BOSS_ENTRANCES) and (setting(RSK_MIX_OVERWORLD_ENTRANCES) or setting(RSK_MIX_INTERIOR_ENTRANCES))))

define dmc_upper_to_pots():
	can_use(RG_HOVER_BOOTS) or (is_adult() and (flag(LOGIC_DMC_BOULDER) or trick(RT_DMC_BOULDER_SKIP)))

define dmc_pots_to_pad():
	can_use(RG_HOVER_BOOTS) or can_use(RG_HOOKSHOT) or
	(is_adult() and can_shield() and trick(RT_DMC_BOLERO_JUMP) and can_use(RG_POWER_BRACELET))

define dmc_pad_to_pots():
	(can_use(RG_HOVER_BOOTS) and (is_adult() or has(RG_CLIMB))) or can_use(RG_HOOKSHOT)

# `small_keys(scene, n ? a : b)` upstream; a rule can't be a ternary condition in the AP target,
# so each branch is spelled out. `keys >= b` implies `keys >= a` whenever a < b, so this is equivalent.
define spirit_explosive_key_logic():
	(has_explosives() and small_keys(SCENE_SPIRIT_TEMPLE, 1)) or small_keys(SCENE_SPIRIT_TEMPLE, 2)

define spirit_west_to_skull():
	(is_adult() and trick(RT_SPIRIT_STATUE_JUMP)) or can_use(RG_HOVER_BOOTS) or reach_scarecrow()

define spirit_sun_block_south_ledge():
	has(RG_POWER_BRACELET) or is_adult() or can_kill(RE_BEAMOS) or
	(can_use(RG_HOOKSHOT) and
	(has_fire_source() or
	(flag(LOGIC_SPIRIT_SUN_BLOCK_TORCH) and
	(can_use(RG_STICKS) or (trick(RT_SPIRIT_SUN_CHEST) and can_use(RG_FAIRY_BOW))))))

define spirit_east_to_switch():
	(is_adult() and trick(RT_SPIRIT_STATUE_JUMP)) or can_use(RG_HOVER_BOOTS) or
	(can_use(RG_ZELDAS_LULLABY) and can_use(RG_HOOKSHOT))

define mq_spirit_west_to_pots():
	(is_adult() and trick(RT_SPIRIT_STATUE_JUMP)) or can_use(RG_HOVER_BOOTS) or can_use(RG_SONG_OF_TIME)

define mq_spirit_statue_to_sun_block():
	(is_adult() or trick(RT_SPIRIT_MQ_SUN_BLOCK_SOT) or can_use(RG_SONG_OF_TIME)) and has(RG_POWER_BRACELET)

define mq_spirit_statue_south_door():
	has_fire_source() or (trick(RT_SPIRIT_MQ_FROZEN_EYE) and can_use(RG_FAIRY_BOW) and
	can_use(RG_SONG_OF_TIME) and (has(RG_CLIMB) or can_use(RG_HOOKSHOT)))

define mq_spirit_4_key_colossus():
	can_avoid(RE_BEAMOS, true, 4) and can_use(RG_SONG_OF_TIME) and can_jumpslash() and
	(has(RG_POWER_BRACELET) or sunlight_arrows()) and
	(trick(RT_LENS_SPIRIT_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_kill(RE_IRON_KNUCKLE) and can_use(RG_HOOKSHOT)

define mq_spirit_4_key_west_hand():
	can_use(RG_LONGSHOT) and mq_spirit_4_key_colossus()

define could_mq_spirit_4_key_west_hand():
	can_avoid(RE_BEAMOS, true, 4) and can_use(RG_SONG_OF_TIME) and
	(has(RG_MASTER_SWORD) or has(RG_BIGGORON_SWORD) or has(RG_MEGATON_HAMMER)) and
	(has(RG_POWER_BRACELET) or sunlight_arrows()) and
	(trick(RT_LENS_SPIRIT_MQ) or can_use(RG_LENS_OF_TRUTH)) and has(RG_LONGSHOT)

define outer_west_hand_logic():
	has_explosives() and (has(RG_CLIMB) or can_use(RG_LONGSHOT)) and has(RG_POWER_BRACELET) and
	((has(RG_LONGSHOT) and small_keys(SCENE_SPIRIT_TEMPLE, 3)) or small_keys(SCENE_SPIRIT_TEMPLE, 5))

define outer_west_hand_mq_logic():
	mq_spirit_statue_to_sun_block() and
	((could_mq_spirit_4_key_west_hand() and small_keys(SCENE_SPIRIT_TEMPLE, 4)) or small_keys(SCENE_SPIRIT_TEMPLE, 7))

define statue_room_mq_key_logic():
	((is_child() and flag(LOGIC_REVERSE_SPIRIT_CHILD) and can_hit_switch() and
	(has(RG_CLIMB) or can_use(RG_LONGSHOT))) and small_keys(SCENE_SPIRIT_TEMPLE, 6)) or
	small_keys(SCENE_SPIRIT_TEMPLE, 7)
