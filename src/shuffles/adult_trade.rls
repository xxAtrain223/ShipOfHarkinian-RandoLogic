# overworld/death_mountain_trail

extend region RR_DEATH_MOUNTAIN_SUMMIT {
    locations {
        RC_DMT_TRADE_BROKEN_SWORD: is_adult() and can_use(RG_BROKEN_SWORD)
        RC_DMT_TRADE_EYEDROPS:     is_adult() and can_use(RG_EYEDROPS)
    }
}

# overworld/kakariko

extend region RR_KAKARIKO_VILLAGE {
    locations {
        RC_KAK_TRADE_POCKET_CUCCO: is_adult() and at_day() and (can_use(RG_POCKET_EGG) and flag(LOGIC_WAKE_UP_ADULT_TALON))
    }
}

extend region RR_KAK_ODD_POTION_BUILDING {
    locations {
        RC_KAK_TRADE_ODD_MUSHROOM: is_adult() and can_use(RG_ODD_MUSHROOM)
    }
}

# overworld/zoras_domain

extend region RR_ZORAS_DOMAIN {
    locations {
        RC_ZD_TRADE_PRESCRIPTION: is_adult() and flag(LOGIC_KING_ZORA_THAWED) and can_use(RG_PRESCRIPTION)
    }
}
