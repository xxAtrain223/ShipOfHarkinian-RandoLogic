# dungeons/ganons_castle

extend region RR_GANONS_TOWER_FLOOR_2 {
    locations {
        RC_GANONS_TOWER_BOSS_KEY_CHEST: can_kill(RE_STALFOS, ED_CLOSE, true, 2) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_FOREST_TRIAL_WOLFOS_ROOM {
    locations {
        RC_GANONS_CASTLE_FOREST_TRIAL_CHEST: can_kill(RE_WOLFOS) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_WATER_TRIAL_BLUE_FIRE_ROOM {
    locations {
        RC_GANONS_CASTLE_WATER_TRIAL_LEFT_CHEST:  has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_WATER_TRIAL_RIGHT_CHEST: has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_SHADOW_TRIAL_START {
    locations {
        RC_GANONS_CASTLE_SHADOW_TRIAL_FRONT_CHEST:
            (can_use(RG_FIRE_ARROWS) or can_use(RG_HOOKSHOT) or can_use(RG_HOVER_BOOTS) or
             can_use(RG_SONG_OF_TIME) or is_child()) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_SHADOW_TRIAL_CHEST_PLATFORM {
    locations {
        RC_GANONS_CASTLE_SHADOW_TRIAL_GOLDEN_GAUNTLETS_CHEST: flag(LOGIC_SHADOW_TRIAL_LOWER_SWITCH) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_SPIRIT_TRIAL_BEFORE_SWITCH {
    locations {
        RC_GANONS_CASTLE_SPIRIT_TRIAL_CRYSTAL_SWITCH_CHEST:
            (can_jumpslash() or has_explosives() or can_use(RG_GIANTS_KNIFE)) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_SPIRIT_TRIAL_AFTER_SWITCH {
    locations {
        RC_GANONS_CASTLE_SPIRIT_TRIAL_CRYSTAL_SWITCH_CHEST: can_hit_switch() and has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_SPIRIT_TRIAL_INVISIBLE_CHEST:      (trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH)) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_LIGHT_TRIAL_CHESTS_ROOM {
    locations {
        RC_GANONS_CASTLE_LIGHT_TRIAL_FIRST_LEFT_CHEST:        has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_LIGHT_TRIAL_SECOND_LEFT_CHEST:       has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_LIGHT_TRIAL_THIRD_LEFT_CHEST:        has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_LIGHT_TRIAL_FIRST_RIGHT_CHEST:       has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_LIGHT_TRIAL_SECOND_RIGHT_CHEST:      has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_LIGHT_TRIAL_THIRD_RIGHT_CHEST:       has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_LIGHT_TRIAL_INVISIBLE_ENEMIES_CHEST:
            (trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH)) and
            (can_kill(RE_BIG_SKULLTULA) and can_kill(RE_KEESE, ED_CLOSE, true, 3)) and
            has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_LIGHT_TRIAL_TRIFORCE_ROOM {
    locations {
        RC_GANONS_CASTLE_LIGHT_TRIAL_LULLABY_CHEST: can_use(RG_ZELDAS_LULLABY) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_FOREST_TRIAL_BEAMOS_ROOM {
    locations {
        RC_GANONS_CASTLE_MQ_FOREST_TRIAL_EYE_SWITCH_CHEST: flag(LOGIC_FOREST_TRIAL_MQ_SPAWN_BEAMOS_CHEST) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_FOREST_TRIAL_BEAMOS_ROOM_MIDDLE {
    locations {
        RC_GANONS_CASTLE_MQ_FOREST_TRIAL_FROZEN_EYE_SWITCH_CHEST: has_fire_source() and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_WATER_TRIAL_GEYSER_ROOM {
    locations {
        RC_GANONS_CASTLE_MQ_WATER_TRIAL_CHEST: blue_fire() and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_SHADOW_TRIAL_CHEST_PLATFORM {
    locations {
        RC_GANONS_CASTLE_MQ_SHADOW_TRIAL_BOMB_FLOWER_CHEST: flag(LOGIC_SHADOW_TRIAL_FIRST_CHEST) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_SHADOW_TRIAL_FAR_SIDE {
    locations {
        RC_GANONS_CASTLE_MQ_SHADOW_TRIAL_EYE_SWITCH_CHEST: can_hit_eye_targets() and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_SPIRIT_TRIAL_BEFORE_SWITCH {
    locations {
        RC_GANONS_CASTLE_MQ_SPIRIT_TRIAL_FIRST_CHEST: can_pass(RE_GREEN_BUBBLE) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_SPIRIT_TRIAL_AFTER_SWITCH {
    locations {
        RC_GANONS_CASTLE_MQ_SPIRIT_TRIAL_INVISIBLE_CHEST:
            (trick(RT_LENS_GANON_MQ) or can_use(RG_LENS_OF_TRUTH)) and has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_MQ_SPIRIT_TRIAL_SUN_FRONT_LEFT_CHEST:
            ((can_use(RG_FIRE_ARROWS) and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows()) and has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_MQ_SPIRIT_TRIAL_SUN_BACK_LEFT_CHEST:
            ((can_use(RG_FIRE_ARROWS) and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows()) and has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_MQ_SPIRIT_TRIAL_GOLDEN_GAUNTLETS_CHEST:
            ((can_use(RG_FIRE_ARROWS) and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows()) and has(RG_OPEN_CHEST)
        RC_GANONS_CASTLE_MQ_SPIRIT_TRIAL_SUN_BACK_RIGHT_CHEST:
            ((can_use(RG_FIRE_ARROWS) and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows()) and has(RG_OPEN_CHEST)
    }
}

extend region RR_GANONS_CASTLE_MQ_LIGHT_TRIAL_TRIFORCE_ROOM {
    locations {
        RC_GANONS_CASTLE_MQ_LIGHT_TRIAL_LULLABY_CHEST: can_use(RG_ZELDAS_LULLABY) and has(RG_OPEN_CHEST)
    }
}

# dungeons/spirit_temple

extend region RR_SPIRIT_TEMPLE_SWITCH_BRIDGE_NORTH {
    locations {
        RC_SPIRIT_TEMPLE_CHILD_BRIDGE_CHEST: has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_NORTH {
    locations {
        RC_SPIRIT_TEMPLE_CHILD_EARLY_TORCHES_CHEST: flag(LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE_TORCHES) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F {
    locations {
        RC_SPIRIT_TEMPLE_CHILD_CLIMB_NORTH_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F, can_hit_switch(ED_BOMB_THROW) and has(RG_OPEN_CHEST))
        RC_SPIRIT_TEMPLE_CHILD_CLIMB_EAST_CHEST:  spirit_shared(RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F, can_hit_switch(ED_BOMB_THROW) and has(RG_OPEN_CHEST))
    }
}

extend region RR_SPIRIT_TEMPLE_SAND_PIT {
    locations {
        RC_SPIRIT_TEMPLE_COMPASS_CHEST: can_use(RG_ZELDAS_LULLABY) and (can_use(RG_HOOKSHOT) or (trick(RT_HOVER_BOOST_SIMPLE) and can_use(RG_HOVER_BOOTS) and can_use(RG_MEGATON_HAMMER))) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_PAST_BOULDERS {
    locations {
        RC_SPIRIT_TEMPLE_EARLY_ADULT_RIGHT_CHEST: has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_2F_MIRROR_ROOM {
    locations {
        RC_SPIRIT_TEMPLE_FIRST_MIRROR_LEFT_CHEST:  spirit_shared(RR_SPIRIT_TEMPLE_2F_MIRROR_ROOM, has(RG_OPEN_CHEST) and (has(RG_POWER_BRACELET) or sunlight_arrows()))
        RC_SPIRIT_TEMPLE_FIRST_MIRROR_RIGHT_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_2F_MIRROR_ROOM, has(RG_OPEN_CHEST) and (has(RG_POWER_BRACELET) or sunlight_arrows()))
    }
}

extend region RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD {
    locations {
        # Assumes RR_SPIRIT_TEMPLE_STATUE_ROOM access
        RC_SPIRIT_TEMPLE_MAP_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD, has_fire_source_with_torch() or (trick(RT_SPIRIT_MAP_CHEST) and can_use(RG_FAIRY_BOW)), false,
                                                  RR_SPIRIT_TEMPLE_STATUE_ROOM, has_fire_source()) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_STATUE_ROOM {
    locations {
        RC_SPIRIT_TEMPLE_MAP_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_STATUE_ROOM, has_fire_source(), false,
                                                  RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD, has_fire_source_with_torch() or (trick(RT_SPIRIT_MAP_CHEST) and can_use(RG_FAIRY_BOW))) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_SUN_BLOCK_CHEST_LEDGE {
    locations {
        RC_SPIRIT_TEMPLE_SUN_BLOCK_ROOM_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_SUN_BLOCK_CHEST_LEDGE,
                                                             has_fire_source() or
                                                             (flag(LOGIC_SPIRIT_SUN_BLOCK_TORCH) and
                                                              (can_use(RG_STICKS) or (trick(RT_SPIRIT_SUN_CHEST) and can_use(RG_FAIRY_BOW))))) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_OUTER_RIGHT_HAND {
    locations {
        RC_SPIRIT_TEMPLE_SILVER_GAUNTLETS_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_OUTER_RIGHT_HAND, has(RG_OPEN_CHEST))
    }
}

extend region RR_SPIRIT_TEMPLE_INNER_LEFT_HAND {
    locations {
        # Assumes RR_SPIRIT_TEMPLE_INNER_WEST_HAND access via RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD and RR_SPIRIT_TEMPLE_STATUE_ROOM.
        RC_SPIRIT_TEMPLE_STATUE_ROOM_HAND_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_INNER_LEFT_HAND, can_use(RG_ZELDAS_LULLABY) and (has(RG_CLIMB) or can_use(RG_HOOKSHOT)) and has(RG_OPEN_CHEST))
    }
}

extend region RR_SPIRIT_TEMPLE_SHORTCUT_SWITCH {
    locations {
        RC_SPIRIT_TEMPLE_STATUE_ROOM_NORTHEAST_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_SHORTCUT_SWITCH, can_use(RG_ZELDAS_LULLABY) and has(RG_OPEN_CHEST))
    }
}

extend region RR_SPIRIT_TEMPLE_4_ARMOS {
    locations {
        RC_SPIRIT_TEMPLE_NEAR_FOUR_ARMOS_CHEST: (can_use(RG_MIRROR_SHIELD) or sunlight_arrows()) and has_explosives() and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_4_ARMOS_SIDE_ROOM {
    locations {
        RC_SPIRIT_TEMPLE_NEAR_FOUR_ARMOS_CHEST: has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_CHEST_STAIRS {
    locations {
        RC_SPIRIT_TEMPLE_HALLWAY_LEFT_INVISIBLE_CHEST:  (trick(RT_LENS_SPIRIT) or can_use(RG_LENS_OF_TRUTH)) and has(RG_OPEN_CHEST)
        RC_SPIRIT_TEMPLE_HALLWAY_RIGHT_INVISIBLE_CHEST: (trick(RT_LENS_SPIRIT) or can_use(RG_LENS_OF_TRUTH)) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_OUTER_LEFT_HAND {
    locations {
        RC_SPIRIT_TEMPLE_MIRROR_SHIELD_CHEST: has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_FAKE_DOORS_ROOM {
    locations {
        RC_SPIRIT_TEMPLE_BOSS_KEY_CHEST: ((take_damage() and trick(RT_FIRE_RINGS)) or
                                          (any_age(can_hit_eye_targets() and can_avoid(RE_TORCH_SLUG, true, 4)) and can_use(RG_HOOKSHOT))) and
                                         has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_BIG_MIRROR_CAVE {
    locations {
        RC_SPIRIT_TEMPLE_TOPMOST_CHEST: ((is_adult() and can_use(RG_MIRROR_SHIELD)) or sunlight_arrows()) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_FOYER {
    locations {
        RC_SPIRIT_TEMPLE_MQ_ENTRANCE_FRONT_LEFT_CHEST:  has(RG_OPEN_CHEST)
        RC_SPIRIT_TEMPLE_MQ_ENTRANCE_BACK_LEFT_CHEST:   any_age(blast_or_smash()) and can_hit_eye_targets() and has(RG_OPEN_CHEST)
        RC_SPIRIT_TEMPLE_MQ_ENTRANCE_BACK_RIGHT_CHEST:  can_hit_switch(ED_BOOMERANG) and has(RG_OPEN_CHEST)
        RC_SPIRIT_TEMPLE_MQ_ENTRANCE_FRONT_RIGHT_CHEST: flag(LOGIC_SPIRIT_1F_SILVER_RUPEES) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_CHILD_SIDE_HUB {
    locations {
        RC_SPIRIT_TEMPLE_MQ_CHILD_HAMMER_SWITCH_CHEST: flag(LOGIC_SPIRIT_MQ_TIME_TRAVEL_CHEST) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_GRAVE {
    locations {
        RC_SPIRIT_TEMPLE_MQ_MAP_ROOM_ENEMY_CHEST: flag(LOGIC_SPIRIT_MQ_MAP_ROOM_ENEMIES) and has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_ANUBIS_BRIDGE_CHEST {
    locations {
        RC_SPIRIT_TEMPLE_MQ_MAP_CHEST: has(RG_OPEN_CHEST)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_SUN_ON_FLOOR {
    locations {
        # implies can_kill(RE_LIKE_LIKE)
        RC_SPIRIT_TEMPLE_MQ_CHILD_CLIMB_NORTH_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_MQ_SUN_ON_FLOOR, can_kill(RE_BEAMOS) and has(RG_OPEN_CHEST))
        # Sunlights only temp spawn this chest, which is unintuitive/a bug.
        RC_SPIRIT_TEMPLE_MQ_CHILD_CLIMB_SOUTH_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_MQ_SUN_ON_FLOOR, (has_explosives() or sunlight_arrows()) and can_use(RG_HOOKSHOT) and has(RG_OPEN_CHEST))
    }
}

