    locations {
        RC_DODONGOS_CAVERN_MQ_COMPASS_CHEST: (can_kill(RE_DODONGO) or (has(RG_GORONS_BRACELET) and can_climb_ladder())) and has(RG_OPEN_CHEST)
    }
}

extend region RR_DODONGOS_CAVERN_MQ_LARVAE_ROOM {
    locations {
        RC_DODONGOS_CAVERN_MQ_LARVAE_ROOM_CHEST:   has(RG_OPEN_CHEST) # implied can_kill(RE_GOHMA_LARVA) based on entry reqs with a trick to kill with nuts
