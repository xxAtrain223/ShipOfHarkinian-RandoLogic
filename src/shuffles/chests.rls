    locations {
        # the chest is in a grave, but you can open it through it
        RC_DODONGOS_CAVERN_MQ_UNDER_GRAVE_CHEST: (trick(RT_VISIBLE_COLLISION) or has(RG_POWER_BRACELET)) and has(RG_OPEN_CHEST)
    }
