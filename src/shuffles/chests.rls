        RC_SPIRIT_TEMPLE_MQ_SILVER_BLOCK_HALLWAY_CHEST: spirit_shared(RR_SPIRIT_TEMPLE_MQ_BIG_BLOCKS_DOOR, is_child() and can_hit_eye_targets() and has(RG_OPEN_CHEST))
