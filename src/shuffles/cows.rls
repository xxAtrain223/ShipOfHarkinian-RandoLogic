# dungeons/jabujabus_belly

extend region RR_JABU_JABUS_BELLY_MQ_JIGGLIES_ROOM {
    locations {
        RC_JABU_JABUS_BELLY_MQ_COW: can_use(RG_EPONAS_SONG) and can_use(RG_FAIRY_SLINGSHOT)
    }
}

