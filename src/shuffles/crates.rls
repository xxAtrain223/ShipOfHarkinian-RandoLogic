    locations {
        RC_TH_BREAK_HALLWAY_OUTER_CRATE: can_break_crates()
        RC_TH_BREAK_HALLWAY_INNER_CRATE: can_break_crates()
        RC_TH_BREAK_ROOM_RIGHT_CRATE:    (can_pass(RE_BREAK_ROOM_GUARD) and can_break_crates()) or (can_pass(RE_GERUDO_GUARD) and has_explosives() and can_use(RG_BOOMERANG))
        RC_TH_BREAK_ROOM_LEFT_CRATE:     (can_pass(RE_BREAK_ROOM_GUARD) and can_break_crates()) or (can_pass(RE_GERUDO_GUARD) and has_explosives() and can_use(RG_BOOMERANG))
