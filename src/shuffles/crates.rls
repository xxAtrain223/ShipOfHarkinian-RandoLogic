extend region RR_GF_HBA_RANGE {
    locations {
        RC_GF_HBA_RANGE_CRATE_1:        can_break_crates()
        RC_GF_HBA_RANGE_CRATE_2:        can_break_crates()
        RC_GF_HBA_RANGE_CRATE_3:        can_break_crates()
        RC_GF_HBA_RANGE_CRATE_4:        can_break_crates()
        RC_GF_HBA_RANGE_CRATE_5:        can_break_crates()
        RC_GF_HBA_RANGE_CRATE_6:        can_break_crates()
        RC_GF_HBA_RANGE_CRATE_7:        can_break_crates()
