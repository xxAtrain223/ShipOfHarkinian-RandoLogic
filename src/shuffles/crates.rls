        RC_KAK_NEAR_BOARDING_HOUSE_ADULT_CRATE_1: is_adult() and can_break_crates()
        RC_KAK_NEAR_BOARDING_HOUSE_ADULT_CRATE_2: is_adult() and can_break_crates()
        RC_KAK_NEAR_IMPAS_HOUSE_ADULT_CRATE_1:    is_adult() and can_break_crates()
        RC_KAK_NEAR_IMPAS_HOUSE_ADULT_CRATE_2:    is_adult() and can_break_crates()
        RC_KAK_NEAR_BAZAAR_ADULT_CRATE_1:         is_adult() and can_break_crates()
        RC_KAK_NEAR_BAZAAR_ADULT_CRATE_2:         is_adult() and can_break_crates()
        RC_KAK_BEHIND_GS_HOUSE_ADULT_CRATE:       is_adult() and can_break_crates()
        RC_KAK_NEAR_GY_CHILD_CRATE:               is_child() and can_break_crates()
        RC_KAK_NEAR_WINDMILL_CHILD_CRATE:         is_child() and can_break_crates()
        RC_KAK_NEAR_FENCE_CHILD_CRATE:            is_child() and can_break_crates()
