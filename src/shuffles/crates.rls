        RC_GF_HBA_CANOPY_WEST_CRATE:    can_break_crates()
        RC_GF_NORTH_TARGET_EAST_CRATE:  can_break_crates()
        RC_GF_NORTH_TARGET_WEST_CRATE:  is_adult() or (blast_or_smash() or hookshot_or_boomerang() or can_use(RG_HOVER_BOOTS))
        RC_GF_NORTH_TARGET_CHILD_CRATE: is_child() and blast_or_smash()
        RC_GF_SOUTH_TARGET_EAST_CRATE:  can_break_crates()
        RC_GF_SOUTH_TARGET_WEST_CRATE:  can_break_crates()
    }
}

