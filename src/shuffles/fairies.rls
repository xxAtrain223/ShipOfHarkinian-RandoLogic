        RC_COLOSSUS_BEAN_SPROUT_FAIRY_2:    is_child() and can_use(RG_MAGIC_BEAN) and has(RG_DESERT_COLOSSUS_BEAN_SOUL) and can_use(RG_SONG_OF_STORMS)
