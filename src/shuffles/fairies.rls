# overworld/death_mountain_trail

extend region RR_DEATH_MOUNTAIN_TRAIL {
    locations {
        RC_DMT_BEAN_SPROUT_FAIRY_1: is_child() and can_use(RG_MAGIC_BEAN) and has(RG_DEATH_MOUNTAIN_TRAIL_BEAN_SOUL) and
                                    can_use(RG_SONG_OF_STORMS) and (has_explosives() or has(RG_GORONS_BRACELET))
        RC_DMT_BEAN_SPROUT_FAIRY_2: is_child() and can_use(RG_MAGIC_BEAN) and has(RG_DEATH_MOUNTAIN_TRAIL_BEAN_SOUL) and
                                    can_use(RG_SONG_OF_STORMS) and (has_explosives() or has(RG_GORONS_BRACELET))
        RC_DMT_BEAN_SPROUT_FAIRY_3: is_child() and can_use(RG_MAGIC_BEAN) and has(RG_DEATH_MOUNTAIN_TRAIL_BEAN_SOUL) and
                                    can_use(RG_SONG_OF_STORMS) and (has_explosives() or has(RG_GORONS_BRACELET))
        RC_DMT_FLAG_SUN_FAIRY:      can_use(RG_SUNS_SONG)
    }
}

