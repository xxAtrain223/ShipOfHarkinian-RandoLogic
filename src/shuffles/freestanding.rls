# dungeons/ganons_castle

extend region RR_GANONS_CASTLE_FIRE_TRIAL_FROM_OPEN {
    locations {
        RC_GANONS_CASTLE_FIRE_TRIAL_HEART: fire_timer() >= 16
    }
}

extend region RR_GANONS_CASTLE_FIRE_TRIAL_FROM_BARRED {
    locations {
        RC_GANONS_CASTLE_FIRE_TRIAL_HEART: fire_timer() >= 16
    }
}

extend region RR_GANONS_CASTLE_SHADOW_TRIAL_CHEST_PLATFORM {
    locations {
        RC_GANONS_CASTLE_SHADOW_TRIAL_HEART_1: trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_BOOMERANG)
        RC_GANONS_CASTLE_SHADOW_TRIAL_HEART_2: trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_BOOMERANG)
        RC_GANONS_CASTLE_SHADOW_TRIAL_HEART_3: trick(RT_LENS_GANON) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_BOOMERANG)
    }
}

extend region RR_GANONS_CASTLE_SHADOW_TRIAL_END {
    locations {
        RC_GANONS_CASTLE_SHADOW_TRIAL_HEART_2: can_use(RG_HOVER_BOOTS) or can_use(RG_BOOMERANG)
        RC_GANONS_CASTLE_SHADOW_TRIAL_HEART_3: can_use(RG_HOVER_BOOTS) or can_use(RG_BOOMERANG)
    }
}

extend region RR_GANONS_CASTLE_SPIRIT_TRIAL_BEAMOS_ROOM {
    locations {
        RC_GANONS_CASTLE_SPIRIT_TRIAL_HEART: always
    }
}

extend region RR_GANONS_CASTLE_MQ_WATER_TRIAL_GEYSER_ROOM {
    locations {
        RC_GANONS_CASTLE_MQ_WATER_TRIAL_HEART: blue_fire()
    }
}

extend region RR_GANONS_CASTLE_MQ_LIGHT_TRIAL_BOULDER_ROOM_BACK {
    locations {
        RC_GANONS_CASTLE_MQ_LIGHT_TRIAL_LEFT_HEART:  always
        RC_GANONS_CASTLE_MQ_LIGHT_TRIAL_RIGHT_HEART: always
    }
}

# dungeons/spirit_temple

extend region RR_SPIRIT_TEMPLE_BIG_WALL_UPPER {
    locations {
        RC_SPIRIT_TEMPLE_ADULT_CLIMB_LEFT_HEART:  can_use(RG_HOOKSHOT)
        RC_SPIRIT_TEMPLE_ADULT_CLIMB_RIGHT_HEART: can_use(RG_HOOKSHOT)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_CHILD_SIDE_HUB {
    locations {
        RC_SPIRIT_TEMPLE_MQ_CHILD_LEFT_HEART:  can_hit_eye_targets() or can_use(RG_BOOMERANG) or
                                               (trick(RT_FIRE_RINGS) and trick(RT_VISIBLE_COLLISION) and take_damage() and can_jumpslash())
        RC_SPIRIT_TEMPLE_MQ_CHILD_RIGHT_HEART: can_hit_eye_targets() or can_use(RG_BOOMERANG) or
                                               (trick(RT_FIRE_RINGS) and trick(RT_VISIBLE_COLLISION) and take_damage() and can_jumpslash())
    }
}

