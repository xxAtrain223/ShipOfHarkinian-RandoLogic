    locations {
        RC_DEKU_TREE_BEFORE_BOSS_LEFT_HEART:   has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_use(RG_BOOMERANG)
        RC_DEKU_TREE_BEFORE_BOSS_MIDDLE_HEART: has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_use(RG_BOOMERANG)
