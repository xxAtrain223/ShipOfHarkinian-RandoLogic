# overworld/zoras_river

extend region RR_ZORAS_RIVER {
    locations {
        RC_ZR_BENEATH_WATERFALL_LEFT_RUPEE:         is_adult() and (has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_use(RG_BOOMERANG))
        RC_ZR_BENEATH_WATERFALL_MIDDLE_LEFT_RUPEE:  is_adult() and (has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_use(RG_BOOMERANG))
        RC_ZR_BENEATH_WATERFALL_MIDDLE_RIGHT_RUPEE: is_adult() and (has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_use(RG_BOOMERANG))
        RC_ZR_BENEATH_WATERFALL_RIGHT_RUPEE:        is_adult() and (has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or can_use(RG_BOOMERANG))
    }
}

