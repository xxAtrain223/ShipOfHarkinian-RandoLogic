# dungeons/deku_tree

extend region RR_DEKU_TREE_COMPASS_ROOM {
    locations {
        RC_DEKU_TREE_GS_COMPASS_ROOM: can_attack()
    }
}

extend region RR_DEKU_TREE_BASEMENT_LOWER {
    locations {
        RC_DEKU_TREE_GS_BASEMENT_GATE: can_kill(RE_GOLD_SKULLTULA, ED_SHORT_JUMPSLASH)
        RC_DEKU_TREE_GS_BASEMENT_VINES:
            can_kill(RE_GOLD_SKULLTULA, trick(RT_DEKU_MQ_COMPASS_GS) ? ED_SHORT_JUMPSLASH : ED_BOMB_THROW) and
            (has(RG_CLIMB) or can_use(RG_HOOKSHOT) or can_use(RG_BOOMERANG))
    }
}

extend region RR_DEKU_TREE_BASEMENT_BACK_ROOM {
    locations {
        RC_DEKU_TREE_GS_BASEMENT_BACK_ROOM: hookshot_or_boomerang()
    }
}

extend region RR_DEKU_TREE_MQ_2F {
    locations {
        RC_DEKU_TREE_MQ_GS_LOBBY: (can_break_crates() or trick(RT_VISIBLE_COLLISION)) and can_get_drop(RE_GOLD_SKULLTULA)
    }
}

extend region RR_DEKU_TREE_MQ_PAST_BOULDER_VINES {
    locations {
        RC_DEKU_TREE_MQ_GS_PAST_BOULDER_VINES: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

extend region RR_DEKU_TREE_MQ_BASEMENT_GRAVE_ROOM {
    locations {
        RC_DEKU_TREE_MQ_GS_BASEMENT_GRAVES_ROOM: can_use(RG_LONGSHOT) or (can_use(RG_SONG_OF_TIME) and can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG))
    }
}

extend region RR_DEKU_TREE_MQ_BASEMENT_BACK_ROOM {
    locations {
        RC_DEKU_TREE_MQ_GS_BASEMENT_BACK_ROOM: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

# dungeons/dodongos_cavern

extend region RR_DODONGOS_CAVERN_SE_CORRIDOR {
    locations {
        RC_DODONGOS_CAVERN_GS_SCARECROW: reach_scarecrow() or (is_adult() and can_use(RG_LONGSHOT)) or (trick(RT_DC_SCARECROW_GS) and has(RG_POWER_BRACELET) and can_get_drop(RE_GOLD_SKULLTULA))
    }
}

extend region RR_DODONGOS_CAVERN_SE_ROOM {
    locations {
        RC_DODONGOS_CAVERN_GS_SIDE_ROOM_NEAR_LOWER_LIZALFOS: can_attack()
    }
}

extend region RR_DODONGOS_CAVERN_STAIRS_LOWER {
    locations {
        RC_DODONGOS_CAVERN_GS_VINES_ABOVE_STAIRS: trick(RT_DC_VINES_GS) and can_get_drop(RE_GOLD_SKULLTULA, ED_LONGSHOT)
    }
}

extend region RR_DODONGOS_CAVERN_STAIRS_UPPER {
    locations {
        RC_DODONGOS_CAVERN_GS_ALCOVE_ABOVE_STAIRS: can_get_drop(RE_GOLD_SKULLTULA, flag(LOGIC_DC_LIFT_PLATFORM) ? ED_BOOMERANG : ED_LONGSHOT)
        RC_DODONGOS_CAVERN_GS_VINES_ABOVE_STAIRS:  (has(RG_CLIMB) and has(RG_POWER_BRACELET)) or can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

extend region RR_DODONGOS_CAVERN_BACK_ROOM {
    locations {
        RC_DODONGOS_CAVERN_GS_BACK_ROOM: can_attack()
    }
}

extend region RR_DODONGOS_CAVERN_MQ_STAIRS_PAST_MUD_WALL {
    locations {
        RC_DODONGOS_CAVERN_MQ_GS_SONG_OF_TIME_BLOCK_ROOM: can_use(RG_SONG_OF_TIME) and can_get_drop(RE_GOLD_SKULLTULA)
    }
}

extend region RR_DODONGOS_CAVERN_MQ_LARVAE_ROOM {
    locations {
        RC_DODONGOS_CAVERN_MQ_GS_LARVAE_ROOM:      can_break_crates() # implied can_kill(RE_GOLD_SKULTULLA) based on entry reqs. Add crate logic when BONKO is added
    }
}

extend region RR_DODONGOS_CAVERN_MQ_UPPER_LIZALFOS {
    locations {
        RC_DODONGOS_CAVERN_MQ_GS_LIZALFOS_ROOM:     blast_or_smash() # Implied can_get_drop(RE_GOLD_SKULLTULA)
    }
}

extend region RR_DODONGOS_CAVERN_MQ_MAD_SCRUB_ROOM {
    locations {
        RC_DODONGOS_CAVERN_MQ_GS_SCRUB_ROOM: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG, true) # Implies you can avoid/kill the enemies with what you use on the skull, if this assumption is broken, add
                                             # and (any_age(can_kill(RE_FIRE_KEESE) and can_kill(RE_MAD_SCRUB)) or (can_avoid(RE_FIRE_KEESE) and can_avoid(RE_MAD_SCRUB)))
    }
}

extend region RR_DODONGOS_CAVERN_MQ_BEHIND_MOUTH {
    locations {
        # This can be gotten with only str0 as adult by using 1 pot to kill the skull from the top of a nearby grave,
        # then another to hit the switch to turn of the fire then running up the ledge to grab it. This assumes RR_DODONGOS_CAVERN_MQ_BACK_BEHIND_FIRE access
        # Alternatively, the grave can be pulled and roll jumped off of.
        # This may be trickworthy, but it can only come up with doorsanity or decoupled boss door rando, making it too niche to be it's own trick
        RC_DODONGOS_CAVERN_MQ_GS_BACK_AREA: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG) or
                                            (is_adult() and has(RG_POWER_BRACELET) and
                                             (can_pass(RE_ARMOS) or can_use(RG_HOVER_BOOTS) or (trick(RT_UNINTUITIVE_JUMPS))))
    }
}

extend region RR_DODONGOS_CAVERN_MQ_BACK_BEHIND_FIRE {
    locations {
        RC_DODONGOS_CAVERN_MQ_GS_BACK_AREA: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

extend region RR_DODONGOS_CAVERN_MQ_BACK_SWITCH_GRAVE {
    locations {
        RC_DODONGOS_CAVERN_MQ_GS_BACK_AREA: can_get_drop(RE_GOLD_SKULLTULA) or has(RG_GORONS_BRACELET)
    }
}

# dungeons/spirit_temple

extend region RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_NORTH {
    locations {
        # possible to collect without lowering fence, should be a trick
        RC_SPIRIT_TEMPLE_GS_METAL_FENCE: flag(LOGIC_SPIRIT_SILVER_RUPEE_BRIDGE) and can_kill(RE_GOLD_SKULLTULA, ED_BOMB_THROW) and has(RG_CLIMB)
    }
}

extend region RR_SPIRIT_TEMPLE_RUPEE_BRIDGE_SOUTH {
    locations {
        RC_SPIRIT_TEMPLE_GS_METAL_FENCE: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

extend region RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_1F {
    locations {
        RC_SPIRIT_TEMPLE_GS_SUN_ON_FLOOR_ROOM: spirit_shared(RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_1F, can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG), false,
                                                             RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F, can_kill(RE_GOLD_SKULLTULA, take_damage() ? ED_SHORT_JUMPSLASH: ED_BOMB_THROW))
    }
}

extend region RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F {
    locations {
        RC_SPIRIT_TEMPLE_GS_SUN_ON_FLOOR_ROOM: spirit_shared(RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_2F, can_kill(RE_GOLD_SKULLTULA, take_damage() ? ED_SHORT_JUMPSLASH : ED_BOMB_THROW), false,
                                                             RR_SPIRIT_TEMPLE_SUN_ON_FLOOR_1F, can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG))
    }
}

extend region RR_SPIRIT_TEMPLE_BOULDERS {
    locations {
        RC_SPIRIT_TEMPLE_GS_BOULDER_ROOM: can_use(RG_SONG_OF_TIME) and can_kill(RE_GOLD_SKULLTULA)
    }
}

extend region RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD {
    locations {
        RC_SPIRIT_TEMPLE_GS_LOBBY: spirit_shared(RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD, can_get_drop(RE_GOLD_SKULLTULA, ED_LONGSHOT), false,
                                                 RR_SPIRIT_TEMPLE_INNER_WEST_HAND, can_get_drop(RE_GOLD_SKULLTULA, trick(RT_SPIRIT_WEST_LEDGE) ? ED_BOOMERANG : ED_HOOKSHOT),
                                                 RR_SPIRIT_TEMPLE_GS_LEDGE, can_kill(RE_GOLD_SKULLTULA))
    }
}

extend region RR_SPIRIT_TEMPLE_INNER_WEST_HAND {
    locations {
        # You can hit the skull with normal hookshot from a specific spot on the forearm, which is in logic on N64 and 3DS, pretty questionable though
        RC_SPIRIT_TEMPLE_GS_LOBBY: spirit_shared(RR_SPIRIT_TEMPLE_INNER_WEST_HAND, can_get_drop(RE_GOLD_SKULLTULA, trick(RT_SPIRIT_WEST_LEDGE) ? ED_BOOMERANG : ED_HOOKSHOT), false,
                                                 RR_SPIRIT_TEMPLE_GS_LEDGE, can_kill(RE_GOLD_SKULLTULA),
                                                 RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD, can_get_drop(RE_GOLD_SKULLTULA, ED_LONGSHOT))
    }
}

extend region RR_SPIRIT_TEMPLE_GS_LEDGE {
    locations {
        RC_SPIRIT_TEMPLE_GS_LOBBY: spirit_shared(RR_SPIRIT_TEMPLE_GS_LEDGE, can_kill(RE_GOLD_SKULLTULA), false,
                                                 RR_SPIRIT_TEMPLE_INNER_WEST_HAND, can_get_drop(RE_GOLD_SKULLTULA, trick(RT_SPIRIT_WEST_LEDGE) ? ED_BOOMERANG : ED_HOOKSHOT),
                                                 RR_SPIRIT_TEMPLE_STATUE_ROOM_CHILD, can_get_drop(RE_GOLD_SKULLTULA, ED_LONGSHOT))
    }
}

extend region RR_SPIRIT_TEMPLE_SKULLTULA_STAIRS {
    locations {
        RC_SPIRIT_TEMPLE_GS_HALL_AFTER_SUN_BLOCK_ROOM: spirit_shared(RR_SPIRIT_TEMPLE_SKULLTULA_STAIRS, can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG))
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_SUN_BLOCK_ROOM {
    locations {
        # RT_SPIRIT_MQ_SUN_BLOCK_GS should probably be expanded to cover all ground based methods, as it can be hit with longshot because the skull hitbox is larger than the model
        RC_SPIRIT_TEMPLE_MQ_GS_SUN_BLOCK_ROOM: spirit_shared(RR_SPIRIT_TEMPLE_MQ_SUN_BLOCK_ROOM, (can_use(RG_HOOKSHOT) and (has(RG_POWER_BRACELET) or sunlight_arrows())) or
                                                                                                 (trick(RT_SPIRIT_MQ_SUN_BLOCK_GS) and can_use(RG_BOOMERANG)))
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_SAND_PIT {
    locations {
        RC_SPIRIT_TEMPLE_MQ_GS_LEEVER_ROOM: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_SKULLTULA_ROOM {
    locations {
        RC_SPIRIT_TEMPLE_MQ_GS_SYMPHONY_ROOM: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_9_THRONES_ROOM {
    locations {
        # These skulls rely on the iron knuckle existing without a trick to shoot through the chairs
        RC_SPIRIT_TEMPLE_MQ_GS_NINE_THRONES_ROOM_WEST:  can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
        RC_SPIRIT_TEMPLE_MQ_GS_NINE_THRONES_ROOM_NORTH: can_get_drop(RE_GOLD_SKULLTULA)
    }
}

# overworld/castle_grounds

extend region RR_HC_GATE {
    locations {
        RC_HC_GS_TREE: can_bonk_trees() and can_kill(RE_GOLD_SKULLTULA, ED_CLOSE)
    }
}

extend region RR_HC_STORMS_GROTTO {
    locations {
        RC_HC_GS_STORMS_GROTTO: can_use(RG_BOOMERANG) and trick(RT_HC_STORMS_GS)
    }
}

extend region RR_HC_STORMS_GROTTO_BEHIND_WALLS {
    locations {
        RC_HC_GS_STORMS_GROTTO: hookshot_or_boomerang()
    }
}

extend region RR_GANONS_CASTLE_GROUNDS {
    locations {
        RC_OGC_GS:
            can_jumpslash_except_hammer() or
            can_use_projectile() or
            (can_shield() and can_use(RG_MEGATON_HAMMER)) or
            can_use(RG_DINS_FIRE)
    }
}

# overworld/desert_colossus

extend region RR_DESERT_COLOSSUS {
    locations {
        RC_COLOSSUS_GS_BEAN_PATCH: can_spawn_soil_skull(RG_DESERT_COLOSSUS_BEAN_SOUL) and can_attack()
        RC_COLOSSUS_GS_TREE:       is_adult() and hookshot_or_boomerang() and can_get_night_time_gs()
        RC_COLOSSUS_GS_HILL:       is_adult() and
                                   ((can_plant_bean(RR_DESERT_COLOSSUS, RG_DESERT_COLOSSUS_BEAN_SOUL) and can_attack()) or
                                    can_use(RG_LONGSHOT) or (trick(RT_COLOSSUS_GS) and can_use(RG_HOOKSHOT))) and
                                   can_get_night_time_gs()
    }
}

# overworld/graveyard

extend region RR_THE_GRAVEYARD {
    locations {
        RC_GRAVEYARD_GS_WALL:       is_child() and hookshot_or_boomerang() and at_night() and can_get_night_time_gs()
        RC_GRAVEYARD_GS_BEAN_PATCH: can_spawn_soil_skull(RG_GRAVEYARD_BEAN_SOUL) and can_attack()
    }
}

# overworld/hyrule_field

extend region RR_HF_COW_GROTTO_BEHIND_WEBS {
    locations {
        RC_HF_GS_COW_GROTTO: can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG)
    }
}

extend region RR_HF_NEAR_KAK_GROTTO {
    locations {
        RC_HF_GS_NEAR_KAK_GROTTO: hookshot_or_boomerang()
    }
}

# overworld/kakariko

extend region RR_KAKARIKO_VILLAGE {
    locations {
        RC_KAK_GS_HOUSE_UNDER_CONSTRUCTION: is_child() and can_get_night_time_gs() and (has(RG_POWER_BRACELET) or can_kill(RE_GOLD_SKULLTULA))
        RC_KAK_GS_SKULLTULA_HOUSE:          is_child() and can_get_night_time_gs() and (has(RG_POWER_BRACELET) or can_kill(RE_GOLD_SKULLTULA))
        RC_KAK_GS_GUARDS_HOUSE:             is_child() and can_get_night_time_gs() and (has(RG_POWER_BRACELET) or can_kill(RE_GOLD_SKULLTULA))
        RC_KAK_GS_TREE:                     is_child() and can_get_night_time_gs() and can_bonk_trees() and (has(RG_POWER_BRACELET) or can_kill(RE_GOLD_SKULLTULA))
        RC_KAK_GS_WATCHTOWER:               is_child() and has(RG_CLIMB) and
            (can_kill(RE_GOLD_SKULLTULA, ED_LONGSHOT) or (trick(RT_KAK_TOWER_GS) and can_jumpslash_except_hammer())) and
            can_get_night_time_gs()
    }
}

extend region RR_KAK_IMPAS_ROOFTOP {
    locations {
        RC_KAK_GS_ABOVE_IMPAS_HOUSE: is_adult() and can_get_night_time_gs() and can_kill(RE_GOLD_SKULLTULA)
    }
}

extend region RR_KAK_WATCHTOWER {
    locations {
        RC_KAK_GS_WATCHTOWER: is_child() and can_use(RG_DINS_FIRE) and can_get_night_time_gs()
    }
}

# overworld/kokiri_forest

extend region RR_KOKIRI_FOREST {
    locations {
        RC_KF_GS_KNOW_IT_ALL_HOUSE: is_child() and can_kill(RE_GOLD_SKULLTULA, ED_CLOSE)
        RC_KF_GS_BEAN_PATCH:        can_spawn_soil_skull(RG_KOKIRI_FOREST_BEAN_SOUL) and can_kill(RE_GOLD_SKULLTULA, ED_CLOSE)
        RC_KF_GS_HOUSE_OF_TWINS:    is_adult() and can_get_night_time_gs() and
                                    (can_get_drop(RE_GOLD_SKULLTULA, ED_BOOMERANG) or
                                     (trick(RT_KF_ADULT_GS) and can_use(RG_HOVER_BOOTS) and can_kill(RE_GOLD_SKULLTULA, ED_SHORT_JUMPSLASH)))
    }
}

# overworld/market

extend region RR_MARKET_GUARD_HOUSE {
    locations {
        RC_MARKET_GS_GUARD_HOUSE: is_child() and can_break_crates() and (has(RG_POWER_BRACELET) or can_kill(RE_GOLD_SKULLTULA))
    }
}
