# dungeons/dodongos_cavern

extend region RR_DODONGOS_CAVERN_LOBBY {
    locations {
        RC_DODONGOS_CAVERN_GOSSIP_STONE: any_age(can_break_mud_walls() or has(RG_GORONS_BRACELET))
    }
}

extend region RR_DODONGOS_CAVERN_MQ_GOSSIP_STONE {
    locations {
        RC_DODONGOS_CAVERN_GOSSIP_STONE: always
    }
}

# dungeons/ganons_castle

extend region RR_GANONS_TOWER_GANONDORF_LAIR {
    locations {
        RC_GANONDORF_HINT: has_boss_soul(RG_GANON_SOUL)
    }
}

extend region RR_GANONS_CASTLE_MAIN {
    locations {
        RC_SHEIK_HINT_GC: has(RG_SPEAK_HYLIAN)
    }
}

extend region RR_GANONS_CASTLE_MQ_MAIN {
    locations {
        RC_SHEIK_HINT_MQ_GC: has(RG_SPEAK_HYLIAN)
    }
}

