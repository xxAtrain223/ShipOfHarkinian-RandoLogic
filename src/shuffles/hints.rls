extend region RR_KF_OUTSIDE_DEKU_TREE {
    locations {
        RC_KF_DEKU_TREE_LEFT_GOSSIP_STONE: always
        RC_KF_DEKU_TREE_RIGHT_GOSSIP_STONE: always
    }
}

extend region RR_KF_OUTSIDE_LOST_WOODS {
    locations {
        RC_KF_GOSSIP_STONE: always
    }
}

extend region RR_KF_STORMS_GROTTO {
    locations {
        RC_KF_STORMS_GROTTO_GOSSIP_STONE: always
    }
}

extend region RR_TOT_ENTRANCE {
    locations {
        RC_TOT_LEFTMOST_GOSSIP_STONE: always
        RC_TOT_LEFT_CENTER_GOSSIP_STONE: always
        RC_TOT_RIGHT_CENTER_GOSSIP_STONE: always
        RC_TOT_RIGHTMOST_GOSSIP_STONE: always
    }
}

extend region RR_TEMPLE_OF_TIME {
    locations {
        RC_ALTAR_HINT_CHILD: is_child()
        RC_ALTAR_HINT_ADULT: is_adult()
        RC_TOT_SHEIK_HINT: is_adult() and has(RG_SPEAK_HYLIAN)
    }
}

extend region RR_MARKET_MASK_SHOP {
    locations {
        RC_MASK_SHOP_HINT: always
    }
}