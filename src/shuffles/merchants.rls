# overworld/goron_city

extend region RR_GC_MEDIGORON {
    locations {
        RC_GC_MEDIGORON: is_adult() and has(RG_SPEAK_GORON) and check_price() <= wallet_capacity()
    }
}

# overworld/haunted_wasteland

extend region RR_HAUNTED_WASTELAND {
    locations {
        RC_WASTELAND_BOMBCHU_SALESMAN: (can_jumpslash() or can_use(RG_HOVER_BOOTS)) and has(RG_SPEAK_HYLIAN) and check_price() <= wallet_capacity()
    }
}

# overworld/kakariko

extend region RR_KAK_ODD_POTION_BUILDING {
    locations {
        RC_KAK_GRANNYS_SHOP: is_adult() and has(RG_SPEAK_HYLIAN) and (can_use(RG_ODD_MUSHROOM) or
                              (setting(RSK_SHUFFLE_ADULT_TRADE) is RO_GENERIC_OFF and (has(RG_CLAIM_CHECK) or setting(RSK_EARLY_GRANNYS_SHOP))) and
                              check_price() <= wallet_capacity())
    }
}

# overworld/zoras_river

extend region RR_ZORAS_RIVER {
    locations {
        RC_ZR_MAGIC_BEAN_SALESMAN: is_child() and has(RG_SPEAK_HYLIAN) and check_price() <= wallet_capacity()
    }
}
