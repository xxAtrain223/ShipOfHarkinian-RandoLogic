# dungeons/bottom_of_the_well

extend region RR_BOTW_PERIMETER {
    locations {
        RC_BOTTOM_OF_THE_WELL_NEAR_ENTRANCE_POT_1: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_NEAR_ENTRANCE_POT_2: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_UNDERWATER_POT:      (can_break_pots() and flag(LOGIC_BOTW_LOWERED_WATER)) or can_use(RG_BOOMERANG)
    }
}

extend region RR_BOTW_HIDDEN_POTS {
    locations {
        RC_BOTTOM_OF_THE_WELL_LEFT_SIDE_POT_1: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_LEFT_SIDE_POT_2: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_LEFT_SIDE_POT_3: can_break_pots()
    }
}

extend region RR_BOTW_HIDDEN_PITS_ROOM {
    locations {
        RC_BOTTOM_OF_THE_WELL_FIRE_KEESE_POT_1: can_break_pots() and (trick(RT_LENS_BOTW) or can_use(RG_LENS_OF_TRUTH))
    }
}

extend region RR_BOTW_B3_OOZE {
    locations {
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_1:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_2:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_3:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_4:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_5:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_6:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_7:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_8:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_9:  can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_10: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_11: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_BASEMENT_POT_12: can_break_pots()
    }
}

extend region RR_BOTW_MQ_PERIMETER {
    locations {
        # Implies can_break_pots(). Hitting this with rang through the wall is possible but would be a trick.
        # Instead of blowing up the boulder, you can aim through the lower left side with sling (either age)
        # or as child with bow. Not even bow extension seems to get adult's bow to work; this would be a trick
        RC_BOTTOM_OF_THE_WELL_MQ_OUTER_LOBBY_POT: (any_age(blast_or_smash()) and can_hit_eye_targets()) or
                                            (trick(RT_VISIBLE_COLLISION) and is_child() ? can_hit_eye_targets() : can_use(RG_FAIRY_SLINGSHOT))
    }
}

extend region RR_BOTW_MQ_MIDDLE {
    locations {
        RC_BOTTOM_OF_THE_WELL_MQ_INNER_LOBBY_POT_1: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_MQ_INNER_LOBBY_POT_2: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_MQ_INNER_LOBBY_POT_3: can_break_pots()
    }
}

extend region RR_BOTW_MQ_INVISIBLE_PATH {
    locations {
        RC_BOTTOM_OF_THE_WELL_MQ_EAST_INNER_ROOM_POT_1: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_MQ_EAST_INNER_ROOM_POT_2: can_break_pots()
        RC_BOTTOM_OF_THE_WELL_MQ_EAST_INNER_ROOM_POT_3: can_break_pots()
    }
}

