        RC_ZR_UNDERWATER_ROCK_2: (can_use(RG_BOMBCHU_5) or (can_use(RG_BOMB_BAG) and trick(RT_BOMB_DETONATION)) or (is_adult() and has(RG_POWER_BRACELET))) and
                                 (is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or (trick(RT_VOIDOUT_COLLECTION) and can_void()))
        RC_ZR_UNDERWATER_ROCK_3: (can_use(RG_BOMBCHU_5) or (can_use(RG_BOMB_BAG) and trick(RT_BOMB_DETONATION)) or (is_adult() and has(RG_POWER_BRACELET))) and
                                 (is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or (trick(RT_VOIDOUT_COLLECTION) and can_void()))
        RC_ZR_UNDERWATER_ROCK_4: (can_use(RG_BOMBCHU_5) or (can_use(RG_BOMB_BAG) and trick(RT_BOMB_DETONATION)) or (is_adult() and has(RG_POWER_BRACELET))) and
                                 (is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or (trick(RT_VOIDOUT_COLLECTION) and can_void()))
    }
