# overworld/gerudo_valley

extend region RR_GERUDO_VALLEY {
    locations {
        RC_GV_ROCK_1:            can_break_rocks()
        RC_GV_ROCK_2:            can_break_rocks()
        RC_GV_ROCK_3:            can_break_rocks()
        RC_GV_UNDERWATER_ROCK_1: (can_use(RG_BOMBCHU_5) or (can_use(RG_BOMB_BAG) and trick(RT_BOMB_DETONATION)) or (is_adult() and
                                   has(RG_POWER_BRACELET))) and (is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or
                                  ((trick(RT_VOIDOUT_COLLECTION) and can_void()) and has(RG_POWER_BRACELET)))
        RC_GV_UNDERWATER_ROCK_2: (can_use(RG_BOMBCHU_5) or (can_use(RG_BOMB_BAG) and trick(RT_BOMB_DETONATION)) or (is_adult() and
                                   has(RG_POWER_BRACELET))) and (is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or
                                  ((trick(RT_VOIDOUT_COLLECTION) and can_void()) and has(RG_POWER_BRACELET)))
        RC_GV_UNDERWATER_ROCK_3: (can_use(RG_BOMBCHU_5) or (can_use(RG_BOMB_BAG) and trick(RT_BOMB_DETONATION)) or (is_adult() and
                                   has(RG_POWER_BRACELET))) and (is_adult() or has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or
                                  ((trick(RT_VOIDOUT_COLLECTION) and can_void()) and has(RG_POWER_BRACELET)))
        RC_GV_BOULDER_1:         is_adult() and blast_or_smash()
        RC_GV_BOULDER_2:         is_adult() and blast_or_smash()
        RC_GV_BRONZE_BOULDER_1:  is_adult() and can_use(RG_MEGATON_HAMMER)
        RC_GV_BRONZE_BOULDER_2:  is_adult() and can_use(RG_MEGATON_HAMMER)
    }
}

extend region RR_GV_GROTTO_LEDGE {
    locations {
        RC_GV_SILVER_BOULDER: can_use(RG_SILVER_GAUNTLETS)
    }
}

extend region RR_GV_FORTRESS_SIDE {
    locations {
        RC_GV_ROCK_ACROSS_BRIDGE_1:           is_adult()
