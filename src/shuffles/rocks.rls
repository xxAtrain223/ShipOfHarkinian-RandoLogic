# overworld/death_mountain_crater

extend region RR_DMC_ROCK_GROTTO {
    locations {
        RC_DMC_CIRCLE_ROCK_1: fire_timer() >= 8 and can_break_rocks()
        RC_DMC_CIRCLE_ROCK_2: fire_timer() >= 8 and can_break_rocks()
        RC_DMC_CIRCLE_ROCK_3: fire_timer() >= 8 and can_break_rocks()
        RC_DMC_CIRCLE_ROCK_4: fire_timer() >= 8 and can_break_rocks()
        RC_DMC_CIRCLE_ROCK_5: fire_timer() >= 8 and can_break_rocks()
        RC_DMC_CIRCLE_ROCK_6: fire_timer() >= 8 and can_break_rocks()
        RC_DMC_CIRCLE_ROCK_7: fire_timer() >= 8 and can_break_rocks()
        RC_DMC_CIRCLE_ROCK_8: fire_timer() >= 8 and can_break_rocks()
        # boulders 1 and 2 are a bit separate, but are in 8 seconds from upper entry and closer or the same
        # distance from all ways to reach upper grotto otherwise, so it works
        RC_DMC_BOULDER_1:     fire_timer() >= 8 and blast_or_smash()
        RC_DMC_BOULDER_2:     fire_timer() >= 8 and blast_or_smash()
        RC_DMC_BOULDER_3:     fire_timer() >= 8 and blast_or_smash()
    }
}

extend region RR_DMC_CRACKED_WALL {
    locations {
        RC_DMC_GOSSIP_ROCK_1: is_child()
        RC_DMC_GOSSIP_ROCK_2: is_child()
    }
}

extend region RR_DMC_POTS {
    locations {
        RC_DMC_BRONZE_BOULDER_1:        can_use(RG_MEGATON_HAMMER)
