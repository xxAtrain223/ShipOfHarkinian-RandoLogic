        RC_DODONGOS_CAVERN_MQ_DEKU_SCRUB_LOBBY_REAR:  can_stun_deku() and has(RG_SPEAK_DEKU) and check_price() <= wallet_capacity()
        RC_DODONGOS_CAVERN_MQ_DEKU_SCRUB_LOBBY_FRONT: can_stun_deku() and has(RG_SPEAK_DEKU) and check_price() <= wallet_capacity()
