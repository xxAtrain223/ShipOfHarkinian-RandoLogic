        RC_DODONGOS_CAVERN_MQ_DEKU_SCRUB_SIDE_ROOM_NEAR_LOWER_LIZALFOS: can_stun_deku() and has(RG_SPEAK_DEKU) and check_price() <= wallet_capacity()
