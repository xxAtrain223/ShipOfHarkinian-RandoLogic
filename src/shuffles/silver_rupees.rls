        RC_SPIRIT_E_LOW_CHILD_SILVER: always
        RC_SPIRIT_TORCH_CHILD_SILVER: always
        RC_SPIRIT_W_HIGH_CHILD_SILVER: has(RG_CLIMB) or can_use(RG_HOOKSHOT)
        RC_SPIRIT_W_LOW_CHILD_SILVER: always
    }
}

