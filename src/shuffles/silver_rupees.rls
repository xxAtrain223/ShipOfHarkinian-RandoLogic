# dungeons/dodongos_cavern

extend region RR_DODONGOS_CAVERN_MQ_STAIRS_LOWER {
    locations {
        RC_DODONGOS_CAVERN_MQ_BEAMOS_SILVER:   always
        RC_DODONGOS_CAVERN_MQ_1F_CRATE_SILVER: can_break_crates() or has(RG_GORONS_BRACELET) or (trick(RT_VISIBLE_COLLISION) and is_child())
    }
}

extend region RR_DODONGOS_CAVERN_MQ_STAIRS_UPPER {
    locations {
        RC_DODONGOS_CAVERN_MQ_LOWER_2F_CRATE_SILVER: can_break_crates() or (trick(RT_VISIBLE_COLLISION) and (is_child() or can_use(RG_HOOKSHOT)))
        # possible with the hookshot method and longshot, but precise and would be its own trick
        RC_DODONGOS_CAVERN_MQ_UPPER_2F_CRATE_SILVER: can_break_crates() or (trick(RT_VISIBLE_COLLISION) and is_child())
    }
}

extend region RR_DODONGOS_CAVERN_MQ_STAIRS_PAST_BIG_SKULLTULAS {
    locations {
        RC_DODONGOS_CAVERN_MQ_VINES_SILVER: has(RG_CLIMB)
    }
}
extend region RR_BOTW_B3_OOZE {
    locations {
        RC_BOTW_B2_LADDER_SILVER: can_climb_ladder()
        RC_BOTW_B3_LADDER_SILVER: always
        RC_BOTW_NW_OOZE_SILVER: always
        RC_BOTW_SE_OOZE_SILVER: always
    }
}

extend region RR_BOTW_LADDER_DOOR {
    locations {
        RC_BOTW_B1_LADDER_SILVER: always
        RC_BOTW_B2_LADDER_SILVER: always
    }
}

extend region RR_GANONS_CASTLE_FIRE_TRIAL_FROM_BARRED {
    locations {
        RC_GANONS_CASTLE_CLOSE_PLATFORM_FIRE_SILVER: (can_use(RG_LONGSHOT) or can_melee_recoil_hover(RECOIL_HAMMER) or (is_adult() and can_megajump(true)) or can_bunny_mega_jumpslash()) and fire_timer() >= 16
        RC_GANONS_CASTLE_DISTANT_PLATFORM_FIRE_SILVER: (can_use(RG_LONGSHOT) or can_melee_recoil_hover(RECOIL_HAMMER) or (is_adult() and can_megajump(true)) or can_bunny_mega_jumpslash()) and fire_timer() >= 32 and (can_use(RG_GOLDEN_GAUNTLETS) or bunny_hovers() or can_megajump() or can_bomb_recoil_hover())
        RC_GANONS_CASTLE_FLAME_JETS_FIRE_SILVER: (can_use(RG_LONGSHOT) or can_melee_recoil_hover(RECOIL_HAMMER) or (is_adult() and can_megajump(true)) or can_bunny_mega_jumpslash()) and fire_timer() >= 16
        RC_GANONS_CASTLE_TORCH_SLUG_FIRE_SILVER: (can_use(RG_LONGSHOT) or can_melee_recoil_hover(RECOIL_HAMMER) or (is_adult() and can_megajump(true)) or can_bunny_mega_jumpslash()) and fire_timer() >= 8
        RC_GANONS_GANONS_CASTLE_UNDER_PILLAR_FIRE_SILVER: (can_use(RG_LONGSHOT) or can_melee_recoil_hover(RECOIL_HAMMER) or (is_adult() and can_megajump(true)) or can_bunny_mega_jumpslash()) and fire_timer() >= 24 and can_use(RG_GOLDEN_GAUNTLETS)
    }
}

extend region RR_GANONS_CASTLE_FIRE_TRIAL_FROM_OPEN {
    locations {
        RC_GANONS_CASTLE_CLOSE_PLATFORM_FIRE_SILVER: fire_timer() >= 8
        RC_GANONS_CASTLE_DISTANT_PLATFORM_FIRE_SILVER: fire_timer() >= 32 and (can_use(RG_GOLDEN_GAUNTLETS) or bunny_hovers() or can_megajump() or can_bomb_recoil_hover())
        RC_GANONS_CASTLE_FLAME_JETS_FIRE_SILVER: fire_timer() >= 16
        RC_GANONS_CASTLE_TORCH_SLUG_FIRE_SILVER: fire_timer() >= 16
        RC_GANONS_GANONS_CASTLE_UNDER_PILLAR_FIRE_SILVER: fire_timer() >= 24 and can_use(RG_GOLDEN_GAUNTLETS)
    }
}

extend region RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM {
    locations {
        RC_GANONS_CASTLE_ON_TARGET_FOREST_SILVER: (trick(RT_VOIDOUT_COLLECTION) and can_void()) or (can_midair_ground_jump())
        RC_GANONS_CASTLE_SOT_BLOCK_FOREST_SILVER: always
    }
}

extend region RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_FINAL_DOOR {
    locations {
        RC_GANONS_CASTLE_SMALL_PLATFORM_FOREST_SILVER: always
    }
}

extend region RR_GANONS_CASTLE_FOREST_TRIAL_BEAMOS_ROOM_MIDDLE {
    locations {
        RC_GANONS_CASTLE_LARGE_PLATFORM_FOREST_SILVER: always
        RC_GANONS_CASTLE_ON_TARGET_FOREST_SILVER: is_adult() or can_use(RG_HOOKSHOT)
        RC_GANONS_CASTLE_UNDER_LEDGE_FOREST_SILVER: always
    }
}

extend region RR_GANONS_CASTLE_LIGHT_TRIAL_BOULDER_ROOM {
    locations {
        RC_GANONS_CASTLE_INNER_LEFT_LIGHT_SILVER: always
        RC_GANONS_CASTLE_INNER_RIGHT_LIGHT_SILVER: always
        RC_GANONS_CASTLE_OUTER_LEFT_LIGHT_SILVER: always
        RC_GANONS_CASTLE_OUTER_RIGHT_LIGHT_SILVER: always
        RC_GANONS_CASTLE_UPPER_LIGHT_SILVER: can_use(RG_HOOKSHOT) or (is_adult() and can_ground_jump())
    }
}

extend region RR_GANONS_CASTLE_MQ_FIRE_TRIAL_FROM_BARRED {
    locations {
        RC_GANONS_CASTLE_MQ_JET_PLATFORM_FIRE_SILVER: (can_recoil_hover(RECOIL_HAMMER) or can_megajump(true)) and fire_timer() >= 24
        RC_GANONS_CASTLE_MQ_LAUNCH_PLATFORM_FIRE_SILVER: (can_recoil_hover(RECOIL_HAMMER) or can_megajump(true)) and fire_timer() >= 16
        RC_GANONS_CASTLE_MQ_NEAR_TARGET_FIRE_SILVER: (can_recoil_hover(RECOIL_HAMMER) or can_megajump(true)) and fire_timer() >= 24
        RC_GANONS_CASTLE_MQ_ON_PILLAR_FIRE_SILVER: (can_recoil_hover(RECOIL_HAMMER) or can_megajump(true)) and ((fire_timer() >= 32 and can_use(RG_GOLDEN_GAUNTLETS)) or (fire_timer() >= 8 and trick(RT_VOIDOUT_COLLECTION)))
        RC_GANONS_CASTLE_MQ_UNDER_PILLAR_FIRE_SILVER: (can_recoil_hover(RECOIL_HAMMER) or can_megajump(true)) and fire_timer() >= 24 and can_use(RG_GOLDEN_GAUNTLETS)
    }
}

extend region RR_GANONS_CASTLE_MQ_FIRE_TRIAL_FROM_OPEN {
    locations {
        RC_GANONS_CASTLE_MQ_JET_PLATFORM_FIRE_SILVER: fire_timer() >= 40
        RC_GANONS_CASTLE_MQ_LAUNCH_PLATFORM_FIRE_SILVER: fire_timer() >= 16
        RC_GANONS_CASTLE_MQ_NEAR_TARGET_FIRE_SILVER: fire_timer() >= 32
        RC_GANONS_CASTLE_MQ_ON_PILLAR_FIRE_SILVER: (fire_timer() >= 48 and can_use(RG_GOLDEN_GAUNTLETS)) or (fire_timer() >= 32 and trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_GANONS_CASTLE_MQ_UNDER_PILLAR_FIRE_SILVER: fire_timer() >= 24 and can_use(RG_GOLDEN_GAUNTLETS)
    }
}

extend region RR_GANONS_CASTLE_MQ_SHADOW_TRIAL_BARRED_DOOR {
    locations {
        RC_GANONS_CASTLE_MQ_GUILLOTINE_SHADOW_SILVER: (trick(RT_LENS_GANON_MQ) or can_use(RG_LENS_OF_TRUTH)) or (trick(RT_VOIDOUT_COLLECTION) and can_void() and (can_use(RG_HOVER_BOOTS) or can_megajump())) or (trick(RT_ITEM_EXTENSION) and flag(LOGIC_SHADOW_TRIAL_LATE_CHEST) and can_use(RG_LONGSHOT))
    }
}

extend region RR_GANONS_CASTLE_MQ_SHADOW_TRIAL_BEAMOS_TORCH {
    locations {
        RC_GANONS_CASTLE_MQ_NEAR_TORCH_SHADOW_SILVER: always
    }
}

