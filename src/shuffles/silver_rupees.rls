}

extend region RR_SPIRIT_TEMPLE_MQ_BIG_WALL_BASE {
    locations {
        RC_SPIRIT_MQ_HIGHEST_WALL_SILVER: can_use(RG_LONGSHOT) or (has(RG_CLIMB) and (can_kill(RE_KEESE) or can_use(RG_SKULL_MASK)))
        RC_SPIRIT_MQ_LOWEST_WALL_SILVER: can_use(RG_HOOKSHOT) or has(RG_CLIMB)
        RC_SPIRIT_MQ_MIDDLE_WALL_SILVER: can_use(RG_LONGSHOT) or (has(RG_CLIMB) and (can_kill(RE_KEESE) or can_use(RG_SKULL_MASK)))
        RC_SPIRIT_MQ_MID_HIGH_WALL_SILVER: can_use(RG_HOOKSHOT) or has(RG_CLIMB)
        RC_SPIRIT_MQ_MID_LOW_WALL_SILVER: can_use(RG_HOOKSHOT) or has(RG_CLIMB)
    }
}

extend region RR_SPIRIT_TEMPLE_MQ_BIG_WALL_UPPER {
    locations {
        RC_SPIRIT_MQ_HIGHEST_WALL_SILVER: always
        RC_SPIRIT_MQ_LOWEST_WALL_SILVER: always
        RC_SPIRIT_MQ_MIDDLE_WALL_SILVER: always
        RC_SPIRIT_MQ_MID_HIGH_WALL_SILVER: always
        RC_SPIRIT_MQ_MID_LOW_WALL_SILVER: always
    }
