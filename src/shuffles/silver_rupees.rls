        RC_GTG_TARGET_SLOPE_SILVER: (is_adult() and can_use(RG_HOOKSHOT)) or (is_child() and can_use(RG_LONGSHOT)) or trick(RT_GTG_WITHOUT_HOOKSHOT)
        RC_GTG_UPPER_BOULDER_SLOPE_SILVER: always
    }
}

