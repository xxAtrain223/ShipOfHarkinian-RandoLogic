    locations {
        RC_SHADOW_MQ_E_TARGET_SPIKES_SILVER: can_use(RG_LONGSHOT)
        RC_SHADOW_MQ_W_TARGET_SPIKES_SILVER: can_use(RG_HOOKSHOT)
