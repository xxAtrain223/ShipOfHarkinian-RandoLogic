extend region RR_GERUDO_TRAINING_GROUND_MQ_UNDERWATER {
    locations {
        RC_GTG_MQ_BACK_WATER_SILVER: has_fire_source() and has(RG_BRONZE_SCALE) and can_use(RG_IRON_BOOTS) and water_timer() >= 24 and take_damage()
        RC_GTG_MQ_FRONT_WATER_SILVER: has_fire_source() and has(RG_BRONZE_SCALE) and can_use(RG_IRON_BOOTS) and water_timer() >= 24 and take_damage()
        RC_GTG_MQ_MIDDLE_WATER_SILVER: has_fire_source() and has(RG_BRONZE_SCALE) and can_use(RG_IRON_BOOTS) and water_timer() >= 24 and take_damage()
    }
}

extend region RR_GERUDO_TRAINING_GROUND_UNDERWATER {
    locations {
        RC_GTG_ABOVE_TARGET_WATER_SILVER: can_use(RG_SONG_OF_TIME) and ((can_use(RG_IRON_BOOTS) and water_timer() >= 16) or has(RG_GOLDEN_SCALE))
        RC_GTG_LEFT_WATER_SILVER: can_use(RG_SONG_OF_TIME) and can_use(RG_IRON_BOOTS) and water_timer() >= 16
        RC_GTG_MIDDLE_WATER_SILVER: can_use(RG_SONG_OF_TIME) and can_use(RG_IRON_BOOTS) and water_timer() >= 16
        RC_GTG_RIGHT_WATER_SILVER: can_use(RG_SONG_OF_TIME) and can_use(RG_IRON_BOOTS) and water_timer() >= 16
        RC_GTG_UNDER_TARGET_WATER_SILVER: can_use(RG_SONG_OF_TIME) and can_use(RG_IRON_BOOTS) and (has(RG_BRONZE_SCALE) or can_use(RG_HOOKSHOT)) and water_timer() >= 16
    }
}

extend region RR_ICE_CAVERN_BLOCK_ROOM {
    locations {
        RC_ICE_CAVERN_LOWER_BLOCK_SILVER: always
        RC_ICE_CAVERN_NEAR_BLOCK_SILVER: is_adult() or has(RG_POWER_BRACELET) or can_use(RG_HOVER_BOOTS) or bunny_hood()
        RC_ICE_CAVERN_NEAR_GS_BLOCK_SILVER: is_adult() or has(RG_POWER_BRACELET) or can_use(RG_HOVER_BOOTS) or bunny_hood()
