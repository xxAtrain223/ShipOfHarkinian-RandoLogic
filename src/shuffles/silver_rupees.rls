extend region RR_SHADOW_TEMPLE_LOWER_HUGE_PIT {
    locations {
        RC_SHADOW_BEAMOS_PIT_SILVER: always
        RC_SHADOW_E_PIT_SILVER: always
        RC_SHADOW_N_PIT_SILVER: always
        RC_SHADOW_S_PIT_SILVER: always
        RC_SHADOW_W_PIT_SILVER: always
    }
}

extend region RR_SHADOW_TEMPLE_MQ_B2_SPINNING_BLADE_ROOM {
    locations {
        RC_SHADOW_MQ_NE_UNDER_BLADE_SILVER: always
        RC_SHADOW_MQ_N_NOOK_BLADE_SILVER: can_pass(RE_BIG_SKULLTULA)
        RC_SHADOW_MQ_S_UNDER_BLADE_SILVER: always
        RC_SHADOW_MQ_TALL_BLOCK_BLADE_SILVER: can_use(RG_HOOKSHOT) or (can_megajump() and effective_health() > 12) or (is_adult() and (can_use(RG_HOVER_BOOTS) or can_ground_jump() or bunny_hood()))
        RC_SHADOW_MQ_W_NOOK_SILVER: can_pass(RE_BIG_SKULLTULA)
    }
}

extend region RR_SHADOW_TEMPLE_MQ_FLOOR_SPIKES_ROOM {
    locations {
        RC_SHADOW_MQ_CENTRAL_SPIKES_SILVER: always
        RC_SHADOW_MQ_CENTRAL_TARGET_SPIKES_SILVER: (is_adult() and can_use(RG_HOOKSHOT)) or (is_child() and can_use(RG_LONGSHOT))
        RC_SHADOW_MQ_E_TARGET_SPIKES_SILVER: can_use(RG_HOOKSHOT)
        RC_SHADOW_MQ_INSIDE_SPIKES_SILVER: can_use(RG_HOVER_BOOTS) or can_use(RG_GORON_TUNIC) or take_damage()
        RC_SHADOW_MQ_N_TARGET_SPIKES_SILVER: (trick(RT_LENS_SHADOW_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_LONGSHOT)
        RC_SHADOW_MQ_S_TARGET_SPIKES_SILVER: (is_adult() and can_use(RG_HOOKSHOT)) or (is_child() and can_use(RG_LONGSHOT))
    }
}

