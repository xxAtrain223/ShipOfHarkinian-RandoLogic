        RC_GTG_MQ_HIGH_SLOPE_SILVER: can_use(RG_LONGSHOT) or trick(RT_GTG_MQ_WITHOUT_HOOKSHOT) or (trick(RT_GTG_MQ_WITH_HOOKSHOT) and is_adult() and can_jumpslash() and can_use(RG_HOOKSHOT))
        RC_GTG_MQ_ICICLES_SLOPE_SILVER: always
        RC_GTG_MQ_JUMPDOWN_SLOPE_SILVER: always
