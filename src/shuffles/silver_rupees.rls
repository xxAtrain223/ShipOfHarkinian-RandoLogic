extend region RR_SPIRIT_TEMPLE_MQ_FOYER {
    locations {
        RC_SPIRIT_MQ_E_BOULDER_LOBBY_SILVER: blast_or_smash()
        RC_SPIRIT_MQ_W_BOULDER_LOBBY_SILVER: blast_or_smash()
