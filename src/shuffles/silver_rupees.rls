    locations {
        RC_SHADOW_MQ_CENTRAL_TARGET_SPIKES_SILVER: can_use(RG_LONGSHOT)
        RC_SHADOW_MQ_N_TARGET_SPIKES_SILVER: (trick(RT_LENS_SHADOW_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_LONGSHOT)
        RC_SHADOW_MQ_S_TARGET_SPIKES_SILVER: can_use(RG_LONGSHOT)
        RC_SHADOW_MQ_W_TARGET_SPIKES_SILVER: can_use(RG_HOOKSHOT)
    }
}

extend region RR_SHADOW_TEMPLE_MQ_INVISIBLE_BLADES_ROOM {
    locations {
        RC_SHADOW_MQ_E_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_INNER_NE_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_NW_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_OUTER_NE_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_OUTSIDE_CIRCLE_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_SE_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_SOT_BLOCK_INVISIBLE_BLADE_SILVER: can_use(RG_SONG_OF_TIME) or (trick(RT_SHADOW_MQ_INVISIBLE_BLADES) and effective_health() > 8)
        RC_SHADOW_MQ_SW_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_S_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
        RC_SHADOW_MQ_W_INVISIBLE_BLADE_SILVER: trick(RT_LENS_SHADOW_MQ_INVISIBLE_BLADES) or is_child() or can_use(RG_NAYRUS_LOVE) or can_use(RG_LENS_OF_TRUTH)
    }
}

extend region RR_SHADOW_TEMPLE_MQ_LOWER_HUGE_PIT {
