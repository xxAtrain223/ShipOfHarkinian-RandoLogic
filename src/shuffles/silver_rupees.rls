extend region RR_SHADOW_TEMPLE_MQ_SPIKES_CORNER_PLATFORM {
    locations {
        RC_SHADOW_MQ_PLATFORM_SPIKES_SILVER: always
        RC_SHADOW_MQ_W_AIRBORNE_SPIKES_SILVER: always
        RC_SHADOW_MQ_W_TARGET_SPIKES_SILVER: (bunny_hovers() and can_jumpslash()) or can_use(RG_HOOKSHOT) or can_recoil_hover(RECOIL_SWORD_AND_SHIELD) or can_megajump(not can_jumpslash())
    }
}

extend region RR_SHADOW_TEMPLE_MQ_SPIKES_DOOR_PLATFORM {
    locations {
        RC_SHADOW_MQ_CENTRAL_TARGET_SPIKES_SILVER: can_use(RG_HOOKSHOT)
        RC_SHADOW_MQ_E_AIRBORNE_SPIKES_SILVER: can_use(RG_HOVER_BOOTS) or can_jumpslash() or bunny_hood()
        RC_SHADOW_MQ_E_TARGET_SPIKES_SILVER: (bunny_hovers() and can_jumpslash()) or can_use(RG_LONGSHOT) or can_recoil_hover(RECOIL_HAMMER) or can_megajump(not can_jumpslash())
        RC_SHADOW_MQ_W_AIRBORNE_SPIKES_SILVER: always
        RC_SHADOW_MQ_W_TARGET_SPIKES_SILVER: can_use(RG_LONGSHOT) or ((can_megajump() or can_bomb_recoil_hover()) and can_jumpslash()) or can_melee_recoil_hover(RECOIL_HAMMER)
    }
}

extend region RR_SHADOW_TEMPLE_MQ_SPIKES_GLASS_PLATFORMS {
    locations {
        RC_SHADOW_MQ_CENTRAL_TARGET_SPIKES_SILVER: can_use(RG_HOOKSHOT)
        RC_SHADOW_MQ_E_AIRBORNE_SPIKES_SILVER: (trick(RT_LENS_SHADOW_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_HOOKSHOT)
        RC_SHADOW_MQ_N_TARGET_SPIKES_SILVER: (trick(RT_LENS_SHADOW_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_HOOKSHOT)
        RC_SHADOW_MQ_S_TARGET_SPIKES_SILVER: can_use(RG_HOOKSHOT)
        RC_SHADOW_MQ_W_AIRBORNE_SPIKES_SILVER: (trick(RT_LENS_SHADOW_MQ) or can_use(RG_LENS_OF_TRUTH)) and can_use(RG_HOOKSHOT)
        RC_SHADOW_MQ_W_TARGET_SPIKES_SILVER: can_use(RG_HOOKSHOT)
    }
}

extend region RR_SHADOW_TEMPLE_SPIKES_CORNER_PLATFORM {
    locations {
        RC_SHADOW_AIRBORNE_SPIKES_SILVER: trick(RT_LENS_SHADOW) or can_use(RG_LENS_OF_TRUTH) or can_use(RG_HOVER_BOOTS) or can_use(RG_GORON_TUNIC) or take_damage()
        RC_SHADOW_PLATFORM_SPIKES_SILVER: always
        RC_SHADOW_W_TARGET_SPIKES_SILVER: (bunny_hovers() and can_jumpslash()) or can_use(RG_HOOKSHOT) or can_recoil_hover(RECOIL_SWORD_AND_SHIELD) or can_megajump(not can_jumpslash())
    }
}

extend region RR_SHADOW_TEMPLE_SPIKES_DOOR_PLATFORM {
    locations {
        RC_SHADOW_AIRBORNE_SPIKES_SILVER: always
        RC_SHADOW_E_TARGET_SPIKES_SILVER: (bunny_hovers() and can_jumpslash()) or can_use(RG_LONGSHOT) or can_recoil_hover(RECOIL_HAMMER) or can_megajump(not can_jumpslash())
        RC_SHADOW_W_TARGET_SPIKES_SILVER: can_use(RG_LONGSHOT) or ((can_megajump() or can_bomb_recoil_hover()) and can_jumpslash()) or can_melee_recoil_hover(RECOIL_HAMMER)
    }
}

extend region RR_SHADOW_TEMPLE_SPINNING_BLADES {
    locations {
        RC_SHADOW_N_NOOK_BLADE_SILVER: always
        RC_SHADOW_N_UNDER_BLADE_SILVER: always
        RC_SHADOW_S_UNDER_BLADE_SILVER: always
        RC_SHADOW_TALL_BLOCK_BLADE_SILVER: (is_adult() and (can_use(RG_HOVER_BOOTS) or can_ground_jump() or bunny_hood())) or can_use(RG_HOOKSHOT) or (can_megajump() and effective_health() > 12)
        RC_SHADOW_W_NOOK_BLADE_SILVER: always
    }
}

extend region RR_SPIRIT_TEMPLE_ABOVE_BOULDERS {
    locations {
        RC_SPIRIT_AIRBORNE_BOULDER_SILVER: can_use(RG_HOVER_BOOTS) or can_jumpslash() or can_use(RG_LONGSHOT) or bunny_hood()
    }
}

extend region RR_SPIRIT_TEMPLE_BOULDERS {
    locations {
        RC_SPIRIT_NE_BOULDER_SILVER: always
        RC_SPIRIT_NW_BOULDER_SILVER: always
        RC_SPIRIT_SE_BOULDER_SILVER: always
        RC_SPIRIT_SW_BOULDER_SILVER: always
    }
