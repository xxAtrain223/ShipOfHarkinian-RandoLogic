extend region RR_GANONS_CASTLE_MQ_WATER_TRIAL_BLOCK_ROOM {
    locations {
        RC_GANONS_CASTLE_MQ_AIRBORNE_WATER_SILVER: is_adult() or has(RG_POWER_BRACELET) or (trick(RT_UNINTUITIVE_JUMPS)) or (can_use(RG_HOVER_BOOTS)) or can_megajump()
        RC_GANONS_CASTLE_MQ_IN_HOLE_WATER_SILVER: always
        RC_GANONS_CASTLE_MQ_NOOK_WATER_SILVER: always
        RC_GANONS_CASTLE_MQ_OVER_PIT_WATER_SILVER: always
    }
}

extend region RR_GANONS_CASTLE_MQ_WATER_TRIAL_BLOCK_ROOM_HIGH {
    locations {
        RC_GANONS_CASTLE_MQ_FROZEN_WATER_SILVER: (blue_fire() or (trick(RT_VISIBLE_COLLISION) and can_jumpslash()))
        RC_GANONS_CASTLE_MQ_WATER_TRIAL_SILVER_RUPEE_RED_ICE: blue_fire()
    }
}

extend region RR_GANONS_CASTLE_SPIRIT_TRIAL_BEAMOS_ROOM {
    locations {
        RC_GANONS_CASTLE_AIRBORNE_SPIRIT_SILVER: (trick(RT_GANON_SPIRIT_TRIAL_HOOKSHOT) and can_jumpslash() and has(RG_POWER_BRACELET)) or can_use(RG_HOOKSHOT)
        RC_GANONS_CASTLE_CORNER_SPIRIT_SILVER: always
        RC_GANONS_CASTLE_LOWER_MIDDLE_SPIRIT_SILVER: always
