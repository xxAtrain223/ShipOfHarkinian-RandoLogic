# overworld/castle_grounds

extend region RR_HC_MOAT {
    locations {
        RC_HC_WONDER_LEFT_TORCH:  can_use(RG_FAIRY_SLINGSHOT) and (has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or
                                   (trick(RT_VOIDOUT_COLLECTION) and can_void()))
        RC_HC_WONDER_RIGHT_TORCH: can_use(RG_FAIRY_SLINGSHOT) and (has(RG_BRONZE_SCALE) or can_use(RG_BOOMERANG) or
                                   (trick(RT_VOIDOUT_COLLECTION) and can_void()))
