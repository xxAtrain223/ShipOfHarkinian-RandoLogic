        RC_HC_WONDER_MOAT_2:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_3:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_4:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_5:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_6:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_7:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_8:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_9:      has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
        RC_HC_WONDER_MOAT_10:     has(RG_BRONZE_SCALE) or can_use(RG_IRON_BOOTS) or (trick(RT_VOIDOUT_COLLECTION) and can_void())
