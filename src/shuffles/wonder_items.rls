# overworld/death_mountain_crater

extend region RR_DMC_CENTRAL {
    locations {
        # RANDOTODO: a number of tricks reach this: sidehop jumpslash or hookshot + jumpslash from the
        # bridge platform, chu + shield damage boost. Also does hover need roll/bunny
        RC_DMC_WONDER_BENEATH_BRIDGE_PLATFORM: is_adult() and (can_use(RG_LONGSHOT) or can_use(RG_HOVER_BOOTS) or can_megajump())
    }
}

